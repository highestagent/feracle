//! `Libp2pConfig` and `p2p::Transport` implementation backed by `p2p-shim`.

use core::num::IntDowncast
use core::ops::Drop
use std::net::{IpAddr, Ipv4Addr, Net, SocketAddr}
use std::time::Clock
use p2p::{Delivery, P2pEngine, PeerEntry, Stats, Transport, count_csv_peers, format_peer_tag}
use super::ffi

pub struct Libp2pConfig { pub listen_port: u16, pub self_tag: u64, pub bootstrap: MemBuffer }

pub struct Libp2pTransport {
    local_addr: SocketAddr,
    self_tag: u64,
    active: bool,
    stats: Stats,
    rx_seq: u64,
}

impl Libp2pTransport {
    pub fn bind(_ config: own Libp2pConfig) -> Result<i32, Self> {
        let rc = ffi::start(
            listen_port: config.listen_port,
            bootstrap: config.bootstrap.span(),
        )
        if rc != 0 {
            return Result::Err(rc)
        }
        let local_addr = SocketAddr::new(IpAddr::V4(Ipv4Addr::UNSPECIFIED), config.listen_port)
        Result::Ok(
            Libp2pTransport {
                local_addr,
                self_tag: config.self_tag,
                active: true,
                stats: Stats::zero(),
                rx_seq: 0,
            },
        )
    }

    pub fn local_peer_id(self) -> MemBuffer {
        ffi::local_peer_id()
    }

    pub fn peers_snapshot(self) -> (u64, MemBuffer) {
        ffi::peers_csv()
    }

    pub fn stop(mut self) {
        self.do_stop()
    }

    fn do_publish(mut self, _ payload: MemSpan) -> bool {
        if ffi::publish(payload) == 0 {
            self.stats.frames_tx += 1
            self.stats.data_tx += 1
            true
        } else {
            false
        }
    }

    fn do_recv_with_peer(mut self, _ out: mut MemBuffer, _ peer_out: mut MemBuffer) -> Option<
        Delivery,
    > {
        let (rc, origin) = ffi::poll_with_peer(mut out, mut peer_out)
        if rc > 0 {
            self.rx_seq += 1
            self.stats.frames_rx += 1
            self.stats.data_rx += 1
            Option::Some(
                Delivery { origin, seq: self.rx_seq, from: self.local_addr },
            )
        } else {
            Option::None
        }
    }

    fn do_peer_count(self) -> usize {
        let count = ffi::peer_count()
        if count > 0 {
            count.downcast_unchecked()
        } else {
            0
        }
    }

    fn do_stop(mut self) {
        if self.active {
            self.active = false
            let _ = ffi::stop()
        }
    }
}

impl Drop for Libp2pTransport {
    fn drop(own self) {
        if self.active {
            let _ = ffi::stop()
        }
    }
}

impl Libp2pTransport {
    pub fn recv_with_peer(mut self, _ out: mut MemBuffer, _ peer_out: mut MemBuffer) -> Option<
        Delivery,
    > {
        self.do_recv_with_peer(mut out, mut peer_out)
    }
}

impl P2pEngine for Libp2pTransport {
    uses E = ()

    fn publish(mut self, _ payload: MemSpan) -> bool uses E {
        self.do_publish(payload)
    }

    fn poll_io(mut self) -> usize uses E {
        0
    }

    fn recv_with_peer(mut self, _ out: mut MemBuffer, _ peer_out: mut MemBuffer) -> Option<
        Delivery,
    > {
        self.do_recv_with_peer(mut out, mut peer_out)
    }

    fn peer_count(self) -> usize {
        self.do_peer_count()
    }

    fn snapshot_peers(
        self,
        prefix: MemSpan,
        last_ver: u64,
        synced: bool,
        _ csv_out: mut MemBuffer,
    ) -> Option<(u64, usize)> {
        let _ = prefix
        let (ver, csv) = ffi::peers_csv()
        if synced && ver == last_ver {
            return Option::None
        }
        csv_out.clear()
        csv_out.extend_from(csv.span())
        Option::Some((ver, count_csv_peers(csv_out.span())))
    }

    fn write_local_peer_id(self, prefix: MemSpan, _ out: mut MemBuffer) {
        let id = ffi::local_peer_id()
        out.clear()
        if !id.is_empty() {
            out.extend_from(id.span())
        } else {
            format_peer_tag(self.self_tag, prefix, mut out)
        }
    }

    fn needs_periodic_poll(self) -> bool {
        true
    }

    fn stop(mut self) uses E {
        self.do_stop()
    }
}

impl Transport for Libp2pTransport {
    fn local_addr(self) -> SocketAddr {
        self.local_addr
    }

    fn self_tag(self) -> u64 {
        self.self_tag
    }

    fn publish(mut self, _ payload: MemSpan) -> bool
    uses (net: mut Net, clock: Clock)
    {
        self.do_publish(payload)
    }

    fn poll(mut self, timeout_ms: u64) -> usize uses (net: mut Net, clock: Clock) {
        if timeout_ms > 0 {
            ffi::sleep_ms(timeout_ms.downcast_saturate())
        }
        0
    }

    fn recv(mut self, _ out: mut MemBuffer) -> Option<Delivery> {
        var peer_tmp = MemBuffer::empty()
        self.do_recv_with_peer(mut out, mut peer_tmp)
    }

    fn peer_count(self) -> usize {
        self.do_peer_count()
    }

    fn peer_entries(self) -> MemVec<PeerEntry> {
        MemVec::new()
    }

    fn stats(self) -> Stats {
        self.stats
    }

    fn add_seed(mut self, _ addr: SocketAddr) {
        let _ = addr
    }
}
