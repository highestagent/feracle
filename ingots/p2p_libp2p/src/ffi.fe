//! C-ABI FFI bindings to the Rust `libp2p` GossipSub shim (`p2p-shim`).

use core::num::IntDowncast

extern {
    fn p2p_start(
        _ listen_port: u32,
        _ bootstrap_ptr: *u8,
        _ bootstrap_len: usize,
        _ out_handle8_ptr: *u8,
    ) -> i32
    fn p2p_wake_fd(_ handle: u64) -> i32
    fn p2p_drain_wake(_ handle: u64) -> i32
    fn p2p_publish(_ handle: u64, _ data_ptr: *u8, _ data_len: usize) -> i32
    fn p2p_poll(_ handle: u64, _ out_ptr: *u8, _ out_cap: usize) -> i32
    fn p2p_poll_with_peer(
        _ handle: u64,
        _ out_ptr: *u8,
        _ out_cap: usize,
        _ out_meta16_ptr: *u8,
        _ out_peer_ptr: *u8,
        _ out_peer_cap: usize,
    ) -> i32
    fn p2p_local_peer_id(_ handle: u64, _ out_ptr: *u8, _ out_cap: usize) -> i32
    fn p2p_peers_csv(_ handle: u64, _ out_ver8_ptr: *u8, _ out_ptr: *u8, _ out_cap: usize) -> i32
    fn p2p_peer_count(_ handle: u64) -> i32
    fn p2p_stop(_ handle: u64) -> i32
    fn p2p_sleep_ms(_ ms: u32)
}

pub(ingot) fn start(listen_port: u16, bootstrap: MemSpan) -> (i32, u64) {
    var handle_buf = MemBuffer::new(8)
    let rc = unsafe {
        p2p_start(
            listen_port as u32,
            bootstrap.ptr(),
            bootstrap.len(),
            handle_buf.ptr(),
        )
    }
    if rc == 0 {
        let handle = handle_buf.span().read_be<u64>(0)
        return (0, handle)
    }
    (rc, 0)
}

pub(ingot) fn wake_fd(_ handle: u64) -> i32 {
    unsafe {
        p2p_wake_fd(handle)
    }
}

pub(ingot) fn drain_wake(_ handle: u64) -> i32 {
    unsafe {
        p2p_drain_wake(handle)
    }
}

pub(ingot) fn local_peer_id(_ handle: u64) -> MemBuffer {
    var out = MemBuffer::new(128)
    let rc = unsafe {
        p2p_local_peer_id(handle, out.ptr(), out.capacity())
    }
    if rc > 0 {
        let len: usize = rc.downcast_unchecked()
        let bounded = if len <= out.capacity() {
            len
        } else {
            out.capacity()
        }
        unsafe {
            out.set_len(bounded)
        }
    } else {
        out.clear()
    }
    out
}

pub(ingot) fn peers_csv(_ handle: u64) -> (u64, MemBuffer) {
    var ver_buf = MemBuffer::new(8)
    var out = MemBuffer::new(8192)
    let rc = unsafe {
        p2p_peers_csv(handle, ver_buf.ptr(), out.ptr(), out.capacity())
    }
    if rc >= 0 {
        let ver = ver_buf.span().read_be<u64>(0)
        let len: usize = rc.downcast_unchecked()
        let bounded = if len <= out.capacity() {
            len
        } else {
            out.capacity()
        }
        unsafe {
            out.set_len(bounded)
        }
        return (ver, out)
    }
    out.clear()
    (0, out)
}

pub(ingot) fn publish(_ handle: u64, _ data: MemSpan) -> i32 {
    unsafe {
        p2p_publish(handle, data.ptr(), data.len())
    }
}

pub(ingot) fn poll_with_peer(_ handle: u64, _ out: mut MemBuffer, _ peer_out: mut MemBuffer) -> (
    i32,
    u64,
) {
    out.clear()
    out.reserve(1280)
    peer_out.clear()
    peer_out.reserve(128)
    var meta = MemBuffer::new(16)
    let rc = unsafe {
        p2p_poll_with_peer(
            handle,
            out.ptr(),
            out.capacity(),
            meta.ptr(),
            peer_out.ptr(),
            peer_out.capacity(),
        )
    }
    if rc > 0 {
        let len: usize = rc.downcast_unchecked()
        let origin = meta.span().read_be<u64>(0)
        let peer_len_u64 = meta.span().read_be<u64>(8)
        let peer_len: usize = peer_len_u64.downcast_saturate()
        let bounded_peer = if peer_len <= peer_out.capacity() {
            peer_len
        } else {
            peer_out.capacity()
        }
        unsafe {
            out.set_len(len)
            peer_out.set_len(bounded_peer)
        }
        return (rc, origin)
    }
    (rc, 0)
}

pub(ingot) fn poll_into(_ handle: u64, _ out: mut MemBuffer) -> i32 {
    out.clear()
    out.reserve(1280)
    let rc = unsafe {
        p2p_poll(handle, out.ptr(), out.capacity())
    }
    if rc > 0 {
        let len: usize = rc.downcast_unchecked()
        unsafe {
            out.set_len(len)
        }
    }
    rc
}

pub(ingot) fn peer_count(_ handle: u64) -> i32 {
    unsafe {
        p2p_peer_count(handle)
    }
}

pub(ingot) fn stop(_ handle: u64) -> i32 {
    unsafe {
        p2p_stop(handle)
    }
}

pub(ingot) fn sleep_ms(_ ms: u32) {
    unsafe {
        p2p_sleep_ms(ms)
    }
}
