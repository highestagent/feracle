        match IpAddr::parse(raw) {
            Option::Some(ip) => Result::Ok(ip),
            Option::None => Result::Err(format!("expected IPv4 or IPv6 address")),
        }
    }
}

impl FromArg for SocketAddr {
    fn from_arg(_ raw: MemSpan) -> Result<MemBuffer, Self> {
        match SocketAddr::parse(raw) {
            Option::Some(addr) => Result::Ok(addr),
            Option::None => Result::Err(format!("expected socket address (e.g. 127.0.0.1:8080)")),
        }
    }
}
