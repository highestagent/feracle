use core::num::IntDowncast
use core::text::{Text, parse_int, parse_uint}
use std::net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr}

/// Indicates where an argument's value originated.
pub enum ValueSource {
    CommandLine,
    Env,
    Default,
}

impl Copy for ValueSource {}

impl core::ops::Eq for ValueSource {
    fn eq(self, _ other: Self) -> bool {
        match (self, other) {
            (Self::CommandLine, Self::CommandLine) => true,
            (Self::Env, Self::Env) => true,
            (Self::Default, Self::Default) => true,
            _ => false,
        }
    }
}

/// Copies any `Text` value into an owned `MemBuffer`.
pub fn text_to_buf<K: Text>(_ text: K) -> MemBuffer {
    let len = text.text_len()
    var buf = MemBuffer::with_capacity(len)
    var i: usize = 0
    while i < len {
        buf.push(text.text_byte(i))
        i += 1
    }
    buf
}

/// Trait for types that can be parsed from a CLI/env argument byte span.
///
/// Consumers implement `FromArg` for their own domain types to get seamless
/// type-inferred parsing via `matches.get(...)` / `matches.require(...)`.
pub trait FromArg {
    fn from_arg(_ raw: MemSpan) -> Result<MemBuffer, Self>
}

fn int_err(_ label: MemSpan) -> MemBuffer {
    format!("expected a valid ", label)
}

fn parse_u256_checked(_ raw: MemSpan, _ label: MemSpan) -> Result<MemBuffer, u256> {
    match parse_uint(raw) {
        Option::Some(v) => Result::Ok(v),
        Option::None => Result::Err(int_err(label)),
    }
}

fn parse_i256_checked(_ raw: MemSpan, _ label: MemSpan) -> Result<MemBuffer, i256> {
    match parse_int(raw) {
        Option::Some(v) => Result::Ok(v),
        Option::None => Result::Err(int_err(label)),
    }
}

impl FromArg for u8 {
    fn from_arg(_ raw: MemSpan) -> Result<MemBuffer, Self> {
        let word = parse_u256_checked(raw, "u8".span())?
        match word.downcast() {
            Option::Some(v) => Result::Ok(v),
            Option::None => Result::Err(int_err("u8".span())),
        }
    }
}

impl FromArg for u16 {
    fn from_arg(_ raw: MemSpan) -> Result<MemBuffer, Self> {
