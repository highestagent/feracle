fn eq_ascii_ignore_case(_ a: MemSpan, _ b: MemSpan) -> bool {
    if a.len() != b.len() {
        return false
    }
    var i: usize = 0
    while i < a.len() {
        let ca = a.byte_at(i)
        let cb = b.byte_at(i)
        let la = if ca >= b'A' && ca <= b'Z' {
            ca + 32
        } else {
            ca
        }
        let lb = if cb >= b'A' && cb <= b'Z' {
            cb + 32
        } else {
            cb
        }
        if la != lb { return false }
        i += 1
    }
    true
}

impl FromArg for bool {
    fn from_arg(_ raw: MemSpan) -> Result<MemBuffer, Self> {
        if eq_ascii_ignore_case(raw, "true".span())
            || eq_ascii_ignore_case(raw, "1".span())
            || eq_ascii_ignore_case(raw, "yes".span())
            || eq_ascii_ignore_case(raw, "on".span()) {
            return Result::Ok(true)
        }
        if eq_ascii_ignore_case(raw, "false".span())
            || eq_ascii_ignore_case(raw, "0".span())
            || eq_ascii_ignore_case(raw, "no".span())
            || eq_ascii_ignore_case(raw, "off".span()) {
            return Result::Ok(false)
        }
        Result::Err(
            format!("expected boolean (true/false, 1/0, yes/no, on/off)"),
        )
    }
}

impl FromArg for MemBuffer {
    fn from_arg(_ raw: MemSpan) -> Result<MemBuffer, Self> {
        Result::Ok(MemBuffer::from_span(raw))
    }
}

impl FromArg for Ipv4Addr {
    fn from_arg(_ raw: MemSpan) -> Result<MemBuffer, Self> {
        match Ipv4Addr::parse(raw) {
            Option::Some(ip) => Result::Ok(ip),
            Option::None => Result::Err(format!("expected IPv4 address (e.g. 127.0.0.1)")),
        }
    }
}

impl FromArg for Ipv6Addr {
    fn from_arg(_ raw: MemSpan) -> Result<MemBuffer, Self> {
        match Ipv6Addr::parse(raw) {
            Option::Some(ip) => Result::Ok(ip),
            Option::None => Result::Err(format!("expected IPv6 address")),
        }
    }
}

impl FromArg for IpAddr {
