use std::io::Error
use std::net::{IpAddr, Ipv4Addr, Net, SocketAddr, Token}
use std::time::Clock
use coro::{Driver, LocalScheduler, Scheduler, TaskId, TimerId}
use net_reactor::{NetDriver, NetPoller, SocketIo, is_would_block}
use p2p::{Delivery, GossipConfig, GossipCore, PeerEntry, Stats, Transport, pick_fanout}
use super::dispatch::{UdpState, handle_packet, send_datagram}
use super::swim::SwimState
use super::wire::{KIND_PING, encode_join, encode_ping_or_ack, encode_ping_req}

pub struct UdpConfig {
    pub bind_addr: SocketAddr,
    pub self_tag: u64,
    pub seeds: MemVec<SocketAddr>,
    pub gossip: GossipConfig,
    pub lan_broadcast_port: u16,
}

pub struct UdpEngine {
    owner: TaskId,
    udp_token: Token,
    local_addr: SocketAddr,
    lan_broadcast_port: u16,
    seeds: MemVec<SocketAddr>,
    state: UdpState,
    timer_id: Option<TimerId>,
    timer_deadline_ms: Option<u64>,
    recv_buf: MemBuffer,
    scratch_tx: MemBuffer,
}

impl UdpEngine {
    pub fn bind(_ config: own UdpConfig, owner: TaskId) -> Result<Error, Self>
    uses (net: mut Net, clock: Clock, sched: mut Scheduler, io: mut SocketIo)
    {
        var sock = net.bind_udp(config.bind_addr)?
        sock.set_nonblocking(true)?
        if config.lan_broadcast_port > 0 {
            sock.set_broadcast(true)?
        }
        let local_addr = sock.local_addr()?
        let udp_token = io.register_udp_socket(owner, tag: 0, sock)?
        let now_ms = sched.now_ms()

        let state = UdpState {
            base: GossipCore::new(
                self_tag: config.self_tag,
                listen_port: local_addr.port(),
                rng_salt: 0x517cc1b727220a95,
                gossip: config.gossip,
            ),
            swim: SwimState::new(now_ms, cfg: config.gossip),
        }

        var engine = UdpEngine {
            owner,
            udp_token,
            local_addr,
            lan_broadcast_port: config.lan_broadcast_port,
            seeds: config.seeds,
            state,
            timer_id: Option::None,
            timer_deadline_ms: Option::None,
            recv_buf: MemBuffer::new(1500),
            scratch_tx: MemBuffer::empty(),
        }
        engine.send_join_to_seeds()
        engine.reschedule_timer(now_ms)
        Result::Ok(engine)
    }

    pub fn local_addr(self) -> SocketAddr {
        self.local_addr
    }

    pub fn self_tag(self) -> u64 {
        self.state.base.self_tag
    }

    pub fn recv(mut self, _ out: mut MemBuffer) -> Option<Delivery> {
        self.state.base.recv(mut out)
    }

    pub fn peer_count(self) -> usize {
        self.state.base.peer_count()
    }

    pub fn peer_entries(self) -> MemVec<PeerEntry> {
        self.state.base.peer_entries()
    }

    pub fn peers_version(self) -> u64 {
        self.state.base.book.version()
    }

    pub fn stats(self) -> Stats {
        self.state.base.stats
    }

    pub fn add_seed(mut self, _ addr: SocketAddr) uses (io: mut SocketIo) {
        self.seeds.push(addr)
        let seq = self.state.base.next_seq()
        var buf = MemBuffer::empty()
        encode_join(
            origin: self.state.base.self_tag,
            seq,
            listen_port: self.state.base.listen_port,
            mut buf,
        )
        let _ = send_datagram(
            self.udp_token,
            mut self.state.base.stats,
            buf.span(),
            addr,
        )
    }

    pub fn publish(mut self, _ payload: MemSpan) -> bool uses (io: mut SocketIo) {
        var frame = MemBuffer::empty()
        if !self.state.base.prepare_publish(payload, mut frame) {
            return false
        }

        var targets = MemVec<usize>::new()
        pick_fanout(
            book: self.state.base.book,
            exclude_tag: self.state.base.self_tag,
            fanout: self.state.base.gossip.fanout,
            rng: mut self.state.base.rng,
            mut targets,
        )
        var sent = false
        var i: usize = 0
        while i < targets.len() {
            let addr = self.state.base.book.get(targets[i]).addr
            if send_datagram(
                self.udp_token,
                mut self.state.base.stats,
                frame.span(),
                addr,
            ) {
                sent = true
            }
            i += 1
        }
        if targets.is_empty() {
            var si: usize = 0
            while si < self.seeds.len() {
                if send_datagram(
                    self.udp_token,
                    mut self.state.base.stats,
                    frame.span(),
                    self.seeds[si],
                ) {
                    sent = true
                }
                si += 1
            }
        }
        sent
    }

    pub fn poll_io(mut self) -> usize uses (sched: mut Scheduler, io: mut SocketIo) {
        if let Option::Some(tid) = self.timer_id {
            if sched.take_timer_fired(tid) {
                self.timer_id = Option::None
                self.timer_deadline_ms = Option::None
            }
        }
        var delivered: usize = 0
        if let Option::Some(ev) = io.take_token_event(self.udp_token) {
            if ev.readable || ev.error || ev.hangup {
                delivered = self.drain_socket(sched.now_ms())
            }
        }
        let end_ms = sched.now_ms()
        self.step_timers(end_ms)
        self.reschedule_timer(end_ms)
        delivered
    }

    pub fn stop(mut self) uses (sched: mut Scheduler, io: mut SocketIo) {
        if let Option::Some(tid) = self.timer_id {
            sched.cancel_timer(tid)
            self.timer_id = Option::None
        }
        self.timer_deadline_ms = Option::None
        sched.cancel_owner_timers(self.owner)
        io.deregister_owner(self.owner)
    }

    fn reschedule_timer(mut self, _ now_ms: u64) uses (sched: mut Scheduler) {
        let deadline = self
            .state
            .swim
            .next_deadline_ms(
                now_ms,
                cfg: self.state.base.gossip,
                book_empty: self.state.base.book.is_empty(),
            )
        let delay = if deadline > now_ms {
            deadline - now_ms
        } else {
            1
        }
        let target_deadline = now_ms + delay
        if self.timer_id.is_some() {
            if let Option::Some(cur) = self.timer_deadline_ms {
                if cur == target_deadline {
                    return
                }
            }
        }
        if let Option::Some(tid) = self.timer_id {
            sched.cancel_timer(tid)
            self.timer_id = Option::None
            self.timer_deadline_ms = Option::None
        }
        self.timer_id = Option::Some(sched.schedule_after(self.owner, delay_ms: delay))
        self.timer_deadline_ms = Option::Some(target_deadline)
    }

    fn send_join_to_seeds(mut self) uses (io: mut SocketIo) {
        if self.seeds.is_empty() {
            return
        }
        let seq = self.state.base.next_seq()
        var buf = MemBuffer::empty()
        encode_join(
            origin: self.state.base.self_tag,
            seq,
            listen_port: self.state.base.listen_port,
            mut buf,
        )
        var i: usize = 0
        while i < self.seeds.len() {
            let seed = self.seeds[i]
            if seed != self.local_addr {
                let _ = send_datagram(
                    self.udp_token,
                    mut self.state.base.stats,
                    buf.span(),
                    seed,
                )
            }
            i += 1
        }
    }

    fn send_lan_join(mut self) uses (io: mut SocketIo) {
        if self.lan_broadcast_port == 0 {
            return
        }
        let seq = self.state.base.next_seq()
        var buf = MemBuffer::empty()
        encode_join(
            origin: self.state.base.self_tag,
            seq,
            listen_port: self.state.base.listen_port,
            mut buf,
        )
        let bcast = SocketAddr::new(
            IpAddr::V4(Ipv4Addr::new(255, 255, 255, 255)),
            self.lan_broadcast_port,
        )
        let _ = send_datagram(
            self.udp_token,
            mut self.state.base.stats,
            buf.span(),
            bcast,
        )
    }

    fn step_timers(mut self, _ now_ms: u64) uses (io: mut SocketIo) {
        let tick = self
            .state
            .swim
            .on_tick(
                now_ms,
                book: mut self.state.base.book,
                cfg: self.state.base.gossip,
            )
        if tick.send_join_seeds {
            self.send_join_to_seeds()
        }
        if tick.send_lan_join {
            self.send_lan_join()
        }
        let tx = mut self.scratch_tx
        tx.clear()
        if let Option::Some((probe_id, target_addr)) = tick.send_ping {
            let seq = self.state.base.next_seq()
            encode_ping_or_ack(
                kind: KIND_PING,
                origin: self.state.base.self_tag,
                seq,
                probe_id,
                listen_port: self.state.base.listen_port,
                peers: self.state.base.book.alive_entries(exclude_tag: self.state.base.self_tag),
                mut tx,
            )
            let _ = send_datagram(
                self.udp_token,
                mut self.state.base.stats,
                tx.span(),
                target_addr,
            )
        }
        if let Option::Some((probe_id, target_tag, target_addr)) = tick.send_indirect {
            var helpers = MemVec<usize>::new()
            pick_fanout(
                book: self.state.base.book,
                exclude_tag: target_tag,
                fanout: 2,
                rng: mut self.state.base.rng,
                mut helpers,
            )
            if !helpers.is_empty() {
                let seq = self.state.base.next_seq()
                if encode_ping_req(
                    origin: self.state.base.self_tag,
                    seq,
                    probe_id,
                    target_tag,
                    target_addr,
                    mut tx,
                ) {
                    var i: usize = 0
                    while i < helpers.len() {
                        let helper_addr = self.state.base.book.get(helpers[i]).addr
                        let _ = send_datagram(
                            self.udp_token,
                            mut self.state.base.stats,
                            tx.span(),
                            helper_addr,
                        )
                        i += 1
                    }
                }
            }
        }
    }

    fn drain_socket(mut self, _ now_ms: u64) -> usize uses (io: mut SocketIo) {
        var delivered: usize = 0
        let buf = mut self.recv_buf
        while true {
            let recv_res = match io.udp_recv_from(self.udp_token, mut buf.span()) {
                Option::Some(r) => r,
                Option::None => {
                    break
                },
            }
            match recv_res {
                Result::Ok((n, from)) => {
                    let before = self.state.base.inbox.len()
                    handle_packet(
                        bytes: buf.span().head(n),
                        from,
                        now_ms,
                        state: mut self.state,
                        self.udp_token,
                    )
                    if self.state.base.inbox.len() > before {
                        delivered += 1
                    }
                },
                Result::Err(err) => {
                    if is_would_block(err) {
                        break
                    }
                    break
                },
            }
        }
        delivered
    }
}

pub struct UdpTransport {
    engine: UdpEngine,
    sched: LocalScheduler,
    io: NetPoller,
    driver: NetDriver,
}

impl UdpTransport {
    pub fn bind(_ config: own UdpConfig) -> Result<Error, Self>
    uses (net: mut Net, clock: Clock)
    {
        var sched = LocalScheduler::new(0)
        var io = NetPoller::new()?
        let driver = NetDriver::new(max_wait_ms: 20)
        let engine = with (Scheduler = sched, SocketIo = io) {
            let owner = sched.alloc_task()
            UdpEngine::bind(config, owner)
        }?
        Result::Ok(UdpTransport { engine, sched, io, driver })
    }
}

fn udp_transport_publish(_ engine: mut UdpEngine, _ io: mut NetPoller, _ payload: MemSpan) -> bool {
    with (SocketIo = io) {
        engine.publish(payload)
    }
}

fn udp_transport_poll(
    _ engine: mut UdpEngine,
    _ sched: mut LocalScheduler,
    _ io: mut NetPoller,
    _ driver: mut NetDriver,
    timeout_ms: u64,
) -> usize
uses (clock: Clock)
{
    with (Scheduler = sched, SocketIo = io) {
        driver.set_max_wait_ms(timeout_ms)
        driver.begin_tick()
        let pre = engine.poll_io()
        driver.wait()
        pre + engine.poll_io()
    }
}

fn udp_transport_add_seed(_ engine: mut UdpEngine, _ io: mut NetPoller, _ addr: SocketAddr) {
    with (SocketIo = io) {
        engine.add_seed(addr)
    }
}

impl Transport for UdpTransport {
    fn local_addr(self) -> SocketAddr {
        self.engine.local_addr()
    }

    fn self_tag(self) -> u64 {
        self.engine.self_tag()
    }

    fn publish(mut self, _ payload: MemSpan) -> bool
    uses (net: mut Net, clock: Clock)
    {
        udp_transport_publish(mut self.engine, mut self.io, payload)
    }

    fn poll(mut self, timeout_ms: u64) -> usize uses (net: mut Net, clock: Clock) {
        udp_transport_poll(
            mut self.engine,
            mut self.sched,
            mut self.io,
            mut self.driver,
            timeout_ms,
        )
    }

    fn recv(mut self, _ out: mut MemBuffer) -> Option<Delivery> {
        self.engine.recv(mut out)
    }

    fn peer_count(self) -> usize {
        self.engine.peer_count()
    }

    fn peer_entries(self) -> MemVec<PeerEntry> {
        self.engine.peer_entries()
    }

    fn stats(self) -> Stats {
        self.engine.stats()
    }

    fn add_seed(mut self, _ addr: SocketAddr) {
        udp_transport_add_seed(mut self.engine, mut self.io, addr)
    }
}
