//! Bounded memory of recently seen frame identities.
//!
//! A hash set gives O(1) membership; a ring of the same identities evicts
//! the oldest once `capacity` is reached, so memory stays fixed forever.

use core::map::HashMap

pub struct SeenCache { index: HashMap<u128, u8>, ring: MemVec<u128>, next: usize, capacity: usize }

impl SeenCache {
    pub fn new(_ capacity: usize) -> Self {
        assert!(capacity > 0, "a SeenCache needs room")
        SeenCache {
            index: HashMap::with_capacity(capacity),
            ring: MemVec::with_capacity(capacity),
            next: 0,
            capacity,
        }
    }

    /// Records `id`; `true` the first time it is seen, `false` for repeats.
    pub fn insert(mut self, _ id: u128) -> bool {
        if self.index.contains_key(id) {
            return false
        }
        if self.ring.len() < self.capacity {
            self.ring.push(id)
        } else {
            let evicted = self.ring.replace(self.next, id)
            let _ = self.index.remove(evicted)
            self.next = (self.next + 1) % self.capacity
        }
        let _ = self.index.insert(id, 1)
        true
    }

    pub fn contains(self, _ id: u128) -> bool {
        self.index.contains_key(id)
    }

    pub fn len(self) -> usize {
        self.index.len()
    }
}
