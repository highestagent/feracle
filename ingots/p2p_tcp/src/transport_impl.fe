//! Timer upkeep and `Transport` trait implementation for `TcpTransport`.

use std::net::{Net, SocketAddr, Token}
use std::time::{Clock, Duration}
use p2p::{Delivery, PeerEntry, Stats, Transport}
use super::conn::TcpSlot
use super::mesh::{close_peer, queue_to_peer}
use super::transport::TcpTransport
use super::wire::{KIND_PING, encode_pex, encode_ping_or_pong}

fn step_timers(_ t: mut TcpTransport, _ now_ms: u64) uses (net: mut Net) {
    t.dial_due(now_ms)
    var stale = MemVec<Token>::new()
    var ti: usize = 0
    while ti < t.peer_tokens.len() {
        let tok = t.peer_tokens[ti]
        if let Option::Some(ref slot) = t.poller.get(tok) {
            if let TcpSlot::Peer(ref conn) = slot {
                if now_ms >= conn.last_activity_ms + t.state.base.gossip.dead_ms {
                    stale.push(tok)
                }
            }
        }
        ti += 1
    }
    var si: usize = 0
    while si < stale.len() {
        close_peer(
            mut t.poller,
            mut t.peer_tokens,
            stale[si],
            now_ms,
            mut t.state,
        )
        si += 1
    }
    if t.pex_ticker.due(now_ms) {
        var snapshot = MemVec<Token>::new()
        snapshot.extend_from_slice(t.peer_tokens.as_slice())
        var i: usize = 0
        while i < snapshot.len() {
            let tok = snapshot[i]
            var tag_opt: Option<u64> = Option::None
            if let Option::Some(ref slot) = t.poller.get(tok) {
                if let TcpSlot::Peer(ref conn) = slot {
                    if conn.state.is_established() {
                        tag_opt = conn.remote_tag
                    }
                }
            }
            if let Option::Some(tag) = tag_opt {
                var pex_buf = MemBuffer::empty()
                let seq = t.state.base.next_seq()
                encode_pex(
                    origin: t.state.base.self_tag,
                    seq,
                    peers: t.state.base.book.alive_entries(exclude_tag: tag),
                    mut pex_buf,
                )
                let _ = queue_to_peer(
                    mut t.poller,
                    mut t.peer_tokens,
                    tok,
                    pex_buf.span(),
                    now_ms,
                    mut t.state,
                )
            }
            i += 1
        }
    }
    if t.ping_ticker.due(now_ms) {
        t.nonce += 1
        var ping_buf = MemBuffer::empty()
        let seq = t.state.base.next_seq()
        encode_ping_or_pong(
            kind: KIND_PING,
            origin: t.state.base.self_tag,
            seq,
            nonce: t.nonce,
            mut ping_buf,
        )
        var snapshot = MemVec<Token>::new()
        snapshot.extend_from_slice(t.peer_tokens.as_slice())
        var pi: usize = 0
        while pi < snapshot.len() {
            let tok = snapshot[pi]
            var est = false
            if let Option::Some(ref slot) = t.poller.get(tok) {
                if let TcpSlot::Peer(ref conn) = slot {
                    est = conn.state.is_established()
                }
            }
            if est {
                let _ = queue_to_peer(
                    mut t.poller,
                    mut t.peer_tokens,
                    tok,
                    ping_buf.span(),
                    now_ms,
                    mut t.state,
                )
            }
            pi += 1
        }
    }
}

impl Transport for TcpTransport {
    fn local_addr(self) -> SocketAddr {
        self.local_addr
    }

    fn self_tag(self) -> u64 {
        self.state.base.self_tag
    }

    fn publish(mut self, _ payload: MemSpan) -> bool
    uses (net: mut Net, clock: Clock)
    {
        let now_ms = self.clock.now_ms()
        var frame = MemBuffer::empty()
        if !self.state.base.prepare_publish(payload, mut frame) {
            return false
        }

        var targets = MemVec<Token>::new()
        var i: usize = 0
        while i < self.peer_tokens.len() {
            let tok = self.peer_tokens[i]
            if let Option::Some(ref slot) = self.poller.get(tok) {
                if let TcpSlot::Peer(ref conn) = slot {
                    if conn.state.is_established() {
                        targets.push(tok)
                    }
                }
            }
            i += 1
        }
        let limit = if self.state.base.gossip.fanout < targets.len() {
            self.state.base.gossip.fanout
        } else {
            targets.len()
        }
        var sent = false
        var chosen: usize = 0
        while chosen < limit {
            let pick = chosen + self.state.base.rng.below(targets.len() - chosen)
            if pick != chosen {
                targets.swap(chosen, pick)
            }
            if queue_to_peer(
                mut self.poller,
                mut self.peer_tokens,
                targets[chosen],
                frame.span(),
                now_ms,
                mut self.state,
            ) {
                sent = true
            }
            chosen += 1
        }
        sent
    }

    fn poll(mut self, timeout_ms: u64) -> usize uses (net: mut Net, clock: Clock) {
        let start_ms = self.clock.now_ms()
        step_timers(mut self, start_ms)
        let n = match self.poller
            .wait(
                mut self.events,
                Option::Some(Duration::from_millis(timeout_ms)),
            ) {
            Result::Ok(count) => count,
            Result::Err(_) => 0,
        }
        let before = self.state.base.inbox.len()
        let now_ms = self.clock.now_ms()
        var i: usize = 0
        while i < n {
            let ev = self.events.get(i)
            if ev.token() == self.listener_token {
                self.accept_all(now_ms)
            } else {
                self.handle_peer_event(ev, now_ms)
            }
            i += 1
        }
        let end_ms = self.clock.now_ms()
        step_timers(mut self, end_ms)
        if self.state.base.inbox.len() >= before {
            self.state.base.inbox.len() - before
        } else {
            0
        }
    }

    fn recv(mut self, _ out: mut MemBuffer) -> Option<Delivery> {
        self.state.base.recv(mut out)
    }

    fn peer_count(self) -> usize {
        self.state.base.peer_count()
    }

    fn peer_entries(self) -> MemVec<PeerEntry> {
        self.state.base.peer_entries()
    }

    fn stats(self) -> Stats {
        self.state.base.stats
    }

    fn add_seed(mut self, _ addr: SocketAddr) {
        if addr != self.local_addr {
            self.state.dialer.add_addr(addr)
        }
    }
}
