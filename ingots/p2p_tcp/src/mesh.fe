//! TCP mesh state, interest synchronization, and peer cleanup helpers.

use std::net::{Interest, Poller, SocketAddr, Token}
use p2p::GossipCore
use super::conn::TcpSlot
use super::dialer::DialBook

pub struct TcpMeshState { pub base: GossipCore, pub dialer: DialBook }

pub fn sync_interest(_ poller: mut Poller<TcpSlot>, _ token: Token) {
    var changed = false
    var next_writable = false
    match poller.get(token) {
        Option::Some(ref slot) => {
            if let TcpSlot::Peer(ref conn) = slot {
                next_writable = conn.state.is_connecting() || conn.has_pending_write()
                changed = next_writable != conn.want_writable
            }
        },
        Option::None => {
            return
        },
    }
    if !changed { return }
    if let Option::Some(mut slot) = poller.get(token) {
        if let TcpSlot::Peer(mut conn) = slot {
            conn.want_writable = next_writable
        }
    }
    let interest = if next_writable {
        Interest::BOTH
    } else {
        Interest::READABLE
    }
    let _ = poller.set_interest(token, interest)
}

fn has_other_established(
    _ poller: Poller<TcpSlot>,
    _ tokens: MemVec<Token>,
    tag: u64,
    skip: Token,
) -> bool {
    var i: usize = 0
    while i < tokens.len() {
        let tok = tokens[i]
        if tok != skip {
            if let Option::Some(ref slot) = poller.get(tok) {
                if let TcpSlot::Peer(ref conn) = slot {
                    if conn.state.is_established() {
                        if let Option::Some(rt) = conn.remote_tag {
                            if rt == tag { return true }
                        }
                    }
                }
            }
        }
        i += 1
    }
    false
}

pub fn close_peer(
    _ poller: mut Poller<TcpSlot>,
    _ peer_tokens: mut MemVec<Token>,
    _ token: Token,
    _ now_ms: u64,
    _ state: mut TcpMeshState,
) {
    var was_established = false
    var tag_opt: Option<u64> = Option::None
    match poller.get(token) {
        Option::Some(ref slot) => {
            if let TcpSlot::Peer(ref conn) = slot {
                was_established = conn.state.is_established()
                tag_opt = conn.remote_tag
            }
        },
        Option::None => {
            return
        },
    }
    let _ = poller.remove(token)
    var i: usize = 0
    while i < peer_tokens.len() {
        if peer_tokens[i] == token {
            let _ = peer_tokens.swap_remove(i)
            break
        }
        i += 1
    }
    state.dialer.mark_closed(token, now_ms, was_established)
    if let Option::Some(tag) = tag_opt {
        if !has_other_established(poller, peer_tokens, tag, skip: token) {
            if let Option::Some(idx) = state.base.book.find_tag(tag) {
                let _ = state.base.book.remove(idx)
            }
        }
    }
}

pub fn queue_to_peer(
    _ poller: mut Poller<TcpSlot>,
    _ peer_tokens: mut MemVec<Token>,
    _ token: Token,
    _ bytes: MemSpan,
    _ now_ms: u64,
    _ state: mut TcpMeshState,
) -> bool {
    var ok = false
    match poller.get(token) {
        Option::Some(mut slot) => {
            if let TcpSlot::Peer(mut conn) = slot {
                if conn.queue_bytes(bytes) && conn.flush().is_ok() {
                    state.base.stats.frames_tx += 1
                    ok = true
                }
            }
        },
        Option::None => {
            return false
        },
    }
    if !ok {
        close_peer(mut poller, mut peer_tokens, token, now_ms, mut state)
        return false
    }
    sync_interest(mut poller, token)
    true
}

pub fn find_duplicate_established(
    _ poller: Poller<TcpSlot>,
    _ tokens: MemVec<Token>,
    tag: u64,
    skip: Token,
) -> Option<(Token, bool)> {
    var i: usize = 0
    while i < tokens.len() {
        let tok = tokens[i]
        if tok != skip {
            if let Option::Some(ref slot) = poller.get(tok) {
                if let TcpSlot::Peer(ref conn) = slot {
                    if conn.state.is_established() {
                        if let Option::Some(rt) = conn.remote_tag {
                            if rt == tag {
                                return Option::Some((tok, conn.outbound))
                            }
                        }
                    }
                }
            }
        }
        i += 1
    }
    Option::None
}

pub fn peer_meta(_ poller: Poller<TcpSlot>, _ token: Token) -> Option<
    (SocketAddr, SocketAddr, bool, Option<u64>, bool),
> {
    match poller.get(token) {
        Option::Some(ref slot) => match slot {
            TcpSlot::Peer(ref c) => {
                Option::Some(
                    (
                        c.remote_addr,
                        c.listen_addr,
                        c.outbound,
                        c.remote_tag,
                        c.state.is_established(),
                    ),
                )
            },
            TcpSlot::Listener(_) => Option::None,
        },
        Option::None => Option::None,
    }
}
