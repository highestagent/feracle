use std::net::{Interest, SocketAddr, Token}
use net_reactor::SocketIo
use p2p::GossipCore
use super::conn::PeerConn
use super::dialer::DialBook

pub struct TcpMeshState { pub base: GossipCore, pub dialer: DialBook }

pub fn find_peer_index(_ peers: MemVec<PeerConn>, _ token: Token) -> Option<usize> {
    var i: usize = 0
    while i < peers.len() {
        if peers[i].token == token {
            return Option::Some(i)
        }
        i += 1
    }
    Option::None
}

pub fn sync_interest(_ peers: mut MemVec<PeerConn>, _ token: Token)
uses (io: mut SocketIo)
{
    let Option::Some(idx) = find_peer_index(peers, token) else {
        return
    }
    let next_writable = peers[idx].state.is_connecting() || peers[idx].has_pending_write()
    if next_writable == peers[idx].want_writable {
        return
    }
    if let Option::Some(mut conn) = peers.get(idx) {
        conn.want_writable = next_writable
    }
    let interest = if next_writable {
        Interest::BOTH
    } else {
        Interest::READABLE
    }
    let _ = io.set_interest(token, interest)
}

fn has_other_established(_ peers: MemVec<PeerConn>, tag: u64, skip: Token) -> bool {
    var i: usize = 0
    while i < peers.len() {
        let conn = ref peers[i]
        if conn.token != skip && conn.state.is_established() {
            if let Option::Some(rt) = conn.remote_tag {
                if rt == tag { return true }
            }
        }
        i += 1
    }
    false
}

pub fn close_peer(
    _ peers: mut MemVec<PeerConn>,
    _ token: Token,
    _ now_ms: u64,
    _ state: mut TcpMeshState,
)
uses (io: mut SocketIo)
{
    let Option::Some(idx) = find_peer_index(peers, token) else {
        return
    }
    let was_established = peers[idx].state.is_established()
    let tag_opt = peers[idx].remote_tag
    io.deregister(token)
    let _ = peers.swap_remove(idx)
    state.dialer.mark_closed(token, now_ms, was_established)
    if let Option::Some(tag) = tag_opt {
        if !has_other_established(peers, tag, skip: token) {
            if let Option::Some(b_idx) = state.base.book.find_tag(tag) {
                let _ = state.base.book.remove(b_idx)
            }
        }
    }
}

pub fn queue_to_peer(
    _ peers: mut MemVec<PeerConn>,
    _ token: Token,
    _ bytes: MemSpan,
    _ now_ms: u64,
    _ state: mut TcpMeshState,
) -> bool
uses (io: mut SocketIo)
{
    let Option::Some(idx) = find_peer_index(peers, token) else {
        return false
    }
    var ok = false
    if let Option::Some(mut conn) = peers.get(idx) {
        if conn.queue_bytes(bytes) && conn.flush().is_ok() {
            state.base.stats.frames_tx += 1
            ok = true
        }
    }
    if !ok {
        close_peer(mut peers, token, now_ms, mut state)
        return false
    }
    sync_interest(mut peers, token)
    true
}

pub fn find_duplicate_established(_ peers: MemVec<PeerConn>, tag: u64, skip: Token) -> Option<
    (Token, bool),
> {
    var i: usize = 0
    while i < peers.len() {
        let conn = ref peers[i]
        if conn.token != skip && conn.state.is_established() {
            if let Option::Some(rt) = conn.remote_tag {
                if rt == tag {
                    return Option::Some((conn.token, conn.outbound))
                }
            }
        }
        i += 1
    }
    Option::None
}

pub fn peer_meta(_ peers: MemVec<PeerConn>, _ token: Token) -> Option<
    (SocketAddr, SocketAddr, bool, Option<u64>, bool),
> {
    let Option::Some(idx) = find_peer_index(peers, token) else {
        return Option::None
    }
    let c = ref peers[idx]
    Option::Some(
        (c.remote_addr, c.listen_addr, c.outbound, c.remote_tag, c.state.is_established()),
    )
}
