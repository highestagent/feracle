use std::io::Error
use std::net::{Interest, Net, SocketAddr, Token}
use std::time::Clock
use coro::{LocalScheduler, Scheduler, TaskId, TimerId}
use net_reactor::{IoEvent, NetDriver, NetPoller, SocketIo}
use p2p::{GossipConfig, GossipCore, Ticker}
use super::conn::{ConnState, FrameStep, PeerConn}
use super::dialer::DialBook
use super::dispatch::handle_frame
use super::mesh::{TcpMeshState, close_peer, find_peer_index, queue_to_peer, sync_interest}
use super::wire::encode_hello

pub struct TcpConfig {
    pub bind_addr: SocketAddr,
    pub self_tag: u64,
    pub seeds: MemVec<SocketAddr>,
    pub gossip: GossipConfig,
}

pub struct TcpEngine {
    pub(ingot) owner: TaskId,
    pub(ingot) listener_token: Token,
    pub(ingot) peers: MemVec<PeerConn>,
    pub(ingot) local_addr: SocketAddr,
    pub(ingot) pex_ticker: Ticker,
    pub(ingot) ping_ticker: Ticker,
    pub(ingot) nonce: u64,
    pub(ingot) state: TcpMeshState,
    pub(ingot) timer_id: Option<TimerId>,
}

impl TcpEngine {
    pub fn bind(_ config: own TcpConfig, owner: TaskId) -> Result<Error, Self>
    uses (net: mut Net, clock: Clock, sched: mut Scheduler, io: mut SocketIo)
    {
        var listener = net.listen(config.bind_addr)?
        listener.set_nonblocking(true)?
        let local_addr = listener.local_addr()?
        let listener_token = io.register_tcp_listener(owner, tag: 0, listener)?
        let now_ms = sched.now_ms()

        var dialer = DialBook::new(
            base_ms: config.gossip.reconnect_base_ms,
            max_ms: config.gossip.reconnect_max_ms,
        )
        var i: usize = 0
        while i < config.seeds.len() {
            if config.seeds[i] != local_addr {
                dialer.add_addr(config.seeds[i])
            }
            i += 1
        }

        let state = TcpMeshState {
            base: GossipCore::new(
                self_tag: config.self_tag,
                listen_port: local_addr.port(),
                rng_salt: 0x9e3779b97f4a7c15,
                gossip: config.gossip,
            ),
            dialer,
        }

        var engine = TcpEngine {
            owner,
            listener_token,
            peers: MemVec::new(),
            local_addr,
            pex_ticker: Ticker::new(period_ms: config.gossip.heartbeat_ms, now_ms),
            ping_ticker: Ticker::new(period_ms: config.gossip.heartbeat_ms, now_ms),
            nonce: 0,
            state,
            timer_id: Option::None,
        }
        engine.dial_due(now_ms)
        engine.reschedule_timer(now_ms)
        Result::Ok(engine)
    }

    pub(ingot) fn dial_due(mut self, _ now_ms: u64) uses (net: mut Net, io: mut SocketIo) {
        var attempts: usize = 0
        while attempts < 8 {
            let Option::Some(addr) = self
                .state
                .dialer
                .next_due(now_ms, book: self.state.base.book) else {
                break
            }
            attempts += 1
            if addr == self.local_addr {
                self.state.dialer.mark_fail(addr, now_ms)
                continue
            }
            match net.connect_nonblocking(addr) {
                Result::Ok(var stream) => {
                    let _ = stream.set_nodelay(true)
                    match io.register_tcp_stream(
                        owner: self.owner,
                        tag: 1,
                        stream,
                        Interest::BOTH,
                    ) {
                        Result::Ok(tok) => {
                            self.peers
                                .push(
                                    PeerConn::new(
                                        token: tok,
                                        state: ConnState::Connecting,
                                        outbound: true,
                                        remote_addr: addr,
                                        now_ms,
                                        want_writable: true,
                                    ),
                                )
                            self.state.dialer.mark_active(addr, tok)
                        },
                        Result::Err(_) => self.state.dialer.mark_fail(addr, now_ms),
                    }
                },
                Result::Err(_) => self.state.dialer.mark_fail(addr, now_ms),
            }
        }
    }

    pub(ingot) fn accept_all(mut self, _ now_ms: u64) uses (io: mut SocketIo) {
        while true {
            let pair = match io.listener_accept(self.listener_token) {
                Option::Some(Result::Ok(p)) => p,
                _ => {
                    return
                },
            }
            var stream = pair.0
            let peer_addr = pair.1
            if stream.set_nonblocking(true).is_err() || stream.set_nodelay(true).is_err() {
                continue
            }
            let Ok(tok) = io
                .register_tcp_stream(
                    owner: self.owner,
                    tag: 1,
                    stream,
                    Interest::READABLE,
                ) else {
                continue
            }
            self.peers
                .push(
                    PeerConn::new(
                        token: tok,
                        state: ConnState::Handshaking,
                        outbound: false,
                        remote_addr: peer_addr,
                        now_ms,
                        want_writable: false,
                    ),
                )
            var hello = MemBuffer::empty()
            let seq = self.state.base.next_seq()
            encode_hello(
                origin: self.state.base.self_tag,
                seq,
                listen_port: self.state.base.listen_port,
                mut hello,
            )
            let _ = queue_to_peer(mut self.peers, tok, hello.span(), now_ms, mut self.state)
        }
    }

    fn handle_writable(mut self, _ token: Token, _ now_ms: u64) -> bool
    uses (io: mut SocketIo)
    {
        let Option::Some(idx) = find_peer_index(self.peers, token) else {
            return false
        }
        var connecting = false
        var failed = false
        if self.peers[idx].state.is_connecting() {
            connecting = true
            match io.stream_take_error(token) {
                Option::Some(Result::Ok(Option::None)) => {
                    if let Option::Some(mut conn) = self.peers.get(idx) {
                        conn.state = ConnState::Handshaking
                        conn.last_activity_ms = now_ms
                    }
                },
                _ => failed = true,
            }
        } else if self.peers[idx].has_pending_write() {
            if let Option::Some(mut conn) = self.peers.get(idx) {
                if !conn.flush().is_ok() {
                    failed = true
                }
            }
        }

        if failed {
            close_peer(mut self.peers, token, now_ms, mut self.state)
            return false
        }
        if connecting {
            var hello = MemBuffer::empty()
            let seq = self.state.base.next_seq()
            encode_hello(
                origin: self.state.base.self_tag,
                seq,
                listen_port: self.state.base.listen_port,
                mut hello,
            )
            return queue_to_peer(
                mut self.peers,
                token,
                hello.span(),
                now_ms,
                mut self.state,
            )
        }
        sync_interest(mut self.peers, token)
        true
    }

    pub(ingot) fn handle_peer_event(mut self, _ ev: IoEvent, _ now_ms: u64)
    uses (io: mut SocketIo)
    {
        let tok = ev.token
        if ev.writable && !self.handle_writable(tok, now_ms) {
            return
        }
        if ev.readable {
            let Option::Some(idx) = find_peer_index(self.peers, tok) else {
                return
            }
            var frames = MemVec<MemBuffer>::new()
            var dead = false
            if let Option::Some(mut conn) = self.peers.get(idx) {
                if !conn.read_into(now_ms).is_ok() {
                    dead = true
                }
                var one = MemBuffer::empty()
                while true {
                    match conn.next_frame(mut one) {
                        FrameStep::Frame => frames.push(MemBuffer::from_span(one.span())),
                        FrameStep::NeedMore => {
                            break
                        },
                        FrameStep::Invalid => {
                            dead = true
                            break
                        },
                    }
                }
            }
            var fi: usize = 0
            while fi < frames.len() {
                handle_frame(
                    token: tok,
                    raw: frames[fi].span(),
                    now_ms,
                    mut self.peers,
                    mut self.state,
                )
                fi += 1
            }
            if dead {
                close_peer(mut self.peers, tok, now_ms, mut self.state)
                return
            }
        }
        if ev.error || ev.hangup {
            close_peer(mut self.peers, tok, now_ms, mut self.state)
        }
    }
}

pub struct TcpTransport {
    pub(ingot) engine: TcpEngine,
    pub(ingot) sched: LocalScheduler,
    pub(ingot) io: NetPoller,
    pub(ingot) driver: NetDriver,
}

impl TcpTransport {
    pub fn bind(_ config: own TcpConfig) -> Result<Error, Self>
    uses (net: mut Net, clock: Clock)
    {
        var sched = LocalScheduler::new(0)
        var io = NetPoller::new()?
        let driver = NetDriver::new(max_wait_ms: 20)
        let engine = with (Scheduler = sched, SocketIo = io) {
            let owner = sched.alloc_task()
            TcpEngine::bind(config, owner)
        }?
        Result::Ok(TcpTransport { engine, sched, io, driver })
    }
}
