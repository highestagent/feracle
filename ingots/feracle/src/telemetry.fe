use core::num::IntDowncast
use std::net::{IpAddr, Ipv4Addr, Net, SocketAddr}
use std::time::Clock
use coro::Scheduler
use feracle_core::{
    ASSET_COUNT,
    MSG_TYPE_QUOTE,
    MSG_TYPE_SIG,
    QUOTE_FRAME_LEN,
    SIG_FRAME_LEN,
    hex_char,
    push_hex_bytes,
}
use http::{HttpEvent, HttpServer}
use net_reactor::SocketIo

const MAX_RECENT_FRAMES: usize = 128
const MAX_FEED_SLOTS: usize = 8

pub enum TelemetryEvent {
    ToleranceBreach,
    SubmitOk { pub duration_ms: u64 },
    SubmitErr { pub duration_ms: u64 },
    RoundStarted,
}

impl Copy for TelemetryEvent {}

struct FeedSlot {
    present: bool,
    provider: MemBuffer,
    addr: MemBuffer,
    price: u64,
    assets_ok: u32,
    ok: bool,
    latency_ms: u64,
}

struct TelemetryFrame { seq: u64, ts_ms: u64, is_tx: bool, peer: MemBuffer, hex: MemBuffer }

pub struct TelemetryState {
    node_id: u64,
    peer_id: MemBuffer,
    p2p_port: u16,
    peer_count: usize,
    peers_csv: MemBuffer,
    round_id: u64,
    phase: MemBuffer,
    local_prices: [u64; 20],
    group_medians: [u64; 20],
    round_ts: u64,
    feeds: MemVec<FeedSlot>,
    quotes_tx: u64,
    quotes_rx: u64,
    sigs_tx: u64,
    sigs_rx: u64,
    tolerance_breaches: u64,
    submissions_ok: u64,
    submissions_err: u64,
    last_submit_ms: u64,
    frame_seq: u64,
    recent_frames: MemVec<TelemetryFrame>,
    frames_head: usize,
}

fn push_json_escaped(_ out: mut MemBuffer, _ s: MemSpan) {
    out.push(b'"')
    var i: usize = 0
    while i < s.len() {
        let b = s.byte_at(i)
        if b == b'"' {
            out.extend_from("\\\"".span())
        } else if b == b'\\' {
            out.extend_from("\\\\".span())
        } else if b == b'\n' {
            out.extend_from("\\n".span())
        } else if b == b'\r' {
            out.extend_from("\\r".span())
        } else if b == b'\t' {
            out.extend_from("\\t".span())
        } else if b < 0x20 {
            out.extend_from("\\u00".span())
            out.push(hex_char(b >> 4))
            out.push(hex_char(b & 0x0f))
        } else {
            out.push(b)
        }
        i += 1
    }
    out.push(b'"')
}

fn push_u64_array_json(_ out: mut MemBuffer, _ vals: [u64; 20]) {
    out.push(b'[')
    var i: usize = 0
    while i < ASSET_COUNT {
        if i > 0 { out.push(b',') }
        write!(mut out, vals[i])
        i += 1
    }
    out.push(b']')
}

impl TelemetryState {
    pub fn new(node_id: u64, peer_id: own MemBuffer, p2p_port: u16) -> Self {
        var feeds = MemVec<FeedSlot>::new()
        var i: usize = 0
        while i < MAX_FEED_SLOTS {
            feeds
                .push(
                    FeedSlot {
                        present: false,
                        provider: MemBuffer::empty(),
                        addr: MemBuffer::empty(),
                        price: 0,
                        assets_ok: 0,
                        ok: false,
                        latency_ms: 0,
                    },
                )
            i += 1
        }
        TelemetryState {
            node_id,
            peer_id,
            p2p_port,
            peer_count: 0,
            peers_csv: MemBuffer::empty(),
            round_id: 0,
            phase: MemBuffer::from_span("starting".span()),
            local_prices: [0; 20],
            group_medians: [0; 20],
            round_ts: 0,
            feeds,
            quotes_tx: 0,
            quotes_rx: 0,
            sigs_tx: 0,
            sigs_rx: 0,
            tolerance_breaches: 0,
            submissions_ok: 0,
            submissions_err: 0,
            last_submit_ms: 0,
            frame_seq: 0,
            recent_frames: MemVec::new(),
            frames_head: 0,
        }
    }

    pub fn update_peers(mut self, peer_count: usize, peers_csv: MemSpan) -> bool {
        if peer_count == self.peer_count && peers_csv == self.peers_csv.span() {
            return false
        }
        self.peer_count = peer_count
        self.peers_csv.clear()
        self.peers_csv.extend_from(peers_csv)
        true
    }

    pub fn set_phase(
        mut self,
        round_id: u64,
        phase: MemSpan,
        local_prices: [u64; 20],
        group_medians: [u64; 20],
        round_ts: u64,
    ) {
        self.round_id = round_id
        self.phase.clear()
        self.phase.extend_from(phase)
        self.local_prices = local_prices
        self.group_medians = group_medians
        self.round_ts = round_ts
    }

    pub fn set_feed(
        mut self,
        slot: u32,
        provider: MemSpan,
        addr: MemSpan,
        price: u64,
        assets_ok: u32,
        ok: bool,
        latency_ms: u64,
    ) {
        let idx: usize = slot.downcast_unchecked()
        if idx >= MAX_FEED_SLOTS {
            return
        }
        if let Option::Some(mut entry) = self.feeds.get(idx) {
            entry.present = true
            entry.provider.clear()
            entry.provider.extend_from(provider)
            entry.addr.clear()
            entry.addr.extend_from(addr)
            entry.price = price
            entry.assets_ok = assets_ok
            entry.ok = ok
            entry.latency_ms = latency_ms
        }
    }

    pub fn record_event(mut self, _ ev: TelemetryEvent) -> bool {
        match ev {
            TelemetryEvent::ToleranceBreach => {
                self.tolerance_breaches += 1
                true
            },
            TelemetryEvent::SubmitOk { duration_ms } => {
                self.submissions_ok += 1
                self.last_submit_ms = duration_ms
                true
            },
            TelemetryEvent::SubmitErr { duration_ms } => {
                self.submissions_err += 1
                self.last_submit_ms = duration_ms
                true
            },
            TelemetryEvent::RoundStarted => {
                var i: usize = 0
                while i < MAX_FEED_SLOTS {
                    if let Option::Some(mut entry) = self.feeds.get(i) {
                        entry.present = false
                    }
                    i += 1
                }
                false
            },
        }
    }

    pub fn record_frame(
        mut self,
        is_tx: bool,
        peer: MemSpan,
        data: MemSpan,
        ts_ms: u64,
        format_sse: bool,
    ) -> MemBuffer {
        if data.len() == QUOTE_FRAME_LEN && data.byte_at(0) == MSG_TYPE_QUOTE {
            if is_tx {
                self.quotes_tx += 1
            } else {
                self.quotes_rx += 1
            }
        } else if data.len() == SIG_FRAME_LEN && data.byte_at(0) == MSG_TYPE_SIG {
            if is_tx {
                self.sigs_tx += 1
            } else {
                self.sigs_rx += 1
            }
        }
        self.frame_seq += 1
        let seq = self.frame_seq
        var hex_buf = MemBuffer::with_capacity(data.len() * 2)
        push_hex_bytes(mut hex_buf, data)

        var sse_ev = MemBuffer::empty()
        if format_sse {
            sse_ev = MemBuffer::with_capacity(320)
            write!(
                mut sse_ev,
                "{\"event\":\"frame\",\"node_id\":",
                self.node_id,
                ",\"seq\":",
                seq,
                ",\"ts_ms\":",
                ts_ms,
                ",\"dir\":",
            )
            if is_tx {
                sse_ev.extend_from("\"tx\"".span())
            } else {
                sse_ev.extend_from("\"rx\"".span())
            }
            sse_ev.extend_from(",\"peer\":".span())
            push_json_escaped(mut sse_ev, peer)
            sse_ev.extend_from(",\"hex\":".span())
            push_json_escaped(mut sse_ev, hex_buf.span())
            sse_ev.push(b'}')
        }

        // Fixed-capacity circular buffer avoids O(N) front removal on every frame.
        if self.recent_frames.len() < MAX_RECENT_FRAMES {
            self.recent_frames
                .push(
                    TelemetryFrame {
                        seq,
                        ts_ms,
                        is_tx,
                        peer: MemBuffer::from_span(peer),
                        hex: hex_buf,
                    },
                )
        } else {
            if let Option::Some(mut slot) = self.recent_frames.get(self.frames_head) {
                slot.seq = seq
                slot.ts_ms = ts_ms
                slot.is_tx = is_tx
                slot.peer.clear()
                slot.peer.extend_from(peer)
                slot.hex = hex_buf
            }
            self.frames_head = (self.frames_head + 1) % MAX_RECENT_FRAMES
        }
        sse_ev
    }

    fn append_status_fields(self, _ out: mut MemBuffer, include_frames: bool) {
        write!(mut out, "\"node_id\":", self.node_id, ",\"peer_id\":")
        push_json_escaped(mut out, self.peer_id.span())
        write!(
            mut out,
            ",\"p2p_port\":",
            self.p2p_port,
            ",\"peer_count\":",
            self.peer_count,
            ",\"peers\":[",
        )
        var first_peer = true
        for part in self.peers_csv.span().split(b',') {
            let p = part.trim()
            if p.is_empty() { continue }
            if !first_peer {
                out.push(b',')
            }
            first_peer = false
            push_json_escaped(mut out, p)
        }
        write!(mut out, "],\"round_id\":", self.round_id, ",\"phase\":")
        push_json_escaped(mut out, self.phase.span())
        write!(
            mut out,
            ",\"local_price\":",
            self.local_prices[0],
            ",\"group_median\":",
            self.group_medians[0],
            ",\"local_prices\":",
        )
        push_u64_array_json(mut out, self.local_prices)
        out.extend_from(",\"group_medians\":".span())
        push_u64_array_json(mut out, self.group_medians)
        write!(
            mut out,
            ",\"round_ts\":",
            self.round_ts,
            ",\"counters\":{\"quotes_tx\":",
            self.quotes_tx,
            ",\"quotes_rx\":",
            self.quotes_rx,
            ",\"sigs_tx\":",
            self.sigs_tx,
            ",\"sigs_rx\":",
            self.sigs_rx,
            ",\"tolerance_breaches\":",
            self.tolerance_breaches,
            ",\"submissions_ok\":",
            self.submissions_ok,
            ",\"submissions_err\":",
            self.submissions_err,
            ",\"last_submit_ms\":",
            self.last_submit_ms,
            "},\"feeds\":[",
        )

        var first_feed = true
        var fi: usize = 0
        while fi < MAX_FEED_SLOTS {
            let f = ref self.feeds[fi]
            if f.present {
                if !first_feed {
                    out.push(b',')
                }
                first_feed = false
                out.extend_from("{\"provider\":".span())
                push_json_escaped(mut out, f.provider.span())
                out.extend_from(",\"addr\":".span())
                push_json_escaped(mut out, f.addr.span())
                write!(
                    mut out,
                    ",\"price\":",
                    f.price,
                    ",\"assets_ok\":",
                    f.assets_ok,
                    ",\"ok\":",
                    if f.ok { "true" } else { "false" },
                    ",\"latency_ms\":",
                    f.latency_ms,
                    "}",
                )
            }
            fi += 1
        }
        out.push(b']')
        if !include_frames { return }
        out.extend_from(",\"recent_frames\":[".span())

        let n_frames = self.recent_frames.len()
        let start = if n_frames == MAX_RECENT_FRAMES {
            self.frames_head
        } else {
            0
        }
        var k: usize = 0
        while k < n_frames {
            if k > 0 { out.push(b',') }
            let idx = (start + k) % MAX_RECENT_FRAMES
            let fr = ref self.recent_frames[idx]
            write!(
                mut out,
                "{\"seq\":",
                fr.seq,
                ",\"ts_ms\":",
                fr.ts_ms,
                ",\"dir\":",
            )
            if fr.is_tx {
                out.extend_from("\"tx\"".span())
            } else {
                out.extend_from("\"rx\"".span())
            }
            out.extend_from(",\"peer\":".span())
            push_json_escaped(mut out, fr.peer.span())
            out.extend_from(",\"hex\":".span())
            push_json_escaped(mut out, fr.hex.span())
            out.push(b'}')
            k += 1
        }
        out.push(b']')
    }

    pub fn encode_status_json(self) -> MemBuffer {
        var out = MemBuffer::with_capacity(1024)
        out.push(b'{')
        self.append_status_fields(mut out, include_frames: true)
        out.push(b'}')
        out
    }

    pub fn encode_status_event_json(self, include_frames: bool) -> MemBuffer {
        var out = MemBuffer::with_capacity(1040)
        out.extend_from("{\"event\":\"status\",".span())
        self.append_status_fields(mut out, include_frames)
        out.push(b'}')
        out
    }
}

pub struct TelemetryServer { state: TelemetryState, server: HttpServer, events: MemVec<HttpEvent> }

impl TelemetryServer {
    pub fn start(
        node_id: u64,
        peer_id: own MemBuffer,
        p2p_port: u16,
        telemetry_port: u16,
    ) -> Result<MemBuffer, Self>
    uses (net: mut Net, sched: mut Scheduler, io: mut SocketIo)
    {
        let owner = sched.alloc_task()
        let bind_addr = SocketAddr::new(IpAddr::V4(Ipv4Addr::LOCALHOST), telemetry_port)
        let server = match HttpServer::bind(bind_addr, owner) {
            Result::Ok(s) => s,
            Result::Err(err) => {
                return Result::Err(format!("telemetry bind failed: ", err.kind()))
            },
        }
        Result::Ok(
            TelemetryServer {
                state: TelemetryState::new(node_id, peer_id, p2p_port),
                server,
                events: MemVec::new(),
            },
        )
    }

    pub fn has_pending_writes(self) -> bool {
        self.server.has_pending_writes()
    }

    pub fn poll(mut self) uses (sched: mut Scheduler, io: mut SocketIo) {
        self.server.poll_io(mut self.events)
        var i: usize = 0
        while i < self.events.len() {
            match self.events[i] {
                HttpEvent::Request(ref req) => {
                    if req.method == "OPTIONS" {
                        self.server
                            .respond_empty(
                                req.token,
                                status_line: "204 No Content".span(),
                                extra_headers: "Access-Control-Allow-Origin: *\r\nAccess-Control-Allow-Methods: GET, OPTIONS\r\n"
                                    .span(),
                            )
                    } else if req.method == "GET" && req.path == "/status" {
                        let body = self.state.encode_status_json()
                        self.server
                            .respond(
                                req.token,
                                status_line: "200 OK".span(),
                                content_type: "application/json".span(),
                                extra_headers: "Access-Control-Allow-Origin: *\r\nCache-Control: no-store\r\n"
                                    .span(),
                                body: body.span(),
                            )
                    } else if req.method == "GET" && req.path == "/events" {
                        let ev = self.state.encode_status_event_json(include_frames: true)
                        self.server
                            .upgrade_sse(
                                req.token,
                                extra_headers: "Access-Control-Allow-Origin: *\r\n".span(),
                                initial_data: ev.span(),
                            )
                    } else {
                        self.server
                            .respond(
                                req.token,
                                status_line: "404 Not Found".span(),
                                content_type: "text/plain".span(),
                                extra_headers: "Access-Control-Allow-Origin: *\r\nCache-Control: no-store\r\n"
                                    .span(),
                                body: "Not Found".span(),
                            )
                    }
                },
                HttpEvent::SseWritableAfterLag(token) => {
                    let ev = self.state.encode_status_event_json(include_frames: true)
                    self.server.send_sse_data(token, data: ev.span())
                },
            }
            i += 1
        }
    }

    fn broadcast_status_if_watched(mut self)
    uses (sched: mut Scheduler, io: mut SocketIo)
    {
        if self.server.has_sse_clients() {
            let ev = self.state.encode_status_event_json(include_frames: false)
            self.server.broadcast_sse_data(ev.span())
        }
    }

    pub fn update_peers(mut self, peer_count: usize, peers_csv: MemSpan)
    uses (sched: mut Scheduler, io: mut SocketIo)
    {
        if self.state.update_peers(peer_count, peers_csv) {
            self.broadcast_status_if_watched()
        }
    }

    pub fn set_phase(
        mut self,
        round_id: u64,
        phase: MemSpan,
        local_prices: [u64; 20],
        group_medians: [u64; 20],
        round_ts: u64,
    )
    uses (sched: mut Scheduler, io: mut SocketIo)
    {
        self.state.set_phase(round_id, phase, local_prices, group_medians, round_ts)
        self.broadcast_status_if_watched()
    }

    pub fn set_feed(
        mut self,
        slot: u32,
        provider: MemSpan,
        addr: MemSpan,
        price: u64,
        assets_ok: u32,
        ok: bool,
        latency_ms: u64,
    ) {
        self.state.set_feed(slot, provider, addr, price, assets_ok, ok, latency_ms)
    }

    pub fn record_event(mut self, _ ev: TelemetryEvent)
    uses (sched: mut Scheduler, io: mut SocketIo)
    {
        if self.state.record_event(ev) {
            self.broadcast_status_if_watched()
        }
    }

    pub fn record_frame(mut self, is_tx: bool, peer: MemSpan, data: MemSpan)
    uses (clock: Clock, sched: mut Scheduler, io: mut SocketIo)
    {
        let format_sse = self.server.has_sse_clients()
        let ts_ms = clock.now().as_millis()
        let ev = self.state.record_frame(is_tx, peer, data, ts_ms, format_sse)
        if format_sse && !ev.is_empty() {
            self.server.broadcast_sse_data(ev.span())
        }
    }

    pub fn stop(mut self) uses (sched: mut Scheduler, io: mut SocketIo) {
        self.server.stop()
    }
}

pub enum TelemetrySink {
    Disabled,
    Local(TelemetryServer),
}

impl TelemetrySink {
    pub fn is_enabled(self) -> bool {
        match self {
            TelemetrySink::Local(_) => true,
            TelemetrySink::Disabled => false,
        }
    }

    pub fn has_pending_writes(self) -> bool {
        match self {
            TelemetrySink::Local(ref s) => s.has_pending_writes(),
            TelemetrySink::Disabled => false,
        }
    }

    pub fn poll(mut self) uses (sched: mut Scheduler, io: mut SocketIo) {
        match self {
            TelemetrySink::Local(mut s) => s.poll(),
            TelemetrySink::Disabled => {},
        }
    }

    pub fn update_peers(mut self, peer_count: usize, peers_csv: MemSpan)
    uses (sched: mut Scheduler, io: mut SocketIo)
    {
        match self {
            TelemetrySink::Local(mut s) => s.update_peers(peer_count, peers_csv),
            TelemetrySink::Disabled => {},
        }
    }

    pub fn set_phase(
        mut self,
        round_id: u64,
        phase: MemSpan,
        local_prices: [u64; 20],
        group_medians: [u64; 20],
        round_ts: u64,
    )
    uses (sched: mut Scheduler, io: mut SocketIo)
    {
        match self {
            TelemetrySink::Local(mut s) => s.set_phase(
                round_id,
                phase,
                local_prices,
                group_medians,
                round_ts,
            ),
            TelemetrySink::Disabled => {},
        }
    }

    pub fn set_feed(
        mut self,
        slot: u32,
        provider: MemSpan,
        addr: MemSpan,
        price: u64,
        assets_ok: u32,
        ok: bool,
        latency_ms: u64,
    ) {
        match self {
            TelemetrySink::Local(mut s) => {
                s.set_feed(slot, provider, addr, price, assets_ok, ok, latency_ms)
            },
            TelemetrySink::Disabled => {},
        }
    }

    pub fn record_event(mut self, _ ev: TelemetryEvent)
    uses (sched: mut Scheduler, io: mut SocketIo)
    {
        match self {
            TelemetrySink::Local(mut s) => s.record_event(ev),
            TelemetrySink::Disabled => {},
        }
    }

    pub fn record_frame(mut self, is_tx: bool, peer: MemSpan, data: MemSpan)
    uses (clock: Clock, sched: mut Scheduler, io: mut SocketIo)
    {
        match self {
            TelemetrySink::Local(mut s) => s.record_frame(is_tx, peer, data),
            TelemetrySink::Disabled => {},
        }
    }

    pub fn stop(mut self) uses (sched: mut Scheduler, io: mut SocketIo) {
        match self {
            TelemetrySink::Local(mut s) => s.stop(),
            TelemetrySink::Disabled => {},
        }
    }
}
