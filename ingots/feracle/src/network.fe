use std::net::{IpAddr, Ipv4Addr, Net, SocketAddr}
use std::time::Clock
use coro::Scheduler
use net_reactor::SocketIo
use p2p::{Delivery, GossipConfig, P2pEngine, format_peer_tag, make_ephemeral_tag, parse_seeds}
use p2p_libp2p::{Libp2pConfig, Libp2pTransport}
use p2p_tcp::{TcpConfig, TcpEngine}
use p2p_udp::{UdpConfig, UdpEngine}
use super::args::PeerBackend
use super::config::NodeConfig
use super::telemetry::TelemetrySink

enum EngineInner {
    Libp2p(Libp2pTransport),
    Tcp(TcpEngine),
    Udp(UdpEngine),
}

pub struct PeerSession {
    inner: EngineInner,
    prefix: MemBuffer,
    peer_id: MemBuffer,
    last_peers_ver: u64,
    peers_synced: bool,
}

fn oracle_gossip_config() -> GossipConfig {
    var cfg = GossipConfig::default()
    cfg.heartbeat_ms = 1500
    cfg.suspect_ms = 8000
    cfg.dead_ms = 15000
    cfg.reconnect_base_ms = 200
    cfg.reconnect_max_ms = 2000
    cfg
}

pub fn backend_label(_ backend: PeerBackend) -> MemBuffer {
    match backend {
        PeerBackend::Libp2p => format!("libp2p"),
        PeerBackend::Tcp => format!("fe-tcp"),
        PeerBackend::Udp => format!("fe-udp"),
    }
}

fn engine_publish<P: P2pEngine>(_ e: mut P, _ data: MemSpan) -> bool
uses P::E
{
    e.publish(data)
}

fn engine_poll_io<P: P2pEngine>(_ e: mut P) -> usize uses P::E {
    e.poll_io()
}

fn engine_recv<P: P2pEngine>(_ e: mut P, _ out: mut MemBuffer, _ peer_out: mut MemBuffer) -> Option<
    Delivery,
> {
    e.recv_with_peer(mut out, mut peer_out)
}

fn engine_snapshot_peers<P: P2pEngine>(
    _ e: P,
    prefix: MemSpan,
    last_ver: u64,
    synced: bool,
    _ csv_out: mut MemBuffer,
) -> Option<(u64, usize)> {
    e.snapshot_peers(prefix, last_ver, synced, mut csv_out)
}

fn engine_local_peer_id<P: P2pEngine>(_ e: P, prefix: MemSpan, _ out: mut MemBuffer) {
    e.write_local_peer_id(prefix: prefix, mut out)
}

fn engine_peer_count<P: P2pEngine>(_ e: P) -> usize {
    e.peer_count()
}

fn engine_needs_periodic_poll<P: P2pEngine>(_ e: P) -> bool {
    e.needs_periodic_poll()
}

fn engine_stop<P: P2pEngine>(_ e: mut P) uses P::E {
    e.stop()
}

impl PeerSession {
    pub fn backend_label(_ backend: PeerBackend) -> MemBuffer {
        super::network::backend_label(backend)
    }

    pub fn start(config: NodeConfig) -> Result<MemBuffer, Self>
    uses (net: mut Net, clock: Clock, sched: mut Scheduler, io: mut SocketIo)
    {
        let self_tag = make_ephemeral_tag(node_id: config.node_id, listen_port: config.p2p_port)
        let prefix = backend_label(config.p2p_backend)
        var peer_id = MemBuffer::empty()

        let inner = match config.p2p_backend {
            PeerBackend::Libp2p => {
                let owner = sched.alloc_task()
                match Libp2pTransport::bind_reactor(
                    Libp2pConfig {
                        listen_port: config.p2p_port,
                        self_tag,
                        bootstrap: MemBuffer::from_span(config.bootstrap.span()),
                    },
                    owner,
                ) {
                    Result::Ok(l) => {
                        engine_local_peer_id(l, prefix: prefix.span(), mut peer_id)
                        EngineInner::Libp2p(l)
                    },
                    Result::Err(rc) => {
                        return Result::Err(format!("p2p_start failed with code ", rc))
                    },
                }
            },
            PeerBackend::Tcp => {
                var seeds = MemVec<SocketAddr>::new()
                if !parse_seeds(config.bootstrap.span(), mut seeds) {
                    return Result::Err(format!("invalid bootstrap seed address"))
                }
                let bind_addr = SocketAddr::new(IpAddr::V4(Ipv4Addr::UNSPECIFIED), config.p2p_port)
                let owner = sched.alloc_task()
                match TcpEngine::bind(
                    TcpConfig { bind_addr, self_tag, seeds, gossip: oracle_gossip_config() },
                    owner,
                ) {
                    Result::Ok(t) => {
                        engine_local_peer_id(t, prefix: prefix.span(), mut peer_id)
                        EngineInner::Tcp(t)
                    },
                    Result::Err(err) => {
                        return Result::Err(format!("tcp bind failed: ", err.kind()))
                    },
                }
            },
            PeerBackend::Udp => {
                var seeds = MemVec<SocketAddr>::new()
                if !parse_seeds(config.bootstrap.span(), mut seeds) {
                    return Result::Err(format!("invalid bootstrap seed address"))
                }
                let bind_addr = SocketAddr::new(IpAddr::V4(Ipv4Addr::UNSPECIFIED), config.p2p_port)
                let owner = sched.alloc_task()
                match UdpEngine::bind(
                    UdpConfig {
                        bind_addr,
                        self_tag,
                        seeds,
                        gossip: oracle_gossip_config(),
                        lan_broadcast_port: config.lan_discovery_port,
                    },
                    owner,
                ) {
                    Result::Ok(u) => {
                        engine_local_peer_id(u, prefix: prefix.span(), mut peer_id)
                        EngineInner::Udp(u)
                    },
                    Result::Err(err) => {
                        return Result::Err(format!("udp bind failed: ", err.kind()))
                    },
                }
            },
        }

        Result::Ok(
            PeerSession { inner, prefix, peer_id, last_peers_ver: 0, peers_synced: false },
        )
    }

    pub fn self_peer_id(self) -> MemBuffer {
        MemBuffer::from_span(self.peer_id.span())
    }

    pub fn needs_periodic_poll(self) -> bool {
        match self.inner {
            EngineInner::Libp2p(ref l) => engine_needs_periodic_poll(l),
            EngineInner::Tcp(ref t) => engine_needs_periodic_poll(t),
            EngineInner::Udp(ref u) => engine_needs_periodic_poll(u),
        }
    }

    pub fn publish(mut self, _ data: MemSpan, _ telemetry: mut TelemetrySink) -> bool
    uses (net: mut Net, clock: Clock, sched: mut Scheduler, io: mut SocketIo)
    {
        let ok = match self.inner {
            EngineInner::Libp2p(mut l) => engine_publish(mut l, data),
            EngineInner::Tcp(mut t) => engine_publish(mut t, data),
            EngineInner::Udp(mut u) => engine_publish(mut u, data),
        }
        telemetry.record_frame(is_tx: true, peer: "local".span(), data)
        ok
    }

    pub fn poll_driver(mut self, _ telemetry: mut TelemetrySink)
    uses (net: mut Net, sched: mut Scheduler, io: mut SocketIo)
    {
        let _ = match self.inner {
            EngineInner::Libp2p(mut l) => engine_poll_io(mut l),
            EngineInner::Tcp(mut t) => engine_poll_io(mut t),
            EngineInner::Udp(mut u) => engine_poll_io(mut u),
        }
        if !telemetry.is_enabled() {
            return
        }
        var csv = MemBuffer::empty()
        let snap = match self.inner {
            EngineInner::Libp2p(ref l) => engine_snapshot_peers(
                l,
                prefix: self.prefix.span(),
                last_ver: self.last_peers_ver,
                synced: self.peers_synced,
                mut csv,
            ),
            EngineInner::Tcp(ref t) => engine_snapshot_peers(
                t,
                prefix: self.prefix.span(),
                last_ver: self.last_peers_ver,
                synced: self.peers_synced,
                mut csv,
            ),
            EngineInner::Udp(ref u) => engine_snapshot_peers(
                u,
                prefix: self.prefix.span(),
                last_ver: self.last_peers_ver,
                synced: self.peers_synced,
                mut csv,
            ),
        }
        if let Option::Some((ver, count)) = snap {
            self.last_peers_ver = ver
            self.peers_synced = true
            telemetry.update_peers(peer_count: count, peers_csv: csv.span())
        }
    }

    pub fn poll_into(mut self, _ out: mut MemBuffer, _ telemetry: mut TelemetrySink) -> Option<u64>
    uses (clock: Clock, sched: mut Scheduler, io: mut SocketIo)
    {
        var peer_tag = MemBuffer::empty()
        let delivery_opt = match self.inner {
            EngineInner::Libp2p(mut l) => engine_recv(mut l, mut out, mut peer_tag),
            EngineInner::Tcp(mut t) => engine_recv(mut t, mut out, mut peer_tag),
            EngineInner::Udp(mut u) => engine_recv(mut u, mut out, mut peer_tag),
        }
        match delivery_opt {
            Option::Some(d) => {
                if peer_tag.is_empty() {
                    format_peer_tag(d.origin, prefix: self.prefix.span(), mut peer_tag)
                }
                telemetry.record_frame(is_tx: false, peer: peer_tag.span(), data: out.span())
                Option::Some(d.origin)
            },
            Option::None => Option::None,
        }
    }

    pub fn peer_count(self) -> usize {
        match self.inner {
            EngineInner::Libp2p(ref l) => engine_peer_count(l),
            EngineInner::Tcp(ref t) => engine_peer_count(t),
            EngineInner::Udp(ref u) => engine_peer_count(u),
        }
    }

    pub fn stop(mut self) uses (net: mut Net, sched: mut Scheduler, io: mut SocketIo) {
        match self.inner {
            EngineInner::Libp2p(mut l) => engine_stop(mut l),
            EngineInner::Tcp(mut t) => engine_stop(mut t),
            EngineInner::Udp(mut u) => engine_stop(mut u),
        }
    }
}
