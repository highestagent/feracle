//! Unified oracle networking session over `p2p_libp2p`, `p2p_tcp`, or `p2p_udp`.

use std::net::{IpAddr, Ipv4Addr, Net, SocketAddr}
use std::time::Clock
use p2p::{
    Delivery,
    GossipConfig,
    PeerEntry,
    Transport,
    format_peer_tag,
    format_peers_csv,
    make_ephemeral_tag,
    parse_seeds,
}
use p2p_libp2p::{Libp2pConfig, Libp2pTransport}
use p2p_tcp::{TcpConfig, TcpTransport}
use p2p_udp::{UdpConfig, UdpTransport}
use super::args::PeerBackend
use super::config::NodeConfig
use super::ffi

enum SessionInner {
    Libp2p(Libp2pTransport),
    Tcp(TcpTransport),
    Udp(UdpTransport),
}

pub struct PeerSession {
    inner: SessionInner,
    prefix: MemBuffer,
    external_telemetry: bool,
    last_peer_count: usize,
    last_peers_csv: MemBuffer,
}

fn oracle_gossip_config() -> GossipConfig {
    var cfg = GossipConfig::default()
    cfg.heartbeat_ms = 1500
    cfg.suspect_ms = 8000
    cfg.dead_ms = 15000
    cfg.reconnect_base_ms = 200
    cfg.reconnect_max_ms = 2000
    cfg
}

fn poll_and_entries<T: Transport>(_ t: mut T, timeout_ms: u64) -> MemVec<PeerEntry>
uses (net: mut Net, clock: Clock)
{
    let _ = t.poll(timeout_ms)
    t.peer_entries()
}

fn publish_via<T: Transport>(_ t: mut T, _ data: MemSpan) -> bool
uses (net: mut Net, clock: Clock)
{
    t.publish(data)
}

fn recv_via<T: Transport>(_ t: mut T, _ out: mut MemBuffer) -> Option<Delivery> {
    t.recv(mut out)
}

fn peer_count_via<T: Transport>(_ t: T) -> usize {
    t.peer_count()
}

impl PeerSession {
    pub fn backend_label(_ backend: PeerBackend) -> MemBuffer {
        match backend {
            PeerBackend::Libp2p => format!("libp2p"),
            PeerBackend::Tcp => format!("fe-tcp"),
            PeerBackend::Udp => format!("fe-udp"),
        }
    }

    pub fn start(config: NodeConfig) -> Result<MemBuffer, Self>
    uses (net: mut Net, clock: Clock)
    {
        let self_tag = make_ephemeral_tag(node_id: config.node_id, listen_port: config.p2p_port)
        let prefix = Self::backend_label(config.p2p_backend)

        let inner = match config.p2p_backend {
            PeerBackend::Libp2p => {
                match Libp2pTransport::bind(
                    Libp2pConfig {
                        listen_port: config.p2p_port,
                        self_tag,
                        bootstrap: MemBuffer::from_span(config.bootstrap.span()),
                        telemetry_port: config.telemetry_port,
                        telemetry_node_id: config.node_id,
                    },
                ) {
                    Result::Ok(l) => SessionInner::Libp2p(l),
                    Result::Err(rc) => {
                        return Result::Err(format!("p2p_start failed with code ", rc))
                    },
                }
            },
            PeerBackend::Tcp => {
                var seeds = MemVec<SocketAddr>::new()
                if !parse_seeds(config.bootstrap.span(), mut seeds) {
                    return Result::Err(format!("invalid bootstrap seed address"))
                }
                let bind_addr = SocketAddr::new(IpAddr::V4(Ipv4Addr::UNSPECIFIED), config.p2p_port)
                match TcpTransport::bind(
                    TcpConfig { bind_addr, self_tag, seeds, gossip: oracle_gossip_config() },
                ) {
                    Result::Ok(t) => SessionInner::Tcp(t),
                    Result::Err(err) => {
                        return Result::Err(format!("tcp bind failed: ", err.kind()))
                    },
                }
            },
            PeerBackend::Udp => {
                var seeds = MemVec<SocketAddr>::new()
                if !parse_seeds(config.bootstrap.span(), mut seeds) {
                    return Result::Err(format!("invalid bootstrap seed address"))
                }
                let bind_addr = SocketAddr::new(IpAddr::V4(Ipv4Addr::UNSPECIFIED), config.p2p_port)
                match UdpTransport::bind(
                    UdpConfig {
                        bind_addr,
                        self_tag,
                        seeds,
                        gossip: oracle_gossip_config(),
                        lan_broadcast_port: config.lan_discovery_port,
                    },
                ) {
                    Result::Ok(u) => SessionInner::Udp(u),
                    Result::Err(err) => {
                        return Result::Err(format!("udp bind failed: ", err.kind()))
                    },
                }
            },
        }

        let external_telemetry = config.telemetry_port > 0
            && match config.p2p_backend {
                PeerBackend::Libp2p => false,
                _ => true,
            }

        if external_telemetry {
            var peer_id = MemBuffer::empty()
            format_peer_tag(self_tag, prefix: prefix.span(), mut peer_id)
            let rc = ffi::start_telemetry_only(
                p2p_port: config.p2p_port,
                telemetry_port: config.telemetry_port,
                node_id: config.node_id,
                peer_id: peer_id.span(),
            )
            if rc != 0 {
                return Result::Err(format!("telemetry_start failed with code ", rc))
            }
        }

        Result::Ok(
            PeerSession {
                inner,
                prefix,
                external_telemetry,
                last_peer_count: 0,
                last_peers_csv: MemBuffer::empty(),
            },
        )
    }

    pub fn publish(mut self, _ data: MemSpan) -> bool
    uses (net: mut Net, clock: Clock)
    {
        let ok = match self.inner {
            SessionInner::Libp2p(mut l) => publish_via(mut l, data),
            SessionInner::Tcp(mut t) => publish_via(mut t, data),
            SessionInner::Udp(mut u) => publish_via(mut u, data),
        }
        if self.external_telemetry {
            ffi::record_telemetry_frame(is_tx: true, peer: "local".span(), data)
        }
        ok
    }

    pub fn step(mut self, timeout_ms: u64) uses (net: mut Net, clock: Clock) {
        let entries = match self.inner {
            SessionInner::Libp2p(mut l) => poll_and_entries(mut l, timeout_ms),
            SessionInner::Tcp(mut t) => poll_and_entries(mut t, timeout_ms),
            SessionInner::Udp(mut u) => poll_and_entries(mut u, timeout_ms),
        }
        if !self.external_telemetry {
            return
        }
        let count = entries.len()
        var csv = MemBuffer::empty()
        format_peers_csv(entries, prefix: self.prefix.span(), mut csv)
        if count != self.last_peer_count || csv != self.last_peers_csv {
            self.last_peer_count = count
            self.last_peers_csv = MemBuffer::from_span(csv.span())
            ffi::set_telemetry_peers(peer_count: count, peers_csv: csv.span())
        }
    }

    pub fn poll_into(mut self, _ out: mut MemBuffer) -> bool {
        let delivery_opt = match self.inner {
            SessionInner::Libp2p(mut l) => recv_via(mut l, mut out),
            SessionInner::Tcp(mut t) => recv_via(mut t, mut out),
            SessionInner::Udp(mut u) => recv_via(mut u, mut out),
        }
        match delivery_opt {
            Option::Some(d) => {
                if self.external_telemetry {
                    var peer_tag = MemBuffer::empty()
                    format_peer_tag(d.origin, prefix: self.prefix.span(), mut peer_tag)
                    ffi::record_telemetry_frame(
                        is_tx: false,
                        peer: peer_tag.span(),
                        data: out.span(),
                    )
                }
                true
            },
            Option::None => false,
        }
    }

    pub fn peer_count(self) -> usize {
        match self.inner {
            SessionInner::Libp2p(ref l) => peer_count_via(l),
            SessionInner::Tcp(ref t) => peer_count_via(t),
            SessionInner::Udp(ref u) => peer_count_via(u),
        }
    }

    pub fn stop(mut self) {
        match self.inner {
            SessionInner::Libp2p(mut l) => l.stop(),
            _ => {
                if self.external_telemetry {
                    ffi::stop_telemetry_only()
                }
            },
        }
    }
}
