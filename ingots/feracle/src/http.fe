//! Minimal HTTP/1.1 client over plain TCP for node RPC and price feeds.

use core::num::IntDowncast
use core::text::parse_uint
use std::io::{BufReader, Read, Write}
use std::net::{Net, SocketAddr, TcpStream}
use std::time::Duration
use feracle_core::{hex_nibble, to_ascii_lower}

const MAX_HEADER_LINE: usize = 65536
const MAX_HTTP_BODY: usize = 1_048_576

fn starts_with_ignore_ascii_case(_ span: MemSpan, _ prefix: MemSpan) -> bool {
    if span.len() < prefix.len() {
        return false
    }
    var i: usize = 0
    while i < prefix.len() {
        if to_ascii_lower(span.byte_at(i)) != to_ascii_lower(prefix.byte_at(i)) {
            return false
        }
        i += 1
    }
    true
}

fn contains_ignore_ascii_case(_ haystack: MemSpan, _ needle: MemSpan) -> bool {
    if needle.len() == 0 {
        return true
    }
    if haystack.len() < needle.len() {
        return false
    }
    var start: usize = 0
    let limit = haystack.len() - needle.len()
    while start <= limit {
        if starts_with_ignore_ascii_case(haystack.tail(start), needle) {
            return true
        }
        start += 1
    }
    false
}

fn decode_chunked(_ raw: MemSpan) -> Option<MemBuffer> {
    var out = MemBuffer::empty()
    var pos: usize = 0
    while pos < raw.len() {
        var line_end = pos
        while line_end < raw.len() && raw.byte_at(line_end) != b'\n' {
            line_end += 1
        }
        if line_end == raw.len() {
            return Option::None
        }
        var size_end = line_end
        if size_end > pos && raw.byte_at(size_end - 1) == b'\r' {
            size_end -= 1
        }
        var chunk_len: usize = 0
        var i = pos
        var saw_digit = false
        while i < size_end {
            let b = raw.byte_at(i)
            if b == b';' || b == b' ' {
                break
            }
            let d = hex_nibble(b)?
            let nibble: usize = d as usize
            saw_digit = true
            chunk_len = chunk_len * 16 + nibble
            i += 1
        }
        if !saw_digit {
            return Option::None
        }
        pos = line_end + 1
        if chunk_len == 0 {
            return Option::Some(out)
        }
        if pos + chunk_len > raw.len() {
            return Option::None
        }
        out.extend_from(raw.slice(offset: pos, len: chunk_len))
        pos += chunk_len
        if pos + 1 < raw.len() && raw.byte_at(pos) == b'\r' && raw.byte_at(pos + 1) == b'\n' {
            pos += 2
        } else if pos < raw.len() && raw.byte_at(pos) == b'\n' {
            pos += 1
        }
    }
    Option::Some(out)
}

pub fn http_request(addr: SocketAddr, request_bytes: MemSpan) -> Option<MemBuffer>
uses (net: mut Net)
{
    let stream_res = net.connect_timeout(addr, Duration::from_secs(5))
    var stream = match stream_res {
        Result::Ok(s) => s,
        Result::Err(_) => {
            return Option::None
        },
    }
    if stream.set_read_timeout(Option::Some(Duration::from_secs(5))).is_err() {
        return Option::None
    }
    if stream.set_write_timeout(Option::Some(Duration::from_secs(5))).is_err() {
        return Option::None
    }
    if stream.write_all(request_bytes).is_err() {
        return Option::None
    }

    var reader = BufReader::new(stream)
    var line = MemBuffer::empty()
    var first_line = true
    var content_len: Option<usize> = Option::None
    var is_chunked = false

    while true {
        line.clear()
        let has_line = match reader.read_line_max(mut line, max: MAX_HEADER_LINE) {
            Result::Ok(v) => v,
            Result::Err(_) => {
                return Option::None
            },
        }
        if !has_line {
            return Option::None
        }
        let trimmed = line.span().trim()
        if first_line {
            first_line = false
            // Require HTTP/1.x 2xx status
            if !trimmed.starts_with("HTTP/1.") {
                return Option::None
            }
            if !contains_ignore_ascii_case(trimmed, " 200 ".span()) && !trimmed.ends_with(" 200") {
                return Option::None
            }
            continue
        }
        if trimmed.is_empty() {
            break
        }
        let cl_prefix = "content-length:"
        if starts_with_ignore_ascii_case(trimmed, cl_prefix.span()) {
            let val_span = trimmed.tail(15).trim()
            match parse_uint(val_span) {
                Option::Some(n) => {
                    if let Option::Some(sz) = n.downcast() {
                        content_len = Option::Some(sz)
                    }
                },
                Option::None => {},
            }
        }
        let te_prefix = "transfer-encoding:"
        if starts_with_ignore_ascii_case(trimmed, te_prefix.span()) {
            if contains_ignore_ascii_case(trimmed.tail(18), "chunked".span()) {
                is_chunked = true
            }
        }
    }

    var body = MemBuffer::empty()
    match content_len {
        Option::Some(len) => {
            if len > MAX_HTTP_BODY {
                return Option::None
            }
            if len > 0 {
                var sized = MemBuffer::new(len)
                if reader.read_exact(mut sized.span()).is_err() {
                    return Option::None
                }
                return Option::Some(sized)
            }
            return Option::Some(body)
        },
        Option::None => {
            if reader.read_to_end(mut body).is_err() {
                return Option::None
            }
            if is_chunked {
                return decode_chunked(body.span())
            }
            Option::Some(body)
        },
    }
}
