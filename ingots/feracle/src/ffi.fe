extern {
    fn crypto_keccak_and_sign(
        _ privkey32_ptr: *u8,
        _ chain_id: u64,
        _ contract20_ptr: *u8,
        _ round_id: u64,
        _ prices_be160_ptr: *u8,
        _ timestamp: u64,
        _ out_addr20: *u8,
        _ out_v: *u8,
        _ out_r32: *u8,
        _ out_s32: *u8,
    ) -> i32
    fn crypto_keccak_and_sign_bytes(
        _ privkey32_ptr: *u8,
        _ data_ptr: *u8,
        _ data_len: usize,
        _ out_addr20: *u8,
        _ out_rec_id: *u8,
        _ out_r32: *u8,
        _ out_s32: *u8,
    ) -> i32
    fn crypto_derive_eth_addr(_ privkey32_ptr: *u8, _ out_addr20: *u8) -> i32
    fn crypto_verify_oracle_sig(
        _ chain_id: u64,
        _ contract20_ptr: *u8,
        _ round_id: u64,
        _ prices_be160_ptr: *u8,
        _ timestamp: u64,
        _ expected_addr20_ptr: *u8,
        _ v: u32,
        _ r32_ptr: *u8,
        _ s32_ptr: *u8,
    ) -> i32
}

pub fn sign_digest(
    privkey32: MemSpan,
    chain_id: u64,
    contract20: MemSpan,
    round_id: u64,
    prices: [u64; 20],
    timestamp: u64,
) -> Option<feracle_core::SigMsg> {
    if privkey32.len() != 32 || contract20.len() != 20 {
        return Option::None
    }
    let prices_buf = feracle_core::encode_prices_be160(prices)
    var addr_buf = MemBuffer::new(20)
    var v_buf = MemBuffer::new(1)
    var r_buf = MemBuffer::new(32)
    var s_buf = MemBuffer::new(32)

    let rc = unsafe {
        crypto_keccak_and_sign(
            privkey32.ptr(),
            chain_id,
            contract20.ptr(),
            round_id,
            prices_buf.ptr(),
            timestamp,
            addr_buf.ptr(),
            v_buf.ptr(),
            r_buf.ptr(),
            s_buf.ptr(),
        )
    }
    if rc != 0 {
        return Option::None
    }

    var signer_addr: [u8; 20] = [0; 20]
    var i: usize = 0
    while i < 20 {
        signer_addr[i] = addr_buf[i]
        i += 1
    }

    var r: [u8; 32] = [0; 32]
    var s: [u8; 32] = [0; 32]
    var j: usize = 0
    while j < 32 {
        r[j] = r_buf[j]
        s[j] = s_buf[j]
        j += 1
    }

    Option::Some(
        feracle_core::SigMsg {
            round_id,
            timestamp,
            median_prices: prices,
            signer_addr,
            v: v_buf[0],
            r,
            s,
        },
    )
}

pub fn sign_raw_bytes(privkey32: MemSpan, data: MemSpan) -> Option<
    ([u8; 20], u8, [u8; 32], [u8; 32]),
> {
    if privkey32.len() != 32 {
        return Option::None
    }
    var addr_buf = MemBuffer::new(20)
    var rec_buf = MemBuffer::new(1)
    var r_buf = MemBuffer::new(32)
    var s_buf = MemBuffer::new(32)

    let rc = unsafe {
        crypto_keccak_and_sign_bytes(
            privkey32.ptr(),
            data.ptr(),
            data.len(),
            addr_buf.ptr(),
            rec_buf.ptr(),
            r_buf.ptr(),
            s_buf.ptr(),
        )
    }
    if rc != 0 {
        return Option::None
    }

    var addr: [u8; 20] = [0; 20]
    var i: usize = 0
    while i < 20 {
        addr[i] = addr_buf[i]
        i += 1
    }
    var r: [u8; 32] = [0; 32]
    var s: [u8; 32] = [0; 32]
    var j: usize = 0
    while j < 32 {
        r[j] = r_buf[j]
        s[j] = s_buf[j]
        j += 1
    }
    let rec_id = rec_buf[0]
    Option::Some((addr, rec_id, r, s))
}

pub fn derive_eth_addr(privkey32: MemSpan) -> Option<[u8; 20]> {
    if privkey32.len() != 32 {
        return Option::None
    }
    var addr_buf = MemBuffer::new(20)
    let rc = unsafe {
        crypto_derive_eth_addr(privkey32.ptr(), addr_buf.ptr())
    }
    if rc != 0 {
        return Option::None
    }
    var addr: [u8; 20] = [0; 20]
    var i: usize = 0
    while i < 20 {
        addr[i] = addr_buf[i]
        i += 1
    }
    Option::Some(addr)
}

pub fn verify_sig(chain_id: u64, contract20: MemSpan, sig: feracle_core::SigMsg) -> bool {
    if contract20.len() != 20 {
        return false
    }
    let prices_buf = feracle_core::encode_prices_be160(sig.median_prices)
    var expected_buf = MemBuffer::new(20)
    var i: usize = 0
    while i < 20 {
        expected_buf[i] = sig.signer_addr[i]
        i += 1
    }
    var r_buf = MemBuffer::new(32)
    var s_buf = MemBuffer::new(32)
    var j: usize = 0
    while j < 32 {
        r_buf[j] = sig.r[j]
        s_buf[j] = sig.s[j]
        j += 1
    }
    let rc = unsafe {
        crypto_verify_oracle_sig(
            chain_id,
            contract20.ptr(),
            sig.round_id,
            prices_buf.ptr(),
            sig.timestamp,
            expected_buf.ptr(),
            sig.v as u32,
            r_buf.ptr(),
            s_buf.ptr(),
        )
    }
    rc == 1
}
