extern {
    fn crypto_keccak_and_sign(
        _ privkey32_ptr: *u8,
        _ chain_id: u64,
        _ contract20_ptr: *u8,
        _ round_id: u64,
        _ prices_be160_ptr: *u8,
        _ timestamp: u64,
        _ out_addr20: *u8,
        _ out_v: *u8,
        _ out_r32: *u8,
        _ out_s32: *u8,
    ) -> i32
    fn crypto_keccak_and_sign_bytes(
        _ privkey32_ptr: *u8,
        _ data_ptr: *u8,
        _ data_len: usize,
        _ out_addr20: *u8,
        _ out_rec_id: *u8,
        _ out_r32: *u8,
        _ out_s32: *u8,
    ) -> i32
    fn crypto_derive_eth_addr(_ privkey32_ptr: *u8, _ out_addr20: *u8) -> i32
    fn crypto_verify_oracle_sig(
        _ chain_id: u64,
        _ contract20_ptr: *u8,
        _ round_id: u64,
        _ prices_be160_ptr: *u8,
        _ timestamp: u64,
        _ expected_addr20_ptr: *u8,
        _ v: u32,
        _ r32_ptr: *u8,
        _ s32_ptr: *u8,
    ) -> i32
    fn crypto_verify_keccak_bytes_sig(
        _ data_ptr: *u8,
        _ data_len: usize,
        _ expected_addr20_ptr: *u8,
        _ v: u32,
        _ r32_ptr: *u8,
        _ s32_ptr: *u8,
    ) -> i32
}

fn read_addr20(_ buf: ref MemBuffer) -> [u8; 20] {
    var out: [u8; 20] = [0; 20]
    var i: usize = 0
    while i < 20 {
        out[i] = buf[i]
        i += 1
    }
    out
}

fn write_addr20(_ addr: [u8; 20]) -> MemBuffer {
    var buf = MemBuffer::new(20)
    var i: usize = 0
    while i < 20 {
        buf[i] = addr[i]
        i += 1
    }
    buf
}

fn read_word32(_ buf: ref MemBuffer) -> [u8; 32] {
    var out: [u8; 32] = [0; 32]
    var i: usize = 0
    while i < 32 {
        out[i] = buf[i]
        i += 1
    }
    out
}

fn write_word32(_ word: [u8; 32]) -> MemBuffer {
    var buf = MemBuffer::new(32)
    var i: usize = 0
    while i < 32 {
        buf[i] = word[i]
        i += 1
    }
    buf
}

pub fn sign_digest(
    privkey32: MemSpan,
    chain_id: u64,
    contract20: MemSpan,
    round_id: u64,
    prices: [u64; 20],
    timestamp: u64,
) -> Option<feracle_core::SigMsg> {
    if privkey32.len() != 32 || contract20.len() != 20 {
        return Option::None
    }
    let prices_buf = feracle_core::encode_prices_be160(prices)
    var addr_buf = MemBuffer::new(20)
    var v_buf = MemBuffer::new(1)
    var r_buf = MemBuffer::new(32)
    var s_buf = MemBuffer::new(32)

    let rc = unsafe {
        crypto_keccak_and_sign(
            privkey32.ptr(),
            chain_id,
            contract20.ptr(),
            round_id,
            prices_buf.ptr(),
            timestamp,
            addr_buf.ptr(),
            v_buf.ptr(),
            r_buf.ptr(),
            s_buf.ptr(),
        )
    }
    if rc != 0 {
        return Option::None
    }

    Option::Some(
        feracle_core::SigMsg {
            round_id,
            timestamp,
            median_prices: prices,
            signer_addr: read_addr20(ref addr_buf),
            v: v_buf[0],
            r: read_word32(ref r_buf),
            s: read_word32(ref s_buf),
        },
    )
}

pub fn sign_raw_bytes(privkey32: MemSpan, data: MemSpan) -> Option<
    ([u8; 20], u8, [u8; 32], [u8; 32]),
> {
    if privkey32.len() != 32 {
        return Option::None
    }
    var addr_buf = MemBuffer::new(20)
    var rec_buf = MemBuffer::new(1)
    var r_buf = MemBuffer::new(32)
    var s_buf = MemBuffer::new(32)

    let rc = unsafe {
        crypto_keccak_and_sign_bytes(
            privkey32.ptr(),
            data.ptr(),
            data.len(),
            addr_buf.ptr(),
            rec_buf.ptr(),
            r_buf.ptr(),
            s_buf.ptr(),
        )
    }
    if rc != 0 {
        return Option::None
    }

    let rec_id = rec_buf[0]
    Option::Some(
        (read_addr20(ref addr_buf), rec_id, read_word32(ref r_buf), read_word32(ref s_buf)),
    )
}

pub fn sign_quote(
    privkey32: MemSpan,
    chain_id: u64,
    contract20: MemSpan,
    round_id: u64,
    timestamp: u64,
    prices: [u64; 20],
) -> Option<feracle_core::QuoteMsg> {
    var preimage = MemBuffer::with_capacity(feracle_core::QUOTE_PREIMAGE_LEN)
    if !feracle_core::encode_quote_sign_preimage(
        chain_id,
        contract20,
        round_id,
        timestamp,
        prices,
        mut preimage,
    ) {
        return Option::None
    }
    let (addr, rec_id, r, s) = sign_raw_bytes(privkey32, data: preimage.span())?
    Option::Some(
        feracle_core::QuoteMsg {
            round_id,
            timestamp,
            prices,
            signer_addr: addr,
            v: 27 + (rec_id & 1),
            r,
            s,
        },
    )
}

pub fn derive_eth_addr(privkey32: MemSpan) -> Option<[u8; 20]> {
    if privkey32.len() != 32 {
        return Option::None
    }
    var addr_buf = MemBuffer::new(20)
    let rc = unsafe {
        crypto_derive_eth_addr(privkey32.ptr(), addr_buf.ptr())
    }
    if rc != 0 {
        return Option::None
    }
    Option::Some(read_addr20(ref addr_buf))
}

pub fn verify_sig(chain_id: u64, contract20: MemSpan, sig: feracle_core::SigMsg) -> bool {
    if contract20.len() != 20 {
        return false
    }
    let prices_buf = feracle_core::encode_prices_be160(sig.median_prices)
    let expected_buf = write_addr20(sig.signer_addr)
    let r_buf = write_word32(sig.r)
    let s_buf = write_word32(sig.s)
    let rc = unsafe {
        crypto_verify_oracle_sig(
            chain_id,
            contract20.ptr(),
            sig.round_id,
            prices_buf.ptr(),
            sig.timestamp,
            expected_buf.ptr(),
            sig.v as u32,
            r_buf.ptr(),
            s_buf.ptr(),
        )
    }
    rc == 1
}

pub fn verify_quote(chain_id: u64, contract20: MemSpan, quote: feracle_core::QuoteMsg) -> bool {
    var preimage = MemBuffer::with_capacity(feracle_core::QUOTE_PREIMAGE_LEN)
    if !feracle_core::encode_quote_sign_preimage(
        chain_id,
        contract20,
        round_id: quote.round_id,
        timestamp: quote.timestamp,
        prices: quote.prices,
        mut preimage,
    ) {
        return false
    }
    let expected_buf = write_addr20(quote.signer_addr)
    let r_buf = write_word32(quote.r)
    let s_buf = write_word32(quote.s)
    let rc = unsafe {
        crypto_verify_keccak_bytes_sig(
            preimage.ptr(),
            preimage.len(),
            expected_buf.ptr(),
            quote.v as u32,
            r_buf.ptr(),
            s_buf.ptr(),
        )
    }
    rc == 1
}
