use std::env::{Args, Env}
use std::io::{Stderr, Stdout}
use std::net::Net
use std::time::Clock
use cli::{Cli, Matches}
use coro::{Coroutine, LocalScheduler, Poll, Scheduler, Sleep, TaskId, block_on}
use net_reactor::{NetDriver, NetPoller, SocketIo}
use super::args::PeerBackend
use super::config::{build_cli, load_config}
use super::consensus::ConsensusCoro
use super::network::PeerSession
use super::telemetry::{TelemetryServer, TelemetrySink}

struct NodeCoro {
    peer: PeerSession,
    telemetry: TelemetrySink,
    consensus: ConsensusCoro,
    flush_owner: TaskId,
    flush_sleep: Option<Sleep>,
    exit_code: Option<i32>,
}

impl Coroutine for NodeCoro {
    type Output = i32
    uses E = (
        net: mut Net,
        clock: Clock,
        out: mut Stdout,
        err: mut Stderr,
        sched: mut Scheduler,
        io: mut SocketIo,
    )

    fn poll(mut self) -> Poll<i32> uses E {
        if let Option::Some(code) = self.exit_code {
            self.telemetry.poll()
            var flush_done = !self.telemetry.has_pending_writes()
            if !flush_done {
                if let Option::Some(mut s) = self.flush_sleep {
                    if let Poll::Ready(_) = s.poll() {
                        flush_done = true
                    }
                } else {
                    flush_done = true
                }
            }
            if flush_done {
                self.flush_sleep = Option::None
                self.telemetry.stop()
                self.peer.stop()
                return Poll::Ready(code)
            }
            return Poll::Pending
        }

        self.peer.poll_driver(mut self.telemetry)
        self.telemetry.poll()
        if let Poll::Ready(code) = self.consensus.poll(mut self.peer, mut self.telemetry) {
            self.telemetry.poll()
            if !self.telemetry.has_pending_writes() {
                self.telemetry.stop()
                self.peer.stop()
                return Poll::Ready(code)
            }
            self.flush_sleep = Option::Some(Sleep::after(owner: self.flush_owner, delay_ms: 50))
            self.exit_code = Option::Some(code)
            return Poll::Pending
        }
        self.telemetry.poll()
        Poll::Pending
    }

    fn cancel(mut self) uses E {
        self.consensus.cancel()
        if let Option::Some(mut s) = self.flush_sleep {
            s.cancel()
            self.flush_sleep = Option::None
        }
        self.telemetry.stop()
        self.peer.stop()
    }
}

pub fn run() -> i32
uses (args: Args, env: Env, out: mut Stdout, err: mut Stderr, net: mut Net, clock: Clock)
{
    build_cli()
        .run(
            |matches: Matches| -> i32 {
                let config = match (with (Cli = matches) {
                    load_config()
                }) {
                    Result::Ok(cfg) => cfg,
                    Result::Err(cli_err) => {
                        eprintln!(cli_err)
                        return cli_err.exit_code()
                    },
                }

                var sched = LocalScheduler::new(0)
                var io = match NetPoller::new() {
                    Result::Ok(p) => p,
                    Result::Err(err) => {
                        eprintln!("reactor init failed: ", err.kind())
                        return 1
                    },
                }

                with (Scheduler = sched, SocketIo = io) {
                    let label = PeerSession::backend_label(config.p2p_backend)
                    println!(
                        "node ",
                        config.node_id,
                        " starting ",
                        label,
                        " on port ",
                        config.p2p_port,
                    )
                    var peer = match PeerSession::start(config) {
                        Result::Ok(s) => s,
                        Result::Err(err_msg) => {
                            eprintln!(err_msg)
                            return 1
                        },
                    }

                    var telemetry = if config.telemetry_port == 0 {
                        TelemetrySink::Disabled
                    } else {
                        match config.p2p_backend {
                            PeerBackend::Libp2p => TelemetrySink::Libp2pFfi,
                            _ => {
                                match TelemetryServer::start(
                                    node_id: config.node_id,
                                    peer_id: peer.self_peer_id(),
                                    p2p_port: config.p2p_port,
                                    telemetry_port: config.telemetry_port,
                                ) {
                                    Result::Ok(srv) => TelemetrySink::Local(srv),
                                    Result::Err(err_msg) => {
                                        eprintln!(err_msg)
                                        peer.stop()
                                        return 1
                                    },
                                }
                            },
                        }
                    }
                    if config.telemetry_port > 0 {
                        println!(
                            "node ",
                            config.node_id,
                            " telemetry HTTP/SSE listening on 127.0.0.1:",
                            config.telemetry_port,
                        )
                    }

                    let flush_owner = sched.alloc_task()
                    let consensus = ConsensusCoro::new(config)
                    let max_wait: u64 = if peer.needs_periodic_poll() { 25 } else { 500 }
                    var driver = NetDriver::new(max_wait_ms: max_wait)
                    var node = NodeCoro {
                        peer,
                        telemetry,
                        consensus,
                        flush_owner,
                        flush_sleep: Option::None,
                        exit_code: Option::None,
                    }
                    block_on(mut node, mut driver)
                }
            },
        )
}
