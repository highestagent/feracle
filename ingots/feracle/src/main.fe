use std::env::{Args, Env}
use std::io::{Stderr, Stdout}
use std::net::{Interest, Net, Token}
use std::time::Clock
use cli::{Cli, Matches, ValueSource}
use coro::{Coroutine, LocalScheduler, Poll, Scheduler, Sleep, TaskId, block_on}
use net_reactor::{NetDriver, NetPoller, SocketIo}
use super::config::{build_cli, load_config}
use super::consensus::ConsensusCoro
use super::crypto::{Crypto, NativeCrypto}
use super::ffi
use super::network::PeerSession
use super::telemetry::{TelemetryServer, TelemetrySink}

struct NodeCoro {
    node_id: u64,
    peer: PeerSession,
    telemetry: TelemetrySink,
    consensus: ConsensusCoro,
    flush_owner: TaskId,
    flush_sleep: Option<Sleep>,
    sig_token: Option<Token>,
    exit_code: Option<i32>,
}

impl NodeCoro {
    fn release_io(mut self)
    uses (net: mut Net, sched: mut Scheduler, io: mut SocketIo)
    {
        if let Option::Some(tok) = self.sig_token {
            self.sig_token = Option::None
            io.deregister(tok)
        }
        self.telemetry.stop()
        self.peer.stop()
    }
}

impl Coroutine for NodeCoro {
    type Output = i32
    uses E = (
        net: mut Net,
        clock: Clock,
        crypto: Crypto,
        out: mut Stdout,
        err: mut Stderr,
        sched: mut Scheduler,
        io: mut SocketIo,
    )

    fn poll(mut self) -> Poll<i32> uses E {
        if let Option::Some(tok) = self.sig_token {
            if io.take_token_event(tok).is_some() {
                ffi::drain_signal_wake()
            }
        }
        if self.exit_code.is_none() && ffi::shutdown_requested() {
            eprintln!(
                "node ",
                self.node_id,
                " received shutdown signal; stopping cleanly",
            )
            self.consensus.cancel()
            if !self.telemetry.has_pending_writes() {
                self.release_io()
                return Poll::Ready(0)
            }
            self.flush_sleep = Option::Some(Sleep::after(owner: self.flush_owner, delay_ms: 50))
            self.exit_code = Option::Some(0)
            return Poll::Pending
        }

        if let Option::Some(code) = self.exit_code {
            self.telemetry.poll()
            var flush_done = !self.telemetry.has_pending_writes()
            if !flush_done {
                if let Option::Some(mut s) = self.flush_sleep {
                    if let Poll::Ready(_) = s.poll() {
                        flush_done = true
                    }
                } else {
                    flush_done = true
                }
            }
            if flush_done {
                self.flush_sleep = Option::None
                self.release_io()
                return Poll::Ready(code)
            }
            return Poll::Pending
        }

        self.peer.poll_driver(mut self.telemetry)
        let cons_poll = self.consensus.poll(mut self.peer, mut self.telemetry)
        self.telemetry.poll()
        if let Poll::Ready(code) = cons_poll {
            if !self.telemetry.has_pending_writes() {
                self.release_io()
                return Poll::Ready(code)
            }
            self.flush_sleep = Option::Some(Sleep::after(owner: self.flush_owner, delay_ms: 50))
            self.exit_code = Option::Some(code)
            return Poll::Pending
        }
        Poll::Pending
    }

    fn cancel(mut self) uses E {
        self.consensus.cancel()
        if let Option::Some(mut s) = self.flush_sleep {
            s.cancel()
            self.flush_sleep = Option::None
        }
        self.release_io()
    }
}

pub fn run() -> i32
uses (args: Args, env: Env, out: mut Stdout, err: mut Stderr, net: mut Net, clock: Clock)
{
    build_cli()
        .run(
            |matches: Matches| -> i32 {
                let native_crypto = NativeCrypto {}
                let config = match (with (Cli = matches, Crypto = native_crypto) {
                    load_config()
                }) {
                    Result::Ok(cfg) => cfg,
                    Result::Err(cli_err) => {
                        eprintln!(cli_err)
                        return cli_err.exit_code()
                    },
                }

                if let Option::Some(ValueSource::CommandLine) = matches
                    .value_source("privkey-hex") {
                    eprintln!(
                        "warning: passing --privkey-hex on the command line may expose your key; prefer FERACLE_PRIVKEY_HEX env var",
                    )
                }

                var sched = LocalScheduler::new(0)
                var io = match NetPoller::new() {
                    Result::Ok(p) => p,
                    Result::Err(err) => {
                        eprintln!("reactor init failed: ", err.kind())
                        return 1
                    },
                }

                with (Scheduler = sched, SocketIo = io, Crypto = native_crypto) {
                    let label = PeerSession::backend_label(config.p2p_backend)
                    println!(
                        "node ",
                        config.node_id,
                        " starting ",
                        label,
                        " on port ",
                        config.p2p_port,
                    )
                    var peer = match PeerSession::start(config) {
                        Result::Ok(s) => s,
                        Result::Err(err_msg) => {
                            eprintln!(err_msg)
                            return 1
                        },
                    }

                    var telemetry = if config.telemetry_port == 0 {
                        TelemetrySink::Disabled
                    } else {
                        match TelemetryServer::start(
                            node_id: config.node_id,
                            peer_id: peer.self_peer_id(),
                            p2p_port: config.p2p_port,
                            telemetry_port: config.telemetry_port,
                        ) {
                            Result::Ok(srv) => TelemetrySink::Local(srv),
                            Result::Err(err_msg) => {
                                eprintln!(err_msg)
                                peer.stop()
                                return 1
                            },
                        }
                    }
                    if config.telemetry_port > 0 {
                        println!(
                            "node ",
                            config.node_id,
                            " telemetry HTTP/SSE listening on 127.0.0.1:",
                            config.telemetry_port,
                        )
                    }

                    let flush_owner = sched.alloc_task()
                    var sig_token: Option<Token> = Option::None
                    let sig_fd = ffi::install_signal_handlers()
                    if sig_fd >= 0 {
                        if let Result::Ok(tok) = io.register_raw_fd(
                            owner: flush_owner,
                            tag: 99,
                            fd: sig_fd,
                            Interest::READABLE,
                        ) {
                            sig_token = Option::Some(tok)
                        }
                    }
                    let node_id = config.node_id
                    let consensus = ConsensusCoro::new(config)
                    let max_wait: u64 = if peer.needs_periodic_poll() { 25 } else { 500 }
                    var driver = NetDriver::new(max_wait_ms: max_wait)
                    var node = NodeCoro {
                        node_id,
                        peer,
                        telemetry,
                        consensus,
                        flush_owner,
                        flush_sleep: Option::None,
                        sig_token,
                        exit_code: Option::None,
                    }
                    block_on(mut node, mut driver)
                }
            },
        )
}
