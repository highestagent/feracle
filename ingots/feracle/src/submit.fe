use std::net::{Net, SocketAddr}
use coro::{Coroutine, Poll, Scheduler, Sleep, TaskId, Timeout}
use feracle_core::{
    compute_eip1559_fees,
    json_get_raw,
    json_get_str_bounds,
    parse_fee_history_result,
    parse_hex_u128,
    parse_hex_u64,
}
use http::HttpRequest
use net_reactor::SocketIo
use super::crypto::Crypto
use super::rpc::{flatten_http_body, parse_rpc_str_result}
use super::submit_fees::{is_eip1559_unsupported_error, max_u128}

pub(ingot) const RECEIPT_ATTEMPT_TIMEOUT_MS: u64 = 4_000
pub(ingot) const MAX_REPLACEMENTS: u8 = 2
pub(ingot) const RECEIPT_POLL_MS: u64 = 150
pub(ingot) const TX_GAS_LIMIT: u64 = 1_500_000
pub(ingot) const MIN_PRIORITY_FEE_WEI: u128 = 1_000_000_000
pub(ingot) const MIN_GAS_PRICE_WEI: u128 = 2_000_000_000
pub(ingot) const MIN_FEE_BUMP_WEI: u128 = 500_000_000

pub struct SubmitConfirmed { pub round_id: u64, pub btc_price: u64, pub timestamp: u64 }

impl Copy for SubmitConfirmed {}

pub enum SubmitOutcome {
    Confirmed(SubmitConfirmed),
    Failed(MemBuffer),
}

pub(ingot) enum TxFeeMode {
    Unset,
    Eip1559 {
        pub(ingot) max_priority_fee: u128,
        pub(ingot) max_fee: u128,
    },
    Legacy { pub(ingot) gas_price: u128 },
}

impl Copy for TxFeeMode {}

pub(ingot) enum SubmitPhase {
    FetchingNonceAndFees {
        pub(ingot) nonce_req: Option<Timeout<HttpRequest>>,
        pub(ingot) fee_hist_req: Option<Timeout<HttpRequest>>,
        pub(ingot) tip_req: Option<Timeout<HttpRequest>>,
        pub(ingot) nonce_out: Option<u64>,
        pub(ingot) fee_hist_out: Option<(u128, u128)>,
        pub(ingot) tip_out: Option<u128>,
        pub(ingot) nonce_done: bool,
        pub(ingot) fee_hist_done: bool,
        pub(ingot) tip_done: bool,
    },
    FetchingLegacyGas(Timeout<HttpRequest>),
    SendingRawTx(Timeout<HttpRequest>),
    WaitingReceiptTimer(Sleep),
    PollingReceipt(Timeout<HttpRequest>),
    Done,
}

pub struct SubmitMediansCoro {
    pub(ingot) owner: TaskId,
    pub(ingot) phase: SubmitPhase,
    pub(ingot) rpc_addr: SocketAddr,
    pub(ingot) rpc_path: MemBuffer,
    pub(ingot) privkey32: MemBuffer,
    pub(ingot) chain_id: u64,
    pub(ingot) contract20: MemBuffer,
    pub(ingot) round_id: u64,
    pub(ingot) btc_price: u64,
    pub(ingot) timestamp: u64,
    pub(ingot) calldata: MemBuffer,
    pub(ingot) started_ms: u64,
    pub(ingot) attempt_started_ms: u64,
    pub(ingot) nonce: u64,
    pub(ingot) fee_mode: TxFeeMode,
    pub(ingot) replacement_count: u8,
    pub(ingot) tx_hashes: MemVec<MemBuffer>,
    pub(ingot) poll_hash_idx: usize,
    pub(ingot) outcome: Option<SubmitOutcome>,
}

impl Coroutine for SubmitMediansCoro {
    type Output = SubmitOutcome
    uses E = (net: mut Net, crypto: Crypto, sched: mut Scheduler, io: mut SocketIo)

    fn poll(mut self) -> Poll<SubmitOutcome> uses E {
        match self.phase {
            SubmitPhase::Done => {
                if let Option::Some(res) = self.outcome.take() {
                    return Poll::Ready(res)
                }
                return Poll::Ready(
                    SubmitOutcome::Failed(format!("submission already finished")),
                )
            },
            SubmitPhase::FetchingNonceAndFees {
                mut nonce_req,
                mut fee_hist_req,
                mut tip_req,
                mut nonce_out,
                mut fee_hist_out,
                mut tip_out,
                mut nonce_done,
                mut fee_hist_done,
                mut tip_done,
            } => {
                if !nonce_done {
                    if let Option::Some(mut req) = nonce_req {
                        if let Poll::Ready(res) = req.poll() {
                            nonce_req = Option::None
                            nonce_done = true
                            if let Option::Some(body) = flatten_http_body(res) {
                                if let Option::Some(s) = parse_rpc_str_result(body.span()) {
                                    nonce_out = parse_hex_u64(s.span())
                                }
                            }
                        }
                    }
                }
                if !fee_hist_done {
                    if let Option::Some(mut req) = fee_hist_req {
                        if let Poll::Ready(res) = req.poll() {
                            fee_hist_req = Option::None
                            fee_hist_done = true
                            if let Option::Some(body) = flatten_http_body(res) {
                                fee_hist_out = parse_fee_history_result(body.span())
                            }
                        }
                    }
                }
                if !tip_done {
                    if let Option::Some(mut req) = tip_req {
                        if let Poll::Ready(res) = req.poll() {
                            tip_req = Option::None
                            tip_done = true
                            if let Option::Some(body) = flatten_http_body(res) {
                                if let Option::Some(s) = parse_rpc_str_result(body.span()) {
                                    tip_out = parse_hex_u128(s.span())
                                }
                            }
                        }
                    }
                }
                if !(nonce_done && fee_hist_done && tip_done) {
                    return Poll::Pending
                }
                let final_nonce = nonce_out
                let final_fh = fee_hist_out
                let final_tip = tip_out

                let Option::Some(nonce) = final_nonce else {
                    return self.finish(
                        SubmitOutcome::Failed(
                            format!(
                                "eth_getTransactionCount failed for round ",
                                self.round_id,
                            ),
                        ),
                    )
                }
                self.nonce = nonce
                let use_eip1559 = match final_fh {
                    Option::Some((next_base, _)) => next_base > 0 || final_tip.is_some(),
                    Option::None => false,
                }
                if use_eip1559 {
                    let (next_base, rew_tip) = final_fh.unwrap()
                    let rpc_tip = final_tip.unwrap_or(default: 0 as u128)
                    let (max_priority_fee, max_fee) = compute_eip1559_fees(
                        next_base_fee: next_base,
                        reward_tip: rew_tip,
                        rpc_tip,
                        min_priority_fee: MIN_PRIORITY_FEE_WEI,
                        min_max_fee: MIN_GAS_PRICE_WEI,
                    )
                    self.fee_mode = TxFeeMode::Eip1559 { max_priority_fee, max_fee }
                    return self.begin_signed_broadcast()
                }
                self.start_legacy_gas_query()
                return Poll::Pending
            },
            SubmitPhase::FetchingLegacyGas(mut req) => {
                let Poll::Ready(gas_res) = req.poll() else {
                    return Poll::Pending
                }
                var gas_opt: Option<u128> = Option::None
                if let Option::Some(body) = flatten_http_body(gas_res) {
                    if let Option::Some(res) = parse_rpc_str_result(body.span()) {
                        gas_opt = parse_hex_u128(res.span())
                    }
                }
                let Option::Some(raw_gas) = gas_opt else {
                    return self.finish(
                        SubmitOutcome::Failed(
                            format!("eth_gasPrice failed for round ", self.round_id),
                        ),
                    )
                }
                let bumped = raw_gas * (12 as u128) / (10 as u128)
                let gas_price = max_u128(bumped, MIN_GAS_PRICE_WEI)
                self.fee_mode = TxFeeMode::Legacy { gas_price }
                return self.begin_signed_broadcast()
            },
            SubmitPhase::SendingRawTx(mut req) => {
                let Poll::Ready(send_res) = req.poll() else {
                    return Poll::Pending
                }
                let Option::Some(body) = flatten_http_body(send_res) else {
                    if !self.tx_hashes.is_empty() {
                        self.resume_existing_receipt_poll()
                        return Poll::Pending
                    }
                    return self.finish(
                        SubmitOutcome::Failed(
                            format!(
                                "eth_sendRawTransaction HTTP failure for round ",
                                self.round_id,
                            ),
                        ),
                    )
                }
                let Option::Some(tx_hash) = parse_rpc_str_result(body.span()) else {
                    if self.tx_hashes.is_empty() {
                        if let TxFeeMode::Eip1559 { .. } = self.fee_mode {
                            if is_eip1559_unsupported_error(body.span()) {
                                self.start_legacy_gas_query()
                                return Poll::Pending
                            }
                        }
                    } else {
                        self.resume_existing_receipt_poll()
                        return Poll::Pending
                    }
                    return self.finish(
                        SubmitOutcome::Failed(format!("eth_sendRawTransaction RPC error: ", body)),
                    )
                }
                if !tx_hash.span().starts_with("0x") {
                    if !self.tx_hashes.is_empty() {
                        self.resume_existing_receipt_poll()
                        return Poll::Pending
                    }
                    return self.finish(
                        SubmitOutcome::Failed(
                            format!("eth_sendRawTransaction invalid tx hash: ", tx_hash),
                        ),
                    )
                }
                self.tx_hashes.push(tx_hash)
                self.poll_hash_idx = self.tx_hashes.len() - 1
                self.attempt_started_ms = sched.now_ms()
                self.start_receipt_poll()
                return Poll::Pending
            },
            SubmitPhase::WaitingReceiptTimer(mut sleep) => {
                let Poll::Ready(_) = sleep.poll() else {
                    return Poll::Pending
                }
                self.start_receipt_poll()
                return Poll::Pending
            },
            SubmitPhase::PollingReceipt(mut req) => {
                let Poll::Ready(receipt_res) = req.poll() else {
                    return Poll::Pending
                }
                if let Option::Some(body) = flatten_http_body(receipt_res) {
                    if let Option::Some((roff, rlen)) = json_get_raw(body.span(), "result".span()) {
                        let trimmed = body.span().slice(offset: roff, len: rlen).trim()
                        if trimmed != "null" {
                            if let Option::Some((soff, slen)) = json_get_str_bounds(
                                trimmed,
                                "status".span(),
                            ) {
                                let status_span = trimmed.slice(offset: soff, len: slen)
                                if let Option::Some(st) = parse_hex_u64(status_span) {
                                    if st == 1 {
                                        return self.finish(
                                            SubmitOutcome::Confirmed(
                                                SubmitConfirmed {
                                                    round_id: self.round_id,
                                                    btc_price: self.btc_price,
                                                    timestamp: self.timestamp,
                                                },
                                            ),
                                        )
                                    }
                                    return self.finish(
                                        SubmitOutcome::Failed(
                                            format!(
                                                "eth_sendRawTransaction receipt reverted status=",
                                                st,
                                            ),
                                        ),
                                    )
                                }
                            }
                            return self.finish(
                                SubmitOutcome::Failed(
                                    format!(
                                        "eth_getTransactionReceipt missing status in: ",
                                        trimmed,
                                    ),
                                ),
                            )
                        }
                    } else if json_get_raw(body.span(), "error".span()).is_some() {
                        return self.finish(
                            SubmitOutcome::Failed(
                                format!("eth_getTransactionReceipt RPC error: ", body),
                            ),
                        )
                    }
                }

                if sched.now_ms() - self.attempt_started_ms >= RECEIPT_ATTEMPT_TIMEOUT_MS {
                    if self.replacement_count < MAX_REPLACEMENTS {
                        self.replacement_count += 1
                        self.bump_current_fees()
                        return self.begin_signed_broadcast()
                    }
                    let last_tx = if self.tx_hashes.is_empty() {
                        MemBuffer::empty()
                    } else {
                        MemBuffer::from_span(self.tx_hashes[self.tx_hashes.len() - 1].span())
                    }
                    return self.finish(
                        SubmitOutcome::Failed(
                            format!(
                                "eth_sendRawTransaction timed out waiting for receipt round=",
                                self.round_id,
                                " tx=",
                                last_tx,
                            ),
                        ),
                    )
                }
                self.phase = SubmitPhase::WaitingReceiptTimer(
                    Sleep::after(owner: self.owner, delay_ms: RECEIPT_POLL_MS),
                )
                return Poll::Pending
            },
        }
    }

    fn cancel(mut self) uses E {
        match self.phase {
            SubmitPhase::FetchingNonceAndFees {
                mut nonce_req,
                mut fee_hist_req,
                mut tip_req,
                nonce_out: _,
                fee_hist_out: _,
                tip_out: _,
                nonce_done: _,
                fee_hist_done: _,
                tip_done: _,
            } => {
                if let Option::Some(mut r) = nonce_req {
                    r.cancel()
                }
                if let Option::Some(mut r) = fee_hist_req {
                    r.cancel()
                }
                if let Option::Some(mut r) = tip_req {
                    r.cancel()
                }
            },
            SubmitPhase::FetchingLegacyGas(mut req) => req.cancel(),
            SubmitPhase::SendingRawTx(mut req) => req.cancel(),
            SubmitPhase::WaitingReceiptTimer(mut sleep) => sleep.cancel(),
            SubmitPhase::PollingReceipt(mut req) => req.cancel(),
            SubmitPhase::Done => {},
        }
        self.phase = SubmitPhase::Done
        self.outcome = Option::None
        sched.cancel_owner_timers(self.owner)
        io.deregister_owner(self.owner)
    }
}
