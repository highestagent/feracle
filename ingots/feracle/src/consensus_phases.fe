use std::io::{Stderr, Stdout}
use std::net::Net
use std::time::Clock
use coro::{Scheduler, Sleep}
use feracle_core::{
    MAX_TOLERANCE_BPS,
    NODE_COUNT,
    QUORUM,
    QuoteMsg,
    SigMsg,
    add_sig_dedup,
    encode_quote_buf,
    encode_sig_msg_buf,
    first_tolerance_breach_asset,
    leader_index,
    median_prices_3,
    median_prices_4,
    median_u64,
    median_u64_4,
    prices_eq,
    sort_three_sigs,
    write_asset_symbol,
}
use net_reactor::SocketIo
use super::consensus_state::{ConsensusState, RoundContext}
use super::crypto::Crypto
use super::network::PeerMesh
use super::round_io::{add_quote_dedup}
use super::rpc::{QueryCurrentRound}
use super::submit::{SubmitMediansCoro, SubmitOutcome}
use super::telemetry::{TelemetryEvent, TelemetrySink}

impl RoundContext {
    pub(ingot) fn enter_phase_a_state<M: PeerMesh>(
        mut self,
        _ prices: [u64; 20],
        _ peer: mut M,
        _ telemetry: mut TelemetrySink,
    ) -> ConsensusState
    uses (
        net: mut Net,
        clock: Clock,
        crypto: Crypto,
        out: mut Stdout,
        err: mut Stderr,
        sched: mut Scheduler,
        io: mut SocketIo,
    )
    {
        let zero_prices: [u64; 20] = [0; 20]
        self.local_prices = prices
        self.local_ts = clock.now().as_secs()
        println!(
            "node ",
            self.config.node_id,
            " round ",
            self.round_id,
            " local_btc=",
            self.local_prices[0],
            " eth=",
            self.local_prices[1],
            " ts=",
            self.local_ts,
        )
        telemetry
            .set_phase(
                round_id: self.round_id,
                phase: "phase_a_quotes".span(),
                local_prices: self.local_prices,
                group_medians: zero_prices,
                round_ts: self.local_ts,
            )

        let self_quote = match crypto
            .sign_quote(
                privkey32: self.config.privkey32.span(),
                chain_id: self.config.chain_id,
                contract20: self.config.contract20.span(),
                round_id: self.round_id,
                timestamp: self.local_ts,
                prices: self.local_prices,
            ) {
            Option::Some(q) => q,
            Option::None => {
                eprintln!(
                    "node ",
                    self.config.node_id,
                    " round ",
                    self.round_id,
                    " failed to sign quote",
                )
                self.completed_rounds += 1
                return self.next_round_state()
            },
        }
        self.quotes = MemVec::new()
        add_quote_dedup(
            mut self.quotes,
            self_quote,
            max_len: NODE_COUNT.downcast_unchecked(),
        )

        var next_pending = MemVec<QuoteMsg>::new()
        var pq_i: usize = 0
        while pq_i < self.pending_quotes.len() {
            let pq = self.pending_quotes[pq_i]
            if pq.round_id == self.round_id {
                add_quote_dedup(
                    mut self.quotes,
                    pq,
                    max_len: NODE_COUNT.downcast_unchecked(),
                )
            } else if pq.round_id > self.round_id {
                add_quote_dedup(mut next_pending, pq, max_len: 0)
            }
            pq_i += 1
        }
        self.pending_quotes = next_pending

        self.quote_frame = encode_quote_buf(self_quote)
        let _ = peer.publish(self.quote_frame.span(), mut telemetry)

        let full_nodes: usize = NODE_COUNT.downcast_unchecked()
        if self.quotes.len() >= full_nodes {
            return self.enter_phase_b_state(mut peer, mut telemetry)
        }
        let quorum_grace = if self.quotes.len() >= QUORUM {
            Option::Some(Sleep::after(owner: self.owner, delay_ms: 2000))
        } else {
            Option::None
        }
        ConsensusState::PhaseAQuotes {
            started_ms: sched.now_ms(),
            deadline: Sleep::after(
                owner: self.owner,
                delay_ms: self.config.round_timeout_secs * 1000,
            ),
            pub_sleep: Sleep::after(owner: self.owner, delay_ms: 1000),
            quorum_grace,
        }
    }

    pub(ingot) fn enter_phase_b_state<M: PeerMesh>(
        mut self,
        _ peer: mut M,
        _ telemetry: mut TelemetrySink,
    ) -> ConsensusState
    uses (
        net: mut Net,
        clock: Clock,
        crypto: Crypto,
        out: mut Stdout,
        err: mut Stderr,
        sched: mut Scheduler,
        io: mut SocketIo,
    )
    {
        let full_nodes: usize = NODE_COUNT.downcast_unchecked()
        if self.quotes.len() >= full_nodes {
            self.group_medians = median_prices_4(
                self.quotes[0].prices,
                self.quotes[1].prices,
                self.quotes[2].prices,
                self.quotes[3].prices,
            )
            self.round_ts = median_u64_4(
                [
                    self.quotes[0].timestamp,
                    self.quotes[1].timestamp,
                    self.quotes[2].timestamp,
                    self.quotes[3].timestamp,
                ],
            )
        } else {
            self.group_medians = median_prices_3(
                self.quotes[0].prices,
                self.quotes[1].prices,
                self.quotes[2].prices,
            )
            self.round_ts = median_u64(
                [self.quotes[0].timestamp, self.quotes[1].timestamp, self.quotes[2].timestamp],
            )
        }

        if let Option::Some(bad_idx) = first_tolerance_breach_asset(
            local: self.local_prices,
            proposed: self.group_medians,
            max_bps: MAX_TOLERANCE_BPS,
        ) {
            var sym = MemBuffer::empty()
            write_asset_symbol(bad_idx, mut sym)
            eprintln!(
                "node ",
                self.config.node_id,
                " round ",
                self.round_id,
                " tolerance guard breached on ",
                sym,
                " (asset=",
                bad_idx,
                "): local=",
                self.local_prices[bad_idx],
                " proposed=",
                self.group_medians[bad_idx],
            )
            telemetry.record_event(TelemetryEvent::ToleranceBreach)
            telemetry
                .set_phase(
                    round_id: self.round_id,
                    phase: "tolerance_breach".span(),
                    local_prices: self.local_prices,
                    group_medians: self.group_medians,
                    round_ts: self.round_ts,
                )
            return ConsensusState::ToleranceBreachWait {
                deadline: Sleep::after(
                    owner: self.owner,
                    delay_ms: self.config.round_timeout_secs * 1000,
                ),
                rpc_sleep: Option::None,
                round_query: Option::Some(
                    QueryCurrentRound::start(
                        rpc_addr: self.config.rpc_addr,
                        rpc_path: self.config.rpc_path.span(),
                        contract_0x: self.config.contract_0x.span(),
                    ),
                ),
            }
        }

        let self_sig = match crypto
            .sign_digest(
                privkey32: self.config.privkey32.span(),
                chain_id: self.config.chain_id,
                contract20: self.config.contract20.span(),
                round_id: self.round_id,
                prices: self.group_medians,
                timestamp: self.round_ts,
            ) {
            Option::Some(s) => s,
            Option::None => {
                eprintln!(
                    "node ",
                    self.config.node_id,
                    " round ",
                    self.round_id,
                    " failed to sign digest",
                )
                self.completed_rounds += 1
                return self.next_round_state()
            },
        }

        self.sigs = MemVec::new()
        add_sig_dedup(mut self.sigs, self_sig)
        var next_pending = MemVec<SigMsg>::new()
        var ps_i: usize = 0
        while ps_i < self.pending_sigs.len() {
            let s = self.pending_sigs[ps_i]
            if s.round_id == self.round_id
                && prices_eq(s.median_prices, self.group_medians)
                && s.timestamp == self.round_ts {
                add_sig_dedup(mut self.sigs, s)
            } else if s.round_id > self.round_id {
                add_sig_dedup(mut next_pending, s)
            }
            ps_i += 1
        }
        self.pending_sigs = next_pending

        self.sig_frame = encode_sig_msg_buf(self_sig)
        let _ = peer.publish(self.sig_frame.span(), mut telemetry)
        telemetry
            .set_phase(
                round_id: self.round_id,
                phase: "phase_c_sigs".span(),
                local_prices: self.local_prices,
                group_medians: self.group_medians,
                round_ts: self.round_ts,
            )

        if self.sigs.len() >= QUORUM {
            return self.enter_submit_or_settle_state(mut telemetry)
        }
        ConsensusState::PhaseCSigs {
            started_ms: sched.now_ms(),
            deadline: Sleep::after(
                owner: self.owner,
                delay_ms: self.config.round_timeout_secs * 1000,
            ),
            pub_sleep: Sleep::after(owner: self.owner, delay_ms: 2000),
        }
    }

    pub(ingot) fn enter_submit_or_settle_state(
        mut self,
        _ telemetry: mut TelemetrySink,
    ) -> ConsensusState
    uses (net: mut Net, out: mut Stdout, sched: mut Scheduler, io: mut SocketIo)
    {
        self.sorted_sigs = sort_three_sigs([self.sigs[0], self.sigs[1], self.sigs[2]])
        let primary_leader = leader_index(round_id: self.round_id, node_count: NODE_COUNT)
        self.submitted = false

        if self.config.node_id == primary_leader {
            println!(
                "node ",
                self.config.node_id,
                " is leader for round ",
                self.round_id,
                ", submitting 20 medians btc=",
                self.group_medians[0],
            )
            telemetry
                .set_phase(
                    round_id: self.round_id,
                    phase: "submitting".span(),
                    local_prices: self.local_prices,
                    group_medians: self.group_medians,
                    round_ts: self.round_ts,
                )
            let now_ms = sched.now_ms()
            let submit = SubmitMediansCoro::start(
                rpc_addr: self.config.rpc_addr,
                rpc_path: self.config.rpc_path.span(),
                privkey32: self.config.privkey32.span(),
                from_0x: self.config.self_addr_0x.span(),
                chain_id: self.config.chain_id,
                contract20: self.config.contract20.span(),
                round_id: self.round_id,
                prices: self.group_medians,
                timestamp: self.round_ts,
                sigs: self.sorted_sigs,
            )
            ConsensusState::PrimarySubmitting {
                started_ms: now_ms,
                submit_started_ms: now_ms,
                submit,
                pub_sleep: Sleep::after(owner: self.owner, delay_ms: 2000),
            }
        } else {
            println!(
                "node ",
                self.config.node_id,
                " waiting for leader ",
                primary_leader,
                " to settle round ",
                self.round_id,
            )
            self.enter_settling_state(mut telemetry)
        }
    }

    pub(ingot) fn enter_settling_state(mut self, _ telemetry: mut TelemetrySink) -> ConsensusState
    uses (net: mut Net, sched: mut Scheduler, io: mut SocketIo)
    {
        telemetry
            .set_phase(
                round_id: self.round_id,
                phase: "settling".span(),
                local_prices: self.local_prices,
                group_medians: self.group_medians,
                round_ts: self.round_ts,
            )
        let backup_leader = leader_index(round_id: self.round_id + 1, node_count: NODE_COUNT)
        ConsensusState::Settling {
            started_ms: sched.now_ms(),
            deadline: Sleep::after(
                owner: self.owner,
                delay_ms: self.config.round_timeout_secs * 2000,
            ),
            pub_sleep: Sleep::after(owner: self.owner, delay_ms: 2000),
            rpc_sleep: Option::None,
            round_query: Option::Some(
                QueryCurrentRound::start(
                    rpc_addr: self.config.rpc_addr,
                    rpc_path: self.config.rpc_path.span(),
                    contract_0x: self.config.contract_0x.span(),
                ),
            ),
            failover_submit: Option::None,
            submit_started_ms: 0,
            failover_started: false,
            backup_leader,
        }
    }

    pub(ingot) fn handle_submit_outcome(
        mut self,
        _ outcome: SubmitOutcome,
        submit_started_ms: u64,
        _ telemetry: mut TelemetrySink,
    ) -> bool
    uses (out: mut Stdout, err: mut Stderr, sched: mut Scheduler, io: mut SocketIo)
    {
        let sub_ms = sched.now_ms() - submit_started_ms
        match outcome {
            SubmitOutcome::Confirmed(ok) => {
                println!(
                    "submitted round ",
                    ok.round_id,
                    " assets=20 btc=",
                    ok.btc_price,
                    " ts=",
                    ok.timestamp,
                )
                telemetry.record_event(TelemetryEvent::SubmitOk { duration_ms: sub_ms })
                true
            },
            SubmitOutcome::Failed(ref msg_buf) => {
                eprintln!(msg_buf)
                telemetry.record_event(TelemetryEvent::SubmitErr { duration_ms: sub_ms })
                false
            },
        }
    }
}
