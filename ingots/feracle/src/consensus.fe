use core::num::IntDowncast
use std::io::{Stderr, Stdout}
use std::net::Net
use std::time::Clock
use coro::{Coroutine, Poll, Scheduler, Sleep, TaskId}
use feracle_core::{
    MAX_TOLERANCE_BPS,
    NODE_COUNT,
    QUORUM,
    QuoteMsg,
    SigMsg,
    add_sig_dedup,
    encode_quote_buf,
    encode_sig_msg_buf,
    first_tolerance_breach_asset,
    leader_index,
    median_prices_3,
    median_prices_4,
    median_u64,
    median_u64_4,
    prices_eq,
    sort_three_sigs,
    write_asset_symbol,
}
use net_reactor::SocketIo
use super::config::NodeConfig
use super::feeds::{FeedReport, FetchFeedsCoro, feed_kind_name}
use super::ffi
use super::network::PeerSession
use super::round_io::{OracleAuthCache, QuoteRouting, add_quote_dedup, poll_all_messages}
use super::rpc::{QueryCurrentRound, QueryRoundState}
use super::submit::{SubmitMediansCoro, SubmitOutcome}
use super::telemetry::{TelemetryEvent, TelemetrySink}

enum ConsensusState {
    MeshWarmup { started_ms: u64, tick: Sleep },
    QueryRoundState { query: QueryRoundState },
    WaitNextSec { sleep: Sleep },
    FetchingFeeds {
        try_idx: usize,
        fetcher: FetchFeedsCoro,
    },
    FeedRetryDelay {
        next_try_idx: usize,
        sleep: Sleep,
    },
    FeedErrorCooldown { sleep: Sleep },
    PhaseAQuotes {
        started_ms: u64,
        deadline: Sleep,
        pub_sleep: Sleep,
        quorum_grace: Option<Sleep>,
    },
    ToleranceBreachWait {
        deadline: Sleep,
        rpc_sleep: Option<Sleep>,
        round_query: Option<QueryCurrentRound>,
    },
    PhaseCSigs {
        started_ms: u64,
        deadline: Sleep,
        pub_sleep: Sleep,
    },
    PrimarySubmitting {
        started_ms: u64,
        submit_started_ms: u64,
        submit: SubmitMediansCoro,
        pub_sleep: Sleep,
    },
    Settling {
        started_ms: u64,
        deadline: Sleep,
        pub_sleep: Sleep,
        rpc_sleep: Option<Sleep>,
        round_query: Option<QueryCurrentRound>,
        failover_submit: Option<SubmitMediansCoro>,
        submit_started_ms: u64,
        failover_started: bool,
        backup_leader: u64,
    },
    Done(i32),
}

enum StepAction {
    Stay,
    Transition(ConsensusState),
    Finish(i32),
}

struct RoundContext {
    owner: TaskId,
    config: NodeConfig,
    auth_cache: OracleAuthCache,
    pending_quotes: MemVec<QuoteMsg>,
    pending_sigs: MemVec<SigMsg>,
    scratch: MemBuffer,
    completed_rounds: u64,
    fallback_round: u64,
    round_id: u64,
    last_updated: u64,
    local_prices: [u64; 20],
    local_ts: u64,
    group_medians: [u64; 20],
    round_ts: u64,
    quotes: MemVec<QuoteMsg>,
    quote_frame: MemBuffer,
    sigs: MemVec<SigMsg>,
    sorted_sigs: [SigMsg; 3],
    sig_frame: MemBuffer,
    submitted: bool,
}

pub struct ConsensusCoro { ctx: RoundContext, state: ConsensusState }

fn zero_sig() -> SigMsg {
    SigMsg {
        round_id: 0,
        timestamp: 0,
        median_prices: [0; 20],
        signer_addr: [0; 20],
        v: 0,
        r: [0; 32],
        s: [0; 32],
    }
}

fn emit_feed_reports(_ reports: MemVec<FeedReport>, _ telemetry: mut TelemetrySink)
uses (err: mut Stderr)
{
    var i: usize = 0
    while i < reports.len() {
        let rep = reports[i]
        if !rep.ok {
            eprintln!(
                "warning: failed to fetch feed source index=",
                i,
                " addr=",
                rep.addr,
            )
        }
        if i < 8 {
            let provider_buf = feed_kind_name(rep.kind)
            let addr_buf = format!(rep.addr)
            telemetry
                .set_feed(
                    slot: i.downcast_unchecked(),
                    provider: provider_buf.span(),
                    addr: addr_buf.span(),
                    price: rep.price,
                    assets_ok: rep.assets_ok,
                    ok: rep.ok,
                    latency_ms: rep.latency_ms,
                )
        }
        i += 1
    }
}

fn opt_sleep_ready(_ slot: mut Option<Sleep>) -> bool
uses (sched: mut Scheduler)
{
    if let Option::Some(mut s) = slot {
        if let Poll::Ready(_) = s.poll() {
            slot = Option::None
            return true
        }
    }
    false
}

fn cancel_opt_sleep(_ slot: mut Option<Sleep>) uses (sched: mut Scheduler) {
    if let Option::Some(mut s) = slot {
        s.cancel()
        slot = Option::None
    }
}

fn cancel_state(_ state: mut ConsensusState)
uses (net: mut Net, sched: mut Scheduler, io: mut SocketIo)
{
    match state {
        ConsensusState::MeshWarmup { started_ms: _, mut tick } => tick.cancel(),
        ConsensusState::QueryRoundState { mut query } => query.cancel(),
        ConsensusState::WaitNextSec { mut sleep } => sleep.cancel(),
        ConsensusState::FetchingFeeds { try_idx: _, mut fetcher } => fetcher.cancel(),
        ConsensusState::FeedRetryDelay { next_try_idx: _, mut sleep } => sleep.cancel(),
        ConsensusState::FeedErrorCooldown { mut sleep } => sleep.cancel(),
        ConsensusState::PhaseAQuotes {
            started_ms: _,
            mut deadline,
            mut pub_sleep,
            mut quorum_grace,
        } => {
            deadline.cancel()
            pub_sleep.cancel()
            cancel_opt_sleep(mut quorum_grace)
        },
        ConsensusState::ToleranceBreachWait { mut deadline, mut rpc_sleep, mut round_query } => {
            deadline.cancel()
            cancel_opt_sleep(mut rpc_sleep)
            if let Option::Some(mut q) = round_query {
                q.cancel()
            }
        },
        ConsensusState::PhaseCSigs { started_ms: _, mut deadline, mut pub_sleep } => {
            deadline.cancel()
            pub_sleep.cancel()
        },
        ConsensusState::PrimarySubmitting {
            started_ms: _,
            submit_started_ms: _,
            mut submit,
            mut pub_sleep,
        } => {
            submit.cancel()
            pub_sleep.cancel()
        },
        ConsensusState::Settling {
            started_ms: _,
            mut deadline,
            mut pub_sleep,
            mut rpc_sleep,
            mut round_query,
            mut failover_submit,
            submit_started_ms: _,
            failover_started: _,
            backup_leader: _,
        } => {
            deadline.cancel()
            pub_sleep.cancel()
            cancel_opt_sleep(mut rpc_sleep)
            if let Option::Some(mut q) = round_query {
                q.cancel()
            }
            if let Option::Some(mut s) = failover_submit {
                s.cancel()
            }
        },
        ConsensusState::Done(_) => {},
    }
}

fn quote_routing_for(_ state: ref ConsensusState) -> (QuoteRouting, bool) {
    match state {
        ConsensusState::PhaseAQuotes { .. } => (QuoteRouting::AcceptCurrent, false),
        ConsensusState::ToleranceBreachWait { .. } => (QuoteRouting::IgnoreCurrent, false),
        ConsensusState::PhaseCSigs { .. } => (QuoteRouting::IgnoreCurrent, true),
        ConsensusState::PrimarySubmitting { .. } => (QuoteRouting::IgnoreCurrent, true),
        ConsensusState::Settling { .. } => (QuoteRouting::IgnoreCurrent, true),
        _ => (QuoteRouting::BufferPending, false),
    }
}

impl RoundContext {
    fn drain_inbox(
        mut self,
        _ quote_routing: QuoteRouting,
        _ accept_sigs: bool,
        _ peer: mut PeerSession,
        _ telemetry: mut TelemetrySink,
    )
    uses (net: mut Net, clock: Clock, sched: mut Scheduler, io: mut SocketIo)
    {
        poll_all_messages(
            mut peer,
            mut telemetry,
            auth_cache: mut self.auth_cache,
            round_id: self.round_id,
            chain_id: self.config.chain_id,
            contract20: self.config.contract20.span(),
            quote_routing,
            mut self.quotes,
            mut self.pending_quotes,
            mut self.sigs,
            mut self.pending_sigs,
            accept_sigs,
            expected_prices: self.group_medians,
            expected_ts: self.round_ts,
            mut self.scratch,
        )
    }

    fn step_rebroadcast(
        mut self,
        use_quote: bool,
        _ pub_sleep: mut Sleep,
        _ peer: mut PeerSession,
        _ telemetry: mut TelemetrySink,
    )
    uses (net: mut Net, clock: Clock, sched: mut Scheduler, io: mut SocketIo)
    {
        if let Poll::Ready(_) = pub_sleep.poll() {
            if use_quote {
                let _ = peer.publish(self.quote_frame.span(), mut telemetry)
                pub_sleep = Sleep::after(owner: self.owner, delay_ms: 1000)
            } else {
                let _ = peer.publish(self.sig_frame.span(), mut telemetry)
                pub_sleep = Sleep::after(owner: self.owner, delay_ms: 2000)
            }
        }
    }

    fn next_round_state(mut self) -> ConsensusState
    uses (net: mut Net, sched: mut Scheduler, io: mut SocketIo)
    {
        if self.config.rounds > 0 && self.completed_rounds >= self.config.rounds {
            return ConsensusState::Done(0)
        }
        self.round_id = self.fallback_round
        ConsensusState::QueryRoundState {
            query: QueryRoundState::start(
                rpc_addr: self.config.rpc_addr,
                rpc_path: self.config.rpc_path.span(),
                contract_0x: self.config.contract_0x.span(),
            ),
        }
    }

    fn begin_fetching_state(mut self, _ telemetry: mut TelemetrySink) -> ConsensusState
    uses (net: mut Net, out: mut Stdout, sched: mut Scheduler, io: mut SocketIo)
    {
        let zero_prices: [u64; 20] = [0; 20]
        println!(
            "node ",
            self.config.node_id,
            " starting round ",
            self.round_id,
        )
        telemetry.record_event(TelemetryEvent::RoundStarted)
        telemetry
            .set_phase(
                round_id: self.round_id,
                phase: "fetching".span(),
                local_prices: zero_prices,
                group_medians: zero_prices,
                round_ts: 0,
            )
        ConsensusState::FetchingFeeds {
            try_idx: 0,
            fetcher: FetchFeedsCoro::start(self.config.sources.as_slice()),
        }
    }

    fn enter_phase_a_state(
        mut self,
        _ prices: [u64; 20],
        _ peer: mut PeerSession,
        _ telemetry: mut TelemetrySink,
    ) -> ConsensusState
    uses (
        net: mut Net,
        clock: Clock,
        out: mut Stdout,
        err: mut Stderr,
        sched: mut Scheduler,
        io: mut SocketIo,
    )
    {
        let zero_prices: [u64; 20] = [0; 20]
        self.local_prices = prices
        self.local_ts = clock.now().as_secs()
        println!(
            "node ",
            self.config.node_id,
            " round ",
            self.round_id,
            " local_btc=",
            self.local_prices[0],
            " eth=",
            self.local_prices[1],
            " ts=",
            self.local_ts,
        )
        telemetry
            .set_phase(
                round_id: self.round_id,
                phase: "phase_a_quotes".span(),
                local_prices: self.local_prices,
                group_medians: zero_prices,
                round_ts: self.local_ts,
            )

        let self_quote = match ffi::sign_quote(
            privkey32: self.config.privkey32.span(),
            chain_id: self.config.chain_id,
            contract20: self.config.contract20.span(),
            round_id: self.round_id,
            timestamp: self.local_ts,
            prices: self.local_prices,
        ) {
            Option::Some(q) => q,
            Option::None => {
                eprintln!(
                    "node ",
                    self.config.node_id,
                    " round ",
                    self.round_id,
                    " failed to sign quote",
                )
                self.completed_rounds += 1
                return self.next_round_state()
            },
        }
        self.quotes = MemVec::new()
        add_quote_dedup(
            mut self.quotes,
            self_quote,
            max_len: NODE_COUNT.downcast_unchecked(),
        )

        var next_pending = MemVec<QuoteMsg>::new()
        var pq_i: usize = 0
        while pq_i < self.pending_quotes.len() {
            let pq = self.pending_quotes[pq_i]
            if pq.round_id == self.round_id {
                add_quote_dedup(
                    mut self.quotes,
                    pq,
                    max_len: NODE_COUNT.downcast_unchecked(),
                )
            } else if pq.round_id > self.round_id {
                add_quote_dedup(mut next_pending, pq, max_len: 0)
            }
            pq_i += 1
        }
        self.pending_quotes = next_pending

        self.quote_frame = encode_quote_buf(self_quote)
        let _ = peer.publish(self.quote_frame.span(), mut telemetry)

        let full_nodes: usize = NODE_COUNT.downcast_unchecked()
        if self.quotes.len() >= full_nodes {
            return self.enter_phase_b_state(mut peer, mut telemetry)
        }
        let quorum_grace = if self.quotes.len() >= QUORUM {
            Option::Some(Sleep::after(owner: self.owner, delay_ms: 2000))
        } else {
            Option::None
        }
        ConsensusState::PhaseAQuotes {
            started_ms: sched.now_ms(),
            deadline: Sleep::after(
                owner: self.owner,
                delay_ms: self.config.round_timeout_secs * 1000,
            ),
            pub_sleep: Sleep::after(owner: self.owner, delay_ms: 1000),
            quorum_grace,
        }
    }

    fn enter_phase_b_state(
        mut self,
        _ peer: mut PeerSession,
        _ telemetry: mut TelemetrySink,
    ) -> ConsensusState
    uses (
        net: mut Net,
        clock: Clock,
        out: mut Stdout,
        err: mut Stderr,
        sched: mut Scheduler,
        io: mut SocketIo,
    )
    {
        let full_nodes: usize = NODE_COUNT.downcast_unchecked()
        if self.quotes.len() >= full_nodes {
            self.group_medians = median_prices_4(
                self.quotes[0].prices,
                self.quotes[1].prices,
                self.quotes[2].prices,
                self.quotes[3].prices,
            )
            self.round_ts = median_u64_4(
                [
                    self.quotes[0].timestamp,
                    self.quotes[1].timestamp,
                    self.quotes[2].timestamp,
                    self.quotes[3].timestamp,
                ],
            )
        } else {
            self.group_medians = median_prices_3(
                self.quotes[0].prices,
                self.quotes[1].prices,
                self.quotes[2].prices,
            )
            self.round_ts = median_u64(
                [self.quotes[0].timestamp, self.quotes[1].timestamp, self.quotes[2].timestamp],
            )
        }

        if let Option::Some(bad_idx) = first_tolerance_breach_asset(
            local: self.local_prices,
            proposed: self.group_medians,
            max_bps: MAX_TOLERANCE_BPS,
        ) {
            var sym = MemBuffer::empty()
            write_asset_symbol(bad_idx, mut sym)
            eprintln!(
                "node ",
                self.config.node_id,
                " round ",
                self.round_id,
                " tolerance guard breached on ",
                sym,
                " (asset=",
                bad_idx,
                "): local=",
                self.local_prices[bad_idx],
                " proposed=",
                self.group_medians[bad_idx],
            )
            telemetry.record_event(TelemetryEvent::ToleranceBreach)
            telemetry
                .set_phase(
                    round_id: self.round_id,
                    phase: "tolerance_breach".span(),
                    local_prices: self.local_prices,
                    group_medians: self.group_medians,
                    round_ts: self.round_ts,
                )
            return ConsensusState::ToleranceBreachWait {
                deadline: Sleep::after(
                    owner: self.owner,
                    delay_ms: self.config.round_timeout_secs * 1000,
                ),
                rpc_sleep: Option::None,
                round_query: Option::Some(
                    QueryCurrentRound::start(
                        rpc_addr: self.config.rpc_addr,
                        rpc_path: self.config.rpc_path.span(),
                        contract_0x: self.config.contract_0x.span(),
                    ),
                ),
            }
        }

        let self_sig = match ffi::sign_digest(
            privkey32: self.config.privkey32.span(),
            chain_id: self.config.chain_id,
            contract20: self.config.contract20.span(),
            round_id: self.round_id,
            prices: self.group_medians,
            timestamp: self.round_ts,
        ) {
            Option::Some(s) => s,
            Option::None => {
                eprintln!(
                    "node ",
                    self.config.node_id,
                    " round ",
                    self.round_id,
                    " failed to sign digest",
                )
                self.completed_rounds += 1
                return self.next_round_state()
            },
        }

        self.sigs = MemVec::new()
        add_sig_dedup(mut self.sigs, self_sig)
        var next_pending = MemVec<SigMsg>::new()
        var ps_i: usize = 0
        while ps_i < self.pending_sigs.len() {
            let s = self.pending_sigs[ps_i]
            if s.round_id == self.round_id
                && prices_eq(s.median_prices, self.group_medians)
                && s.timestamp == self.round_ts {
                add_sig_dedup(mut self.sigs, s)
            } else if s.round_id > self.round_id {
                add_sig_dedup(mut next_pending, s)
            }
            ps_i += 1
        }
        self.pending_sigs = next_pending

        self.sig_frame = encode_sig_msg_buf(self_sig)
        let _ = peer.publish(self.sig_frame.span(), mut telemetry)
        telemetry
            .set_phase(
                round_id: self.round_id,
                phase: "phase_c_sigs".span(),
                local_prices: self.local_prices,
                group_medians: self.group_medians,
                round_ts: self.round_ts,
            )

        if self.sigs.len() >= QUORUM {
            return self.enter_submit_or_settle_state(mut telemetry)
        }
        ConsensusState::PhaseCSigs {
            started_ms: sched.now_ms(),
            deadline: Sleep::after(
                owner: self.owner,
                delay_ms: self.config.round_timeout_secs * 1000,
            ),
            pub_sleep: Sleep::after(owner: self.owner, delay_ms: 2000),
        }
    }

    fn enter_submit_or_settle_state(mut self, _ telemetry: mut TelemetrySink) -> ConsensusState
    uses (net: mut Net, out: mut Stdout, sched: mut Scheduler, io: mut SocketIo)
    {
        self.sorted_sigs = sort_three_sigs([self.sigs[0], self.sigs[1], self.sigs[2]])
        let primary_leader = leader_index(round_id: self.round_id, node_count: NODE_COUNT)
        self.submitted = false

        if self.config.node_id == primary_leader {
            println!(
                "node ",
                self.config.node_id,
                " is leader for round ",
                self.round_id,
                ", submitting 20 medians btc=",
                self.group_medians[0],
            )
            telemetry
                .set_phase(
                    round_id: self.round_id,
                    phase: "submitting".span(),
                    local_prices: self.local_prices,
                    group_medians: self.group_medians,
                    round_ts: self.round_ts,
                )
            let now_ms = sched.now_ms()
            let submit = SubmitMediansCoro::start(
                rpc_addr: self.config.rpc_addr,
                rpc_path: self.config.rpc_path.span(),
                privkey32: self.config.privkey32.span(),
                from_0x: self.config.self_addr_0x.span(),
                chain_id: self.config.chain_id,
                contract20: self.config.contract20.span(),
                round_id: self.round_id,
                prices: self.group_medians,
                timestamp: self.round_ts,
                sigs: self.sorted_sigs,
            )
            ConsensusState::PrimarySubmitting {
                started_ms: now_ms,
                submit_started_ms: now_ms,
                submit,
                pub_sleep: Sleep::after(owner: self.owner, delay_ms: 2000),
            }
        } else {
            println!(
                "node ",
                self.config.node_id,
                " waiting for leader ",
                primary_leader,
                " to settle round ",
                self.round_id,
            )
            self.enter_settling_state(mut telemetry)
        }
    }

    fn enter_settling_state(mut self, _ telemetry: mut TelemetrySink) -> ConsensusState
    uses (net: mut Net, sched: mut Scheduler, io: mut SocketIo)
    {
        telemetry
            .set_phase(
                round_id: self.round_id,
                phase: "settling".span(),
                local_prices: self.local_prices,
                group_medians: self.group_medians,
                round_ts: self.round_ts,
            )
        let backup_leader = leader_index(round_id: self.round_id + 1, node_count: NODE_COUNT)
        ConsensusState::Settling {
            started_ms: sched.now_ms(),
            deadline: Sleep::after(
                owner: self.owner,
                delay_ms: self.config.round_timeout_secs * 2000,
            ),
            pub_sleep: Sleep::after(owner: self.owner, delay_ms: 2000),
            rpc_sleep: Option::None,
            round_query: Option::Some(
                QueryCurrentRound::start(
                    rpc_addr: self.config.rpc_addr,
                    rpc_path: self.config.rpc_path.span(),
                    contract_0x: self.config.contract_0x.span(),
                ),
            ),
            failover_submit: Option::None,
            submit_started_ms: 0,
            failover_started: false,
            backup_leader,
        }
    }

    fn handle_submit_outcome(
        mut self,
        _ outcome: SubmitOutcome,
        submit_started_ms: u64,
        _ telemetry: mut TelemetrySink,
    ) -> bool
    uses (out: mut Stdout, err: mut Stderr, sched: mut Scheduler, io: mut SocketIo)
    {
        let sub_ms = sched.now_ms() - submit_started_ms
        match outcome {
            SubmitOutcome::Confirmed(ok) => {
                println!(
                    "submitted round ",
                    ok.round_id,
                    " assets=20 btc=",
                    ok.btc_price,
                    " ts=",
                    ok.timestamp,
                )
                telemetry.record_event(TelemetryEvent::SubmitOk { duration_ms: sub_ms })
                true
            },
            SubmitOutcome::Failed(ref msg_buf) => {
                eprintln!(msg_buf)
                telemetry.record_event(TelemetryEvent::SubmitErr { duration_ms: sub_ms })
                false
            },
        }
    }
}

impl ConsensusCoro {
    pub fn new(config: own NodeConfig) -> Self uses (sched: mut Scheduler) {
        let owner = sched.alloc_task()
        let now_ms = sched.now_ms()
        let auth_cache = OracleAuthCache::new(
            self_addr20: config.self_addr20,
            rpc_addr: config.rpc_addr,
            rpc_path: MemBuffer::from_span(config.rpc_path.span()),
            contract_0x: MemBuffer::from_span(config.contract_0x.span()),
        )
        let ctx = RoundContext {
            owner,
            config,
            auth_cache,
            pending_quotes: MemVec::new(),
            pending_sigs: MemVec::new(),
            scratch: MemBuffer::with_capacity(512),
            completed_rounds: 0,
            fallback_round: 1,
            round_id: 1,
            last_updated: 0,
            local_prices: [0; 20],
            local_ts: 0,
            group_medians: [0; 20],
            round_ts: 0,
            quotes: MemVec::new(),
            quote_frame: MemBuffer::empty(),
            sigs: MemVec::new(),
            sorted_sigs: [zero_sig(); 3],
            sig_frame: MemBuffer::empty(),
            submitted: false,
        }
        let state = ConsensusState::MeshWarmup {
            started_ms: now_ms,
            tick: Sleep::after(owner, delay_ms: 50),
        }
        ConsensusCoro { ctx, state }
    }

    fn transition(mut self, _ next: own ConsensusState)
    uses (net: mut Net, sched: mut Scheduler, io: mut SocketIo)
    {
        cancel_state(mut self.state)
        self.state = next
    }

    pub fn cancel(mut self)
    uses (net: mut Net, sched: mut Scheduler, io: mut SocketIo)
    {
        self.transition(ConsensusState::Done(0))
        self.ctx.auth_cache.cancel()
        sched.cancel_owner_timers(self.ctx.owner)
        io.deregister_owner(self.ctx.owner)
    }

    pub fn poll(mut self, _ peer: mut PeerSession, _ telemetry: mut TelemetrySink) -> Poll<i32>
    uses (
        net: mut Net,
        clock: Clock,
        out: mut Stdout,
        err: mut Stderr,
        sched: mut Scheduler,
        io: mut SocketIo,
    )
    {
        if let ConsensusState::Done(code) = self.state {
            return Poll::Ready(code)
        }

        let (quote_routing, accept_sigs) = quote_routing_for(ref self.state)
        self.ctx.drain_inbox(quote_routing, accept_sigs, mut peer, mut telemetry)

        let ctx = mut self.ctx
        let action = match self.state {
            ConsensusState::Done(code) => StepAction::Finish(code),
            ConsensusState::MeshWarmup { started_ms, mut tick } => {
                let peers = peer.peer_count()
                let elapsed_ms = sched.now_ms() - started_ms
                if peers >= 3
                    || (elapsed_ms >= 2000 && peers >= 2)
                    || (elapsed_ms >= 6000 && peers >= 1)
                    || elapsed_ms >= 15000 {
                    println!(
                        "node ",
                        ctx.config.node_id,
                        " mesh ready with peer_count=",
                        peers,
                    )
                    StepAction::Transition(ctx.next_round_state())
                } else {
                    if let Poll::Ready(_) = tick.poll() {
                        tick = Sleep::after(owner: ctx.owner, delay_ms: 50)
                    }
                    StepAction::Stay
                }
            },
            ConsensusState::QueryRoundState { mut query } => {
                if let Poll::Ready(rs) = query.poll() {
                    ctx.round_id = match rs.round_id {
                        Option::Some(r) => r,
                        Option::None => {
                            eprintln!(
                                "node ",
                                ctx.config.node_id,
                                " warning: failed to query currentRound, using fallback=",
                                ctx.fallback_round,
                            )
                            ctx.fallback_round
                        },
                    }
                    ctx.last_updated = rs.last_updated
                    if clock.now().as_secs() <= ctx.last_updated {
                        StepAction::Transition(
                            ConsensusState::WaitNextSec {
                                sleep: Sleep::after(owner: ctx.owner, delay_ms: 100),
                            },
                        )
                    } else {
                        StepAction::Transition(ctx.begin_fetching_state(mut telemetry))
                    }
                } else {
                    StepAction::Stay
                }
            },
            ConsensusState::WaitNextSec { mut sleep } => {
                if clock.now().as_secs() > ctx.last_updated {
                    StepAction::Transition(ctx.begin_fetching_state(mut telemetry))
                } else {
                    if let Poll::Ready(_) = sleep.poll() {
                        sleep = Sleep::after(owner: ctx.owner, delay_ms: 100)
                    }
                    StepAction::Stay
                }
            },
            ConsensusState::FetchingFeeds { try_idx, mut fetcher } => {
                if let Poll::Ready(outcome) = fetcher.poll() {
                    if let Option::Some(prices) = outcome.medians {
                        emit_feed_reports(outcome.reports, mut telemetry)
                        StepAction::Transition(
                            ctx.enter_phase_a_state(prices, mut peer, mut telemetry),
                        )
                    } else {
                        let next_try = try_idx + 1
                        if next_try < 3 {
                            StepAction::Transition(
                                ConsensusState::FeedRetryDelay {
                                    next_try_idx: next_try,
                                    sleep: Sleep::after(owner: ctx.owner, delay_ms: 500),
                                },
                            )
                        } else {
                            let zero_prices: [u64; 20] = [0; 20]
                            emit_feed_reports(outcome.reports, mut telemetry)
                            eprintln!(
                                "node ",
                                ctx.config.node_id,
                                " round ",
                                ctx.round_id,
                                " error: incomplete price feeds for 20-asset basket",
                            )
                            telemetry
                                .set_phase(
                                    round_id: ctx.round_id,
                                    phase: "feed_error".span(),
                                    local_prices: zero_prices,
                                    group_medians: zero_prices,
                                    round_ts: 0,
                                )
                            ctx.completed_rounds += 1
                            StepAction::Transition(
                                ConsensusState::FeedErrorCooldown {
                                    sleep: Sleep::after(owner: ctx.owner, delay_ms: 1000),
                                },
                            )
                        }
                    }
                } else {
                    StepAction::Stay
                }
            },
            ConsensusState::FeedRetryDelay { next_try_idx, mut sleep } => {
                if let Poll::Ready(_) = sleep.poll() {
                    StepAction::Transition(
                        ConsensusState::FetchingFeeds {
                            try_idx: next_try_idx,
                            fetcher: FetchFeedsCoro::start(ctx.config.sources.as_slice()),
                        },
                    )
                } else {
                    StepAction::Stay
                }
            },
            ConsensusState::FeedErrorCooldown { mut sleep } => {
                if let Poll::Ready(_) = sleep.poll() {
                    StepAction::Transition(ctx.next_round_state())
                } else {
                    StepAction::Stay
                }
            },
            ConsensusState::PhaseAQuotes {
                started_ms: _,
                mut deadline,
                mut pub_sleep,
                mut quorum_grace,
            } => {
                let full_nodes: usize = NODE_COUNT.downcast_unchecked()
                var proceed = ctx.quotes.len() >= full_nodes
                if !proceed && ctx.quotes.len() >= QUORUM {
                    if let Option::Some(mut gs) = quorum_grace {
                        if let Poll::Ready(_) = gs.poll() {
                            quorum_grace = Option::None
                            proceed = true
                        }
                    } else {
                        quorum_grace = Option::Some(Sleep::after(owner: ctx.owner, delay_ms: 2000))
                    }
                }
                if proceed {
                    StepAction::Transition(ctx.enter_phase_b_state(mut peer, mut telemetry))
                } else if let Poll::Ready(_) = deadline.poll() {
                    let zero_prices: [u64; 20] = [0; 20]
                    eprintln!(
                        "node ",
                        ctx.config.node_id,
                        " round ",
                        ctx.round_id,
                        " timed out in Phase A with ",
                        ctx.quotes.len(),
                        " quotes",
                    )
                    telemetry
                        .set_phase(
                            round_id: ctx.round_id,
                            phase: "timeout_phase_a".span(),
                            local_prices: ctx.local_prices,
                            group_medians: zero_prices,
                            round_ts: ctx.local_ts,
                        )
                    ctx.completed_rounds += 1
                    StepAction::Transition(ctx.next_round_state())
                } else {
                    ctx.step_rebroadcast(use_quote: true, mut pub_sleep, mut peer, mut telemetry)
                    StepAction::Stay
                }
            },
            ConsensusState::ToleranceBreachWait {
                mut deadline,
                mut rpc_sleep,
                mut round_query,
            } => {
                var advanced_round = false
                if let Option::Some(mut q) = round_query {
                    if let Poll::Ready(next_round_opt) = q.poll() {
                        round_query = Option::None
                        if let Option::Some(r) = next_round_opt {
                            if r > ctx.round_id {
                                ctx.fallback_round = r
                                ctx.completed_rounds += 1
                                advanced_round = true
                            }
                        }
                        if !advanced_round {
                            rpc_sleep = Option::Some(Sleep::after(owner: ctx.owner, delay_ms: 150))
                        }
                    }
                }
                if advanced_round {
                    StepAction::Transition(ctx.next_round_state())
                } else {
                    if round_query.is_none() && opt_sleep_ready(mut rpc_sleep) {
                        round_query = Option::Some(
                            QueryCurrentRound::start(
                                rpc_addr: ctx.config.rpc_addr,
                                rpc_path: ctx.config.rpc_path.span(),
                                contract_0x: ctx.config.contract_0x.span(),
                            ),
                        )
                    }
                    if let Poll::Ready(_) = deadline.poll() {
                        ctx.completed_rounds += 1
                        StepAction::Transition(ctx.next_round_state())
                    } else {
                        StepAction::Stay
                    }
                }
            },
            ConsensusState::PhaseCSigs { started_ms: _, mut deadline, mut pub_sleep } => {
                if ctx.sigs.len() >= QUORUM {
                    StepAction::Transition(ctx.enter_submit_or_settle_state(mut telemetry))
                } else if let Poll::Ready(_) = deadline.poll() {
                    eprintln!(
                        "node ",
                        ctx.config.node_id,
                        " round ",
                        ctx.round_id,
                        " timed out in Phase C with ",
                        ctx.sigs.len(),
                        " sigs",
                    )
                    telemetry
                        .set_phase(
                            round_id: ctx.round_id,
                            phase: "timeout_phase_c".span(),
                            local_prices: ctx.local_prices,
                            group_medians: ctx.group_medians,
                            round_ts: ctx.round_ts,
                        )
                    ctx.completed_rounds += 1
                    StepAction::Transition(ctx.next_round_state())
                } else {
                    ctx.step_rebroadcast(use_quote: false, mut pub_sleep, mut peer, mut telemetry)
                    StepAction::Stay
                }
            },
            ConsensusState::PrimarySubmitting {
                started_ms: _,
                submit_started_ms,
                mut submit,
                mut pub_sleep,
            } => {
                ctx.step_rebroadcast(use_quote: false, mut pub_sleep, mut peer, mut telemetry)
                if let Poll::Ready(res) = submit.poll() {
                    ctx.submitted = ctx.handle_submit_outcome(res, submit_started_ms, mut telemetry)
                    StepAction::Transition(ctx.enter_settling_state(mut telemetry))
                } else {
                    StepAction::Stay
                }
            },
            ConsensusState::Settling {
                started_ms,
                mut deadline,
                mut pub_sleep,
                mut rpc_sleep,
                mut round_query,
                mut failover_submit,
                mut submit_started_ms,
                mut failover_started,
                backup_leader,
            } => {
                ctx.step_rebroadcast(use_quote: false, mut pub_sleep, mut peer, mut telemetry)
                if let Option::Some(mut fb) = failover_submit {
                    if let Poll::Ready(res) = fb.poll() {
                        failover_submit = Option::None
                        ctx.submitted = ctx
                            .handle_submit_outcome(res, submit_started_ms, mut telemetry)
                    }
                }
                var settled_onchain = false
                if let Option::Some(mut q) = round_query {
                    if let Poll::Ready(onchain_opt) = q.poll() {
                        round_query = Option::None
                        if let Option::Some(onchain_round) = onchain_opt {
                            if onchain_round > ctx.round_id {
                                ctx.fallback_round = onchain_round
                                println!(
                                    "node ",
                                    ctx.config.node_id,
                                    " confirmed round ",
                                    ctx.round_id,
                                    " settled on-chain",
                                )
                                telemetry
                                    .set_phase(
                                        round_id: ctx.round_id,
                                        phase: "settled".span(),
                                        local_prices: ctx.local_prices,
                                        group_medians: ctx.group_medians,
                                        round_ts: ctx.round_ts,
                                    )
                                ctx.completed_rounds += 1
                                settled_onchain = true
                            }
                        }
                        if !settled_onchain {
                            rpc_sleep = Option::Some(Sleep::after(owner: ctx.owner, delay_ms: 150))
                        }
                    }
                }
                if settled_onchain {
                    StepAction::Transition(ctx.next_round_state())
                } else {
                    if round_query.is_none() && opt_sleep_ready(mut rpc_sleep) {
                        round_query = Option::Some(
                            QueryCurrentRound::start(
                                rpc_addr: ctx.config.rpc_addr,
                                rpc_path: ctx.config.rpc_path.span(),
                                contract_0x: ctx.config.contract_0x.span(),
                            ),
                        )
                    }
                    let elapsed_ms = sched.now_ms() - started_ms
                    let half_ms = ctx.config.round_timeout_secs * 500
                    let failover_ms = if half_ms >= 2000 { half_ms } else { 2000 }
                    if elapsed_ms >= failover_ms
                        && !ctx.submitted
                        && !failover_started
                        && ctx.config.node_id == backup_leader {
                        failover_started = true
                        eprintln!(
                            "node ",
                            ctx.config.node_id,
                            " failover submitting round ",
                            ctx.round_id,
                        )
                        telemetry
                            .set_phase(
                                round_id: ctx.round_id,
                                phase: "failover_submitting".span(),
                                local_prices: ctx.local_prices,
                                group_medians: ctx.group_medians,
                                round_ts: ctx.round_ts,
                            )
                        submit_started_ms = sched.now_ms()
                        failover_submit = Option::Some(
                            SubmitMediansCoro::start(
                                rpc_addr: ctx.config.rpc_addr,
                                rpc_path: ctx.config.rpc_path.span(),
                                privkey32: ctx.config.privkey32.span(),
                                from_0x: ctx.config.self_addr_0x.span(),
                                chain_id: ctx.config.chain_id,
                                contract20: ctx.config.contract20.span(),
                                round_id: ctx.round_id,
                                prices: ctx.group_medians,
                                timestamp: ctx.round_ts,
                                sigs: ctx.sorted_sigs,
                            ),
                        )
                    }
                    let timed_out = match deadline.poll() {
                        Poll::Ready(_) => true,
                        Poll::Pending => elapsed_ms >= ctx.config.round_timeout_secs * 2000,
                    }
                    if timed_out {
                        eprintln!(
                            "node ",
                            ctx.config.node_id,
                            " round ",
                            ctx.round_id,
                            " did not confirm within timeout",
                        )
                        telemetry
                            .set_phase(
                                round_id: ctx.round_id,
                                phase: "timeout_settle".span(),
                                local_prices: ctx.local_prices,
                                group_medians: ctx.group_medians,
                                round_ts: ctx.round_ts,
                            )
                        ctx.completed_rounds += 1
                        StepAction::Transition(ctx.next_round_state())
                    } else {
                        StepAction::Stay
                    }
                }
            },
        }

        match action {
            StepAction::Stay => Poll::Pending,
            StepAction::Finish(code) => Poll::Ready(code),
            StepAction::Transition(next) => {
                self.transition(next)
                match self.state {
                    ConsensusState::Done(code) => Poll::Ready(code),
                    _ => Poll::Pending,
                }
            },
        }
    }
}
