use std::io::{Stderr, Stdout}
use std::net::Net
use std::time::Clock
use coro::{Poll, Scheduler, Sleep}
use feracle_core::{NODE_COUNT, QUORUM}
use net_reactor::SocketIo
use super::config::NodeConfig
use super::consensus_state::{
    ConsensusState,
    RoundContext,
    StepAction,
    cancel_state,
    emit_feed_reports,
    opt_sleep_ready,
    quote_routing_for,
    zero_sig,
}
use super::feeds::{FetchFeedsCoro}
use super::crypto::Crypto
use super::network::PeerMesh
use super::round_io::{OracleAuthCache}
use super::rpc::{QueryCurrentRound, QueryRoundState}
use super::submit::{SubmitMediansCoro}
use super::telemetry::{TelemetrySink}

pub struct ConsensusCoro { ctx: RoundContext, state: ConsensusState }

impl ConsensusCoro {
    pub fn new(config: own NodeConfig) -> Self uses (sched: mut Scheduler) {
        let owner = sched.alloc_task()
        let now_ms = sched.now_ms()
        let auth_cache = OracleAuthCache::new(
            self_addr20: config.self_addr20,
            rpc_addr: config.rpc_addr,
            rpc_path: MemBuffer::from_span(config.rpc_path.span()),
            contract_0x: MemBuffer::from_span(config.contract_0x.span()),
        )
        let ctx = RoundContext {
            owner,
            config,
            auth_cache,
            pending_quotes: MemVec::new(),
            pending_sigs: MemVec::new(),
            scratch: MemBuffer::with_capacity(512),
            completed_rounds: 0,
            fallback_round: 1,
            round_id: 1,
            last_updated: 0,
            local_prices: [0; 20],
            local_ts: 0,
            group_medians: [0; 20],
            round_ts: 0,
            quotes: MemVec::new(),
            quote_frame: MemBuffer::empty(),
            sigs: MemVec::new(),
            sorted_sigs: [zero_sig(); 3],
            sig_frame: MemBuffer::empty(),
            submitted: false,
        }
        let state = ConsensusState::MeshWarmup {
            started_ms: now_ms,
            tick: Sleep::after(owner, delay_ms: 50),
        }
        ConsensusCoro { ctx, state }
    }

    pub fn round_id(self) -> u64 {
        self.ctx.round_id
    }

    pub fn completed_rounds(self) -> u64 {
        self.ctx.completed_rounds
    }

    fn transition(mut self, _ next: own ConsensusState)
    uses (net: mut Net, crypto: Crypto, sched: mut Scheduler, io: mut SocketIo)
    {
        cancel_state(mut self.state)
        self.state = next
    }

    pub fn cancel(mut self)
    uses (net: mut Net, crypto: Crypto, sched: mut Scheduler, io: mut SocketIo)
    {
        self.transition(ConsensusState::Done(0))
        self.ctx.auth_cache.cancel()
        sched.cancel_owner_timers(self.ctx.owner)
        io.deregister_owner(self.ctx.owner)
    }

    pub fn poll<M: PeerMesh>(mut self, _ peer: mut M, _ telemetry: mut TelemetrySink) -> Poll<i32>
    uses (
        net: mut Net,
        clock: Clock,
        crypto: Crypto,
        out: mut Stdout,
        err: mut Stderr,
        sched: mut Scheduler,
        io: mut SocketIo,
    )
    {
        if let ConsensusState::Done(code) = self.state {
            return Poll::Ready(code)
        }

        let (quote_routing, accept_sigs) = quote_routing_for(ref self.state)
        self.ctx.drain_inbox(quote_routing, accept_sigs, mut peer, mut telemetry)

        let ctx = mut self.ctx
        let action = match self.state {
            ConsensusState::Done(code) => StepAction::Finish(code),
            ConsensusState::MeshWarmup { started_ms, mut tick } => {
                let peers = peer.peer_count()
                let elapsed_ms = sched.now_ms() - started_ms
                if peers >= 3
                    || (elapsed_ms >= 2000 && peers >= 2)
                    || (elapsed_ms >= 6000 && peers >= 1)
                    || elapsed_ms >= 15000 {
                    println!(
                        "node ",
                        ctx.config.node_id,
                        " mesh ready with peer_count=",
                        peers,
                    )
                    StepAction::Transition(ctx.next_round_state())
                } else {
                    if let Poll::Ready(_) = tick.poll() {
                        tick = Sleep::after(owner: ctx.owner, delay_ms: 50)
                    }
                    StepAction::Stay
                }
            },
            ConsensusState::QueryRoundState { mut query } => {
                if let Poll::Ready(rs) = query.poll() {
                    ctx.round_id = match rs.round_id {
                        Option::Some(r) => r,
                        Option::None => {
                            eprintln!(
                                "node ",
                                ctx.config.node_id,
                                " warning: failed to query currentRound, using fallback=",
                                ctx.fallback_round,
                            )
                            ctx.fallback_round
                        },
                    }
                    ctx.last_updated = rs.last_updated
                    if clock.now().as_secs() <= ctx.last_updated {
                        StepAction::Transition(
                            ConsensusState::WaitNextSec {
                                sleep: Sleep::after(owner: ctx.owner, delay_ms: 100),
                            },
                        )
                    } else {
                        StepAction::Transition(ctx.begin_fetching_state(mut telemetry))
                    }
                } else {
                    StepAction::Stay
                }
            },
            ConsensusState::WaitNextSec { mut sleep } => {
                if clock.now().as_secs() > ctx.last_updated {
                    StepAction::Transition(ctx.begin_fetching_state(mut telemetry))
                } else {
                    if let Poll::Ready(_) = sleep.poll() {
                        sleep = Sleep::after(owner: ctx.owner, delay_ms: 100)
                    }
                    StepAction::Stay
                }
            },
            ConsensusState::FetchingFeeds { try_idx, mut fetcher } => {
                if let Poll::Ready(outcome) = fetcher.poll() {
                    if let Option::Some(prices) = outcome.medians {
                        emit_feed_reports(outcome.reports, mut telemetry)
                        StepAction::Transition(
                            ctx.enter_phase_a_state(prices, mut peer, mut telemetry),
                        )
                    } else {
                        let next_try = try_idx + 1
                        if next_try < 3 {
                            StepAction::Transition(
                                ConsensusState::FeedRetryDelay {
                                    next_try_idx: next_try,
                                    sleep: Sleep::after(owner: ctx.owner, delay_ms: 500),
                                },
                            )
                        } else {
                            let zero_prices: [u64; 20] = [0; 20]
                            emit_feed_reports(outcome.reports, mut telemetry)
                            eprintln!(
                                "node ",
                                ctx.config.node_id,
                                " round ",
                                ctx.round_id,
                                " error: incomplete price feeds for 20-asset basket",
                            )
                            telemetry
                                .set_phase(
                                    round_id: ctx.round_id,
                                    phase: "feed_error".span(),
                                    local_prices: zero_prices,
                                    group_medians: zero_prices,
                                    round_ts: 0,
                                )
                            ctx.completed_rounds += 1
                            StepAction::Transition(
                                ConsensusState::FeedErrorCooldown {
                                    sleep: Sleep::after(owner: ctx.owner, delay_ms: 1000),
                                },
                            )
                        }
                    }
                } else {
                    StepAction::Stay
                }
            },
            ConsensusState::FeedRetryDelay { next_try_idx, mut sleep } => {
                if let Poll::Ready(_) = sleep.poll() {
                    StepAction::Transition(
                        ConsensusState::FetchingFeeds {
                            try_idx: next_try_idx,
                            fetcher: FetchFeedsCoro::start(ctx.config.sources.as_slice()),
                        },
                    )
                } else {
                    StepAction::Stay
                }
            },
            ConsensusState::FeedErrorCooldown { mut sleep } => {
                if let Poll::Ready(_) = sleep.poll() {
                    StepAction::Transition(ctx.next_round_state())
                } else {
                    StepAction::Stay
                }
            },
            ConsensusState::PhaseAQuotes {
                started_ms: _,
                mut deadline,
                mut pub_sleep,
                mut quorum_grace,
            } => {
                let full_nodes: usize = NODE_COUNT.downcast_unchecked()
                var proceed = ctx.quotes.len() >= full_nodes
                if !proceed && ctx.quotes.len() >= QUORUM {
                    if let Option::Some(mut gs) = quorum_grace {
                        if let Poll::Ready(_) = gs.poll() {
                            quorum_grace = Option::None
                            proceed = true
                        }
                    } else {
                        quorum_grace = Option::Some(Sleep::after(owner: ctx.owner, delay_ms: 2000))
                    }
                }
                if proceed {
                    StepAction::Transition(ctx.enter_phase_b_state(mut peer, mut telemetry))
                } else if let Poll::Ready(_) = deadline.poll() {
                    let zero_prices: [u64; 20] = [0; 20]
                    eprintln!(
                        "node ",
                        ctx.config.node_id,
                        " round ",
                        ctx.round_id,
                        " timed out in Phase A with ",
                        ctx.quotes.len(),
                        " quotes",
                    )
                    telemetry
                        .set_phase(
                            round_id: ctx.round_id,
                            phase: "timeout_phase_a".span(),
                            local_prices: ctx.local_prices,
                            group_medians: zero_prices,
                            round_ts: ctx.local_ts,
                        )
                    ctx.completed_rounds += 1
                    StepAction::Transition(ctx.next_round_state())
                } else {
                    ctx.step_rebroadcast(use_quote: true, mut pub_sleep, mut peer, mut telemetry)
                    StepAction::Stay
                }
            },
            ConsensusState::ToleranceBreachWait {
                mut deadline,
                mut rpc_sleep,
                mut round_query,
            } => {
                var advanced_round = false
                if let Option::Some(mut q) = round_query {
                    if let Poll::Ready(next_round_opt) = q.poll() {
                        round_query = Option::None
                        if let Option::Some(r) = next_round_opt {
                            if r > ctx.round_id {
                                ctx.fallback_round = r
                                ctx.completed_rounds += 1
                                advanced_round = true
                            }
                        }
                        if !advanced_round {
                            rpc_sleep = Option::Some(Sleep::after(owner: ctx.owner, delay_ms: 150))
                        }
                    }
                }
                if advanced_round {
                    StepAction::Transition(ctx.next_round_state())
                } else {
                    if round_query.is_none() && opt_sleep_ready(mut rpc_sleep) {
                        round_query = Option::Some(
                            QueryCurrentRound::start(
                                rpc_addr: ctx.config.rpc_addr,
                                rpc_path: ctx.config.rpc_path.span(),
                                contract_0x: ctx.config.contract_0x.span(),
                            ),
                        )
                    }
                    if let Poll::Ready(_) = deadline.poll() {
                        ctx.completed_rounds += 1
                        StepAction::Transition(ctx.next_round_state())
                    } else {
                        StepAction::Stay
                    }
                }
            },
            ConsensusState::PhaseCSigs { started_ms: _, mut deadline, mut pub_sleep } => {
                if ctx.sigs.len() >= QUORUM {
                    StepAction::Transition(ctx.enter_submit_or_settle_state(mut telemetry))
                } else if let Poll::Ready(_) = deadline.poll() {
                    eprintln!(
                        "node ",
                        ctx.config.node_id,
                        " round ",
                        ctx.round_id,
                        " timed out in Phase C with ",
                        ctx.sigs.len(),
                        " sigs",
                    )
                    telemetry
                        .set_phase(
                            round_id: ctx.round_id,
                            phase: "timeout_phase_c".span(),
                            local_prices: ctx.local_prices,
                            group_medians: ctx.group_medians,
                            round_ts: ctx.round_ts,
                        )
                    ctx.completed_rounds += 1
                    StepAction::Transition(ctx.next_round_state())
                } else {
                    ctx.step_rebroadcast(use_quote: false, mut pub_sleep, mut peer, mut telemetry)
                    StepAction::Stay
                }
            },
            ConsensusState::PrimarySubmitting {
                started_ms: _,
                submit_started_ms,
                mut submit,
                mut pub_sleep,
            } => {
                ctx.step_rebroadcast(use_quote: false, mut pub_sleep, mut peer, mut telemetry)
                if let Poll::Ready(res) = submit.poll() {
                    ctx.submitted = ctx.handle_submit_outcome(res, submit_started_ms, mut telemetry)
                    StepAction::Transition(ctx.enter_settling_state(mut telemetry))
                } else {
                    StepAction::Stay
                }
            },
            ConsensusState::Settling {
                started_ms,
                mut deadline,
                mut pub_sleep,
                mut rpc_sleep,
                mut round_query,
                mut failover_submit,
                mut submit_started_ms,
                mut failover_started,
                backup_leader,
            } => {
                ctx.step_rebroadcast(use_quote: false, mut pub_sleep, mut peer, mut telemetry)
                if let Option::Some(mut fb) = failover_submit {
                    if let Poll::Ready(res) = fb.poll() {
                        failover_submit = Option::None
                        ctx.submitted = ctx
                            .handle_submit_outcome(res, submit_started_ms, mut telemetry)
                    }
                }
                var settled_onchain = false
                if let Option::Some(mut q) = round_query {
                    if let Poll::Ready(onchain_opt) = q.poll() {
                        round_query = Option::None
                        if let Option::Some(onchain_round) = onchain_opt {
                            if onchain_round > ctx.round_id {
                                ctx.fallback_round = onchain_round
                                println!(
                                    "node ",
                                    ctx.config.node_id,
                                    " confirmed round ",
                                    ctx.round_id,
                                    " settled on-chain",
                                )
                                telemetry
                                    .set_phase(
                                        round_id: ctx.round_id,
                                        phase: "settled".span(),
                                        local_prices: ctx.local_prices,
                                        group_medians: ctx.group_medians,
                                        round_ts: ctx.round_ts,
                                    )
                                ctx.completed_rounds += 1
                                settled_onchain = true
                            }
                        }
                        if !settled_onchain {
                            rpc_sleep = Option::Some(Sleep::after(owner: ctx.owner, delay_ms: 150))
                        }
                    }
                }
                if settled_onchain {
                    StepAction::Transition(ctx.next_round_state())
                } else {
                    if round_query.is_none() && opt_sleep_ready(mut rpc_sleep) {
                        round_query = Option::Some(
                            QueryCurrentRound::start(
                                rpc_addr: ctx.config.rpc_addr,
                                rpc_path: ctx.config.rpc_path.span(),
                                contract_0x: ctx.config.contract_0x.span(),
                            ),
                        )
                    }
                    let elapsed_ms = sched.now_ms() - started_ms
                    let half_ms = ctx.config.round_timeout_secs * 500
                    let failover_ms = if half_ms >= 2000 { half_ms } else { 2000 }
                    if elapsed_ms >= failover_ms
                        && !ctx.submitted
                        && !failover_started
                        && ctx.config.node_id == backup_leader {
                        failover_started = true
                        eprintln!(
                            "node ",
                            ctx.config.node_id,
                            " failover submitting round ",
                            ctx.round_id,
                        )
                        telemetry
                            .set_phase(
                                round_id: ctx.round_id,
                                phase: "failover_submitting".span(),
                                local_prices: ctx.local_prices,
                                group_medians: ctx.group_medians,
                                round_ts: ctx.round_ts,
                            )
                        submit_started_ms = sched.now_ms()
                        failover_submit = Option::Some(
                            SubmitMediansCoro::start(
                                rpc_addr: ctx.config.rpc_addr,
                                rpc_path: ctx.config.rpc_path.span(),
                                privkey32: ctx.config.privkey32.span(),
                                from_0x: ctx.config.self_addr_0x.span(),
                                chain_id: ctx.config.chain_id,
                                contract20: ctx.config.contract20.span(),
                                round_id: ctx.round_id,
                                prices: ctx.group_medians,
                                timestamp: ctx.round_ts,
                                sigs: ctx.sorted_sigs,
                            ),
                        )
                    }
                    let timed_out = match deadline.poll() {
                        Poll::Ready(_) => true,
                        Poll::Pending => elapsed_ms >= ctx.config.round_timeout_secs * 2000,
                    }
                    if timed_out {
                        eprintln!(
                            "node ",
                            ctx.config.node_id,
                            " round ",
                            ctx.round_id,
                            " did not confirm within timeout",
                        )
                        telemetry
                            .set_phase(
                                round_id: ctx.round_id,
                                phase: "timeout_settle".span(),
                                local_prices: ctx.local_prices,
                                group_medians: ctx.group_medians,
                                round_ts: ctx.round_ts,
                            )
                        ctx.completed_rounds += 1
                        StepAction::Transition(ctx.next_round_state())
                    } else {
                        StepAction::Stay
                    }
                }
            },
        }

        match action {
            StepAction::Stay => Poll::Pending,
            StepAction::Finish(code) => Poll::Ready(code),
            StepAction::Transition(next) => {
                self.transition(next)
                match self.state {
                    ConsensusState::Done(code) => Poll::Ready(code),
                    _ => Poll::Pending,
                }
            },
        }
    }
}
