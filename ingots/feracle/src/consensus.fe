use core::num::IntDowncast
use std::io::{Stderr, Stdout}
use std::net::Net
use std::time::Clock
use coro::{Coroutine, Poll, Scheduler, Sleep, TaskId}
use feracle_core::{
    MAX_TOLERANCE_BPS,
    NODE_COUNT,
    QuoteMsg,
    SigMsg,
    add_sig_dedup,
    encode_quote_buf,
    encode_sig_msg_buf,
    first_tolerance_breach_asset,
    leader_index,
    median_prices_3,
    median_u64,
    prices_eq,
    sort_three_sigs,
    write_asset_symbol,
}
use net_reactor::SocketIo
use super::config::NodeConfig
use super::feeds::{FeedReport, FetchFeedsCoro, feed_kind_name}
use super::ffi
use super::network::PeerSession
use super::round_io::{QuoteRouting, SourcedQuote, add_quote_dedup, poll_all_messages}
use super::rpc::{QueryCurrentRound, QueryRoundState}
use super::submit::{SubmitMediansCoro, SubmitOutcome}
use super::telemetry::TelemetrySink

enum ConsensusState {
    MeshWarmup,
    QueryRoundState,
    WaitNextSec,
    FetchingFeeds,
    FeedRetryDelay,
    FeedErrorCooldown,
    PhaseAQuotes,
    ToleranceBreachWait,
    PhaseCSigs,
    PrimarySubmitting,
    Settling,
    Done(i32),
}

pub struct ConsensusCoro {
    owner: TaskId,
    config: NodeConfig,
    state: ConsensusState,
    pending_quotes: MemVec<SourcedQuote>,
    pending_sigs: MemVec<SigMsg>,
    scratch: MemBuffer,
    completed_rounds: u64,
    fallback_round: u64,
    round_id: u64,
    last_updated: u64,
    local_prices: [u64; 20],
    local_ts: u64,
    group_medians: [u64; 20],
    round_ts: u64,
    quotes: MemVec<SourcedQuote>,
    quote_frame: MemBuffer,
    sigs: MemVec<SigMsg>,
    sorted_sigs: [SigMsg; 3],
    sig_frame: MemBuffer,
    submitted: bool,
    failover_started: bool,
    backup_leader: u64,
    fetch_try: usize,
    phase_started_ms: u64,
    submit_started_ms: u64,
    phase_sleep: Option<Sleep>,
    pub_sleep: Option<Sleep>,
    rpc_sleep: Option<Sleep>,
    round_state_coro: Option<QueryRoundState>,
    round_query_coro: Option<QueryCurrentRound>,
    fetch_coro: Option<FetchFeedsCoro>,
    submit_coro: Option<SubmitMediansCoro>,
}

fn zero_sig() -> SigMsg {
    SigMsg {
        round_id: 0,
        timestamp: 0,
        median_prices: [0; 20],
        signer_addr: [0; 20],
        v: 0,
        r: [0; 32],
        s: [0; 32],
    }
}

fn emit_feed_reports(_ reports: MemVec<FeedReport>, _ telemetry: mut TelemetrySink)
uses (err: mut Stderr)
{
    var i: usize = 0
    while i < reports.len() {
        let rep = reports[i]
        if !rep.ok {
            eprintln!(
                "warning: failed to fetch feed source index=",
                i,
                " addr=",
                rep.addr,
            )
        }
        if i < 8 {
            let provider_buf = feed_kind_name(rep.kind)
            let addr_buf = format!(rep.addr)
            telemetry
                .set_feed(
                    slot: i.downcast_unchecked(),
                    provider: provider_buf.span(),
                    addr: addr_buf.span(),
                    price: rep.price,
                    assets_ok: rep.assets_ok,
                    ok: rep.ok,
                    latency_ms: rep.latency_ms,
                )
        }
        i += 1
    }
}

fn sleep_ready(_ slot: mut Option<Sleep>) -> bool uses (sched: mut Scheduler) {
    if let Option::Some(mut s) = slot {
        if let Poll::Ready(_) = s.poll() {
            slot = Option::None
            return true
        }
    }
    false
}

fn cancel_sleep(_ slot: mut Option<Sleep>) uses (sched: mut Scheduler) {
    if let Option::Some(mut s) = slot {
        s.cancel()
        slot = Option::None
    }
}

impl ConsensusCoro {
    pub fn new(config: own NodeConfig) -> Self uses (sched: mut Scheduler) {
        let owner = sched.alloc_task()
        let now_ms = sched.now_ms()
        let tick = Sleep::after(owner, delay_ms: 50)
        ConsensusCoro {
            owner,
            config,
            state: ConsensusState::MeshWarmup,
            pending_quotes: MemVec::new(),
            pending_sigs: MemVec::new(),
            scratch: MemBuffer::with_capacity(512),
            completed_rounds: 0,
            fallback_round: 1,
            round_id: 1,
            last_updated: 0,
            local_prices: [0; 20],
            local_ts: 0,
            group_medians: [0; 20],
            round_ts: 0,
            quotes: MemVec::new(),
            quote_frame: MemBuffer::empty(),
            sigs: MemVec::new(),
            sorted_sigs: [zero_sig(); 3],
            sig_frame: MemBuffer::empty(),
            submitted: false,
            failover_started: false,
            backup_leader: 0,
            fetch_try: 0,
            phase_started_ms: now_ms,
            submit_started_ms: 0,
            phase_sleep: Option::None,
            pub_sleep: Option::None,
            rpc_sleep: Option::Some(tick),
            round_state_coro: Option::None,
            round_query_coro: Option::None,
            fetch_coro: Option::None,
            submit_coro: Option::None,
        }
    }

    fn cancel_children(mut self)
    uses (net: mut Net, sched: mut Scheduler, io: mut SocketIo)
    {
        cancel_sleep(mut self.phase_sleep)
        cancel_sleep(mut self.pub_sleep)
        cancel_sleep(mut self.rpc_sleep)
        if let Option::Some(mut c) = self.round_state_coro {
            c.cancel()
        }
        if let Option::Some(mut c) = self.round_query_coro {
            c.cancel()
        }
        if let Option::Some(mut c) = self.fetch_coro {
            c.cancel()
        }
        if let Option::Some(mut c) = self.submit_coro {
            c.cancel()
        }
        self.round_state_coro = Option::None
        self.round_query_coro = Option::None
        self.fetch_coro = Option::None
        self.submit_coro = Option::None
    }

    pub fn cancel(mut self)
    uses (net: mut Net, sched: mut Scheduler, io: mut SocketIo)
    {
        self.cancel_children()
        sched.cancel_owner_timers(self.owner)
        io.deregister_owner(self.owner)
        self.state = ConsensusState::Done(0)
    }

    fn drain_inbox(mut self, _ peer: mut PeerSession, _ telemetry: mut TelemetrySink)
    uses (clock: Clock, sched: mut Scheduler, io: mut SocketIo)
    {
        let quote_routing = match self.state {
            ConsensusState::PhaseAQuotes => QuoteRouting::AcceptCurrent,
            ConsensusState::ToleranceBreachWait => QuoteRouting::IgnoreCurrent,
            ConsensusState::PhaseCSigs => QuoteRouting::IgnoreCurrent,
            ConsensusState::PrimarySubmitting => QuoteRouting::IgnoreCurrent,
            ConsensusState::Settling => QuoteRouting::IgnoreCurrent,
            _ => QuoteRouting::BufferPending,
        }
        let accept_sigs = match self.state {
            ConsensusState::PhaseCSigs => true,
            ConsensusState::PrimarySubmitting => true,
            ConsensusState::Settling => true,
            _ => false,
        }
        poll_all_messages(
            mut peer,
            mut telemetry,
            round_id: self.round_id,
            quote_routing,
            mut self.quotes,
            mut self.pending_quotes,
            mut self.sigs,
            mut self.pending_sigs,
            accept_sigs,
            expected_prices: self.group_medians,
            expected_ts: self.round_ts,
            mut self.scratch,
        )
    }

    fn step_rebroadcast(
        mut self,
        use_quote: bool,
        _ peer: mut PeerSession,
        _ telemetry: mut TelemetrySink,
    )
    uses (net: mut Net, clock: Clock, sched: mut Scheduler, io: mut SocketIo)
    {
        if sleep_ready(mut self.pub_sleep) {
            if use_quote {
                let _ = peer.publish(self.quote_frame.span(), mut telemetry)
            } else {
                let _ = peer.publish(self.sig_frame.span(), mut telemetry)
            }
            self.pub_sleep = Option::Some(Sleep::after(owner: self.owner, delay_ms: 2000))
        }
    }

    fn start_round(mut self)
    uses (net: mut Net, sched: mut Scheduler, io: mut SocketIo)
    {
        self.cancel_children()
        if self.config.rounds > 0 && self.completed_rounds >= self.config.rounds {
            sched.cancel_owner_timers(self.owner)
            io.deregister_owner(self.owner)
            self.state = ConsensusState::Done(0)
            return
        }
        self.round_id = self.fallback_round
        let round_state = QueryRoundState::start(
            rpc_addr: self.config.rpc_addr,
            rpc_path: self.config.rpc_path.span(),
            contract_0x: self.config.contract_0x.span(),
        )
        self.round_state_coro = Option::Some(round_state)
        self.state = ConsensusState::QueryRoundState
    }

    fn begin_fetching_feeds(mut self, _ telemetry: mut TelemetrySink)
    uses (net: mut Net, out: mut Stdout, sched: mut Scheduler, io: mut SocketIo)
    {
        let zero_prices: [u64; 20] = [0; 20]
        println!(
            "node ",
            self.config.node_id,
            " starting round ",
            self.round_id,
        )
        telemetry.record_event(kind: 4, value: 0)
        telemetry
            .set_phase(
                round_id: self.round_id,
                phase: "fetching".span(),
                local_prices: zero_prices,
                group_medians: zero_prices,
                round_ts: 0,
            )
        self.fetch_try = 0
        self.fetch_coro = Option::Some(FetchFeedsCoro::start(self.config.sources.as_slice()))
        self.state = ConsensusState::FetchingFeeds
    }

    fn enter_phase_a(
        mut self,
        _ prices: [u64; 20],
        _ peer: mut PeerSession,
        _ telemetry: mut TelemetrySink,
    )
    uses (
        net: mut Net,
        clock: Clock,
        out: mut Stdout,
        err: mut Stderr,
        sched: mut Scheduler,
        io: mut SocketIo,
    )
    {
        let zero_prices: [u64; 20] = [0; 20]
        self.local_prices = prices
        self.local_ts = clock.now().as_secs()
        println!(
            "node ",
            self.config.node_id,
            " round ",
            self.round_id,
            " local_btc=",
            self.local_prices[0],
            " eth=",
            self.local_prices[1],
            " ts=",
            self.local_ts,
        )
        telemetry
            .set_phase(
                round_id: self.round_id,
                phase: "phase_a_quotes".span(),
                local_prices: self.local_prices,
                group_medians: zero_prices,
                round_ts: self.local_ts,
            )

        let self_quote = QuoteMsg {
            round_id: self.round_id,
            timestamp: self.local_ts,
            prices: self.local_prices,
        }
        self.quotes = MemVec::new()
        self.quotes.push(SourcedQuote { origin: 0, quote: self_quote })

        var next_pending = MemVec<SourcedQuote>::new()
        var pq_i: usize = 0
        while pq_i < self.pending_quotes.len() {
            let sq = self.pending_quotes[pq_i]
            if sq.quote.round_id == self.round_id {
                add_quote_dedup(mut self.quotes, sq, max_len: 3)
            } else if sq.quote.round_id > self.round_id {
                add_quote_dedup(mut next_pending, sq, max_len: 0)
            }
            pq_i += 1
        }
        self.pending_quotes = next_pending

        self.quote_frame = encode_quote_buf(self_quote)
        let _ = peer.publish(self.quote_frame.span(), mut telemetry)

        if self.quotes.len() >= 3 {
            self.enter_phase_b(mut peer, mut telemetry)
            return
        }
        self.phase_sleep = Option::Some(
            Sleep::after(
                owner: self.owner,
                delay_ms: self.config.round_timeout_secs * 1000,
            ),
        )
        self.pub_sleep = Option::Some(Sleep::after(owner: self.owner, delay_ms: 2000))
        self.state = ConsensusState::PhaseAQuotes
    }

    fn enter_phase_b(mut self, _ peer: mut PeerSession, _ telemetry: mut TelemetrySink)
    uses (
        net: mut Net,
        clock: Clock,
        out: mut Stdout,
        err: mut Stderr,
        sched: mut Scheduler,
        io: mut SocketIo,
    )
    {
        self.cancel_children()
        self.group_medians = median_prices_3(
            self.quotes[0].quote.prices,
            self.quotes[1].quote.prices,
            self.quotes[2].quote.prices,
        )
        self.round_ts = median_u64(
            [
                self.quotes[0].quote.timestamp,
                self.quotes[1].quote.timestamp,
                self.quotes[2].quote.timestamp,
            ],
        )

        if let Option::Some(bad_idx) = first_tolerance_breach_asset(
            local: self.local_prices,
            proposed: self.group_medians,
            max_bps: MAX_TOLERANCE_BPS,
        ) {
            var sym = MemBuffer::empty()
            write_asset_symbol(bad_idx, mut sym)
            eprintln!(
                "node ",
                self.config.node_id,
                " round ",
                self.round_id,
                " tolerance guard breached on ",
                sym,
                " (asset=",
                bad_idx,
                "): local=",
                self.local_prices[bad_idx],
                " proposed=",
                self.group_medians[bad_idx],
            )
            telemetry.record_event(kind: 1, value: bad_idx.downcast_unchecked())
            telemetry
                .set_phase(
                    round_id: self.round_id,
                    phase: "tolerance_breach".span(),
                    local_prices: self.local_prices,
                    group_medians: self.group_medians,
                    round_ts: self.round_ts,
                )
            self.phase_sleep = Option::Some(
                Sleep::after(
                    owner: self.owner,
                    delay_ms: self.config.round_timeout_secs * 1000,
                ),
            )
            self.round_query_coro = Option::Some(
                QueryCurrentRound::start(
                    rpc_addr: self.config.rpc_addr,
                    rpc_path: self.config.rpc_path.span(),
                    contract_0x: self.config.contract_0x.span(),
                ),
            )
            self.state = ConsensusState::ToleranceBreachWait
            return
        }

        let self_sig = match ffi::sign_digest(
            privkey32: self.config.privkey32.span(),
            chain_id: self.config.chain_id,
            contract20: self.config.contract20.span(),
            round_id: self.round_id,
            prices: self.group_medians,
            timestamp: self.round_ts,
        ) {
            Option::Some(s) => s,
            Option::None => {
                eprintln!(
                    "node ",
                    self.config.node_id,
                    " round ",
                    self.round_id,
                    " failed to sign digest",
                )
                self.completed_rounds += 1
                self.start_round()
                return
            },
        }

        self.sigs = MemVec::new()
        add_sig_dedup(mut self.sigs, self_sig)
        var next_pending = MemVec<SigMsg>::new()
        var ps_i: usize = 0
        while ps_i < self.pending_sigs.len() {
            let s = self.pending_sigs[ps_i]
            if s.round_id == self.round_id
                && prices_eq(s.median_prices, self.group_medians)
                && s.timestamp == self.round_ts {
                add_sig_dedup(mut self.sigs, s)
            } else if s.round_id > self.round_id {
                add_sig_dedup(mut next_pending, s)
            }
            ps_i += 1
        }
        self.pending_sigs = next_pending

        self.sig_frame = encode_sig_msg_buf(self_sig)
        let _ = peer.publish(self.sig_frame.span(), mut telemetry)
        telemetry
            .set_phase(
                round_id: self.round_id,
                phase: "phase_c_sigs".span(),
                local_prices: self.local_prices,
                group_medians: self.group_medians,
                round_ts: self.round_ts,
            )

        if self.sigs.len() >= 3 {
            self.enter_submit_or_settle(mut telemetry)
            return
        }
        self.phase_sleep = Option::Some(
            Sleep::after(
                owner: self.owner,
                delay_ms: self.config.round_timeout_secs * 1000,
            ),
        )
        self.pub_sleep = Option::Some(Sleep::after(owner: self.owner, delay_ms: 2000))
        self.state = ConsensusState::PhaseCSigs
    }

    fn enter_submit_or_settle(mut self, _ telemetry: mut TelemetrySink)
    uses (net: mut Net, out: mut Stdout, sched: mut Scheduler, io: mut SocketIo)
    {
        self.cancel_children()
        self.sorted_sigs = sort_three_sigs([self.sigs[0], self.sigs[1], self.sigs[2]])
        let primary_leader = leader_index(round_id: self.round_id, node_count: NODE_COUNT)
        self.backup_leader = leader_index(round_id: self.round_id + 1, node_count: NODE_COUNT)
        self.submitted = false
        self.failover_started = false
        self.pub_sleep = Option::Some(Sleep::after(owner: self.owner, delay_ms: 2000))

        if self.config.node_id == primary_leader {
            println!(
                "node ",
                self.config.node_id,
                " is leader for round ",
                self.round_id,
                ", submitting 20 medians btc=",
                self.group_medians[0],
            )
            telemetry
                .set_phase(
                    round_id: self.round_id,
                    phase: "submitting".span(),
                    local_prices: self.local_prices,
                    group_medians: self.group_medians,
                    round_ts: self.round_ts,
                )
            self.submit_started_ms = sched.now_ms()
            self.submit_coro = Option::Some(
                SubmitMediansCoro::start(
                    rpc_addr: self.config.rpc_addr,
                    rpc_path: self.config.rpc_path.span(),
                    privkey32: self.config.privkey32.span(),
                    chain_id: self.config.chain_id,
                    contract20: self.config.contract20.span(),
                    round_id: self.round_id,
                    prices: self.group_medians,
                    timestamp: self.round_ts,
                    sigs: self.sorted_sigs,
                ),
            )
            self.state = ConsensusState::PrimarySubmitting
        } else {
            println!(
                "node ",
                self.config.node_id,
                " waiting for leader ",
                primary_leader,
                " to settle round ",
                self.round_id,
            )
            self.enter_settling(mut telemetry)
        }
    }

    fn enter_settling(mut self, _ telemetry: mut TelemetrySink)
    uses (net: mut Net, sched: mut Scheduler, io: mut SocketIo)
    {
        telemetry
            .set_phase(
                round_id: self.round_id,
                phase: "settling".span(),
                local_prices: self.local_prices,
                group_medians: self.group_medians,
                round_ts: self.round_ts,
            )
        self.phase_started_ms = sched.now_ms()
        self.phase_sleep = Option::Some(
            Sleep::after(
                owner: self.owner,
                delay_ms: self.config.round_timeout_secs * 2000,
            ),
        )
        self.round_query_coro = Option::Some(
            QueryCurrentRound::start(
                rpc_addr: self.config.rpc_addr,
                rpc_path: self.config.rpc_path.span(),
                contract_0x: self.config.contract_0x.span(),
            ),
        )
        self.state = ConsensusState::Settling
    }

    fn handle_submit_outcome(
        mut self,
        _ outcome: SubmitOutcome,
        _ telemetry: mut TelemetrySink,
    ) -> bool
    uses (out: mut Stdout, err: mut Stderr, sched: mut Scheduler, io: mut SocketIo)
    {
        let sub_ms = sched.now_ms() - self.submit_started_ms
        match outcome {
            SubmitOutcome::Confirmed(ok) => {
                println!(
                    "submitted round ",
                    ok.round_id,
                    " assets=20 btc=",
                    ok.btc_price,
                    " ts=",
                    ok.timestamp,
                )
                telemetry.record_event(kind: 2, value: sub_ms)
                true
            },
            SubmitOutcome::Failed(ref msg_buf) => {
                eprintln!(msg_buf)
                telemetry.record_event(kind: 3, value: sub_ms)
                false
            },
        }
    }

    pub fn poll(mut self, _ peer: mut PeerSession, _ telemetry: mut TelemetrySink) -> Poll<i32>
    uses (
        net: mut Net,
        clock: Clock,
        out: mut Stdout,
        err: mut Stderr,
        sched: mut Scheduler,
        io: mut SocketIo,
    )
    {
        if let ConsensusState::Done(code) = self.state {
            return Poll::Ready(code)
        }

        if let ConsensusState::MeshWarmup = self.state {
            let peers = peer.peer_count()
            let elapsed_ms = sched.now_ms() - self.phase_started_ms
            if peers >= 2 || (elapsed_ms >= 5000 && peers >= 1) || elapsed_ms >= 15000 {
                println!(
                    "node ",
                    self.config.node_id,
                    " mesh ready with peer_count=",
                    peers,
                )
                self.start_round()
                if let ConsensusState::Done(code) = self.state {
                    return Poll::Ready(code)
                }
                return Poll::Pending
            }
            if sleep_ready(mut self.rpc_sleep) {
                self.rpc_sleep = Option::Some(Sleep::after(owner: self.owner, delay_ms: 50))
            }
            return Poll::Pending
        }

        self.drain_inbox(mut peer, mut telemetry)

        match self.state {
            ConsensusState::Done(code) => {
                return Poll::Ready(code)
            },
            ConsensusState::MeshWarmup => {},
            ConsensusState::QueryRoundState => {
                var ready: Option<(Option<u64>, u64)> = Option::None
                if let Option::Some(mut c) = self.round_state_coro {
                    if let Poll::Ready(rs) = c.poll() {
                        ready = Option::Some((rs.round_id, rs.last_updated))
                    }
                }
                if let Option::Some((round_opt, last_updated)) = ready {
                    self.round_state_coro = Option::None
                    self.round_id = match round_opt {
                        Option::Some(r) => r,
                        Option::None => {
                            eprintln!(
                                "node ",
                                self.config.node_id,
                                " warning: failed to query currentRound, using fallback=",
                                self.fallback_round,
                            )
                            self.fallback_round
                        },
                    }
                    self.last_updated = last_updated
                    if clock.now().as_secs() <= self.last_updated {
                        self.phase_sleep = Option::Some(
                            Sleep::after(owner: self.owner, delay_ms: 100),
                        )
                        self.state = ConsensusState::WaitNextSec
                    } else {
                        self.begin_fetching_feeds(mut telemetry)
                    }
                }
            },
            ConsensusState::WaitNextSec => {
                if clock.now().as_secs() > self.last_updated {
                    self.cancel_children()
                    self.begin_fetching_feeds(mut telemetry)
                } else if sleep_ready(mut self.phase_sleep) {
                    self.phase_sleep = Option::Some(Sleep::after(owner: self.owner, delay_ms: 100))
                }
            },
            ConsensusState::FetchingFeeds => {
                var medians_opt: Option<Option<[u64; 20]>> = Option::None
                var reports = MemVec<FeedReport>::new()
                if let Option::Some(mut c) = self.fetch_coro {
                    if let Poll::Ready(outcome) = c.poll() {
                        medians_opt = Option::Some(outcome.medians)
                        reports = outcome.reports
                    }
                }
                if let Option::Some(m_opt) = medians_opt {
                    self.fetch_coro = Option::None
                    if let Option::Some(prices) = m_opt {
                        emit_feed_reports(reports, mut telemetry)
                        self.enter_phase_a(prices, mut peer, mut telemetry)
                    } else {
                        self.fetch_try += 1
                        if self.fetch_try < 3 {
                            self.phase_sleep = Option::Some(
                                Sleep::after(owner: self.owner, delay_ms: 500),
                            )
                            self.state = ConsensusState::FeedRetryDelay
                        } else {
                            let zero_prices: [u64; 20] = [0; 20]
                            emit_feed_reports(reports, mut telemetry)
                            eprintln!(
                                "node ",
                                self.config.node_id,
                                " round ",
                                self.round_id,
                                " error: incomplete price feeds for 20-asset basket",
                            )
                            telemetry
                                .set_phase(
                                    round_id: self.round_id,
                                    phase: "feed_error".span(),
                                    local_prices: zero_prices,
                                    group_medians: zero_prices,
                                    round_ts: 0,
                                )
                            self.completed_rounds += 1
                            self.phase_sleep = Option::Some(
                                Sleep::after(owner: self.owner, delay_ms: 1000),
                            )
                            self.state = ConsensusState::FeedErrorCooldown
                        }
                    }
                }
            },
            ConsensusState::FeedRetryDelay => {
                if sleep_ready(mut self.phase_sleep) {
                    self.fetch_coro = Option::Some(
                        FetchFeedsCoro::start(self.config.sources.as_slice()),
                    )
                    self.state = ConsensusState::FetchingFeeds
                }
            },
            ConsensusState::FeedErrorCooldown => {
                if sleep_ready(mut self.phase_sleep) {
                    self.start_round()
                }
            },
            ConsensusState::PhaseAQuotes => {
                if self.quotes.len() >= 3 {
                    self.enter_phase_b(mut peer, mut telemetry)
                } else if sleep_ready(mut self.phase_sleep) {
                    let zero_prices: [u64; 20] = [0; 20]
                    self.cancel_children()
                    eprintln!(
                        "node ",
                        self.config.node_id,
                        " round ",
                        self.round_id,
                        " timed out in Phase A with ",
                        self.quotes.len(),
                        " quotes",
                    )
                    telemetry
                        .set_phase(
                            round_id: self.round_id,
                            phase: "timeout_phase_a".span(),
                            local_prices: self.local_prices,
                            group_medians: zero_prices,
                            round_ts: self.local_ts,
                        )
                    self.completed_rounds += 1
                    self.start_round()
                } else {
                    self.step_rebroadcast(use_quote: true, mut peer, mut telemetry)
                }
            },
            ConsensusState::ToleranceBreachWait => {
                var query_done = false
                var next_round_opt: Option<u64> = Option::None
                if let Option::Some(mut c) = self.round_query_coro {
                    if let Poll::Ready(r) = c.poll() {
                        query_done = true
                        next_round_opt = r
                    }
                }
                if query_done {
                    self.round_query_coro = Option::None
                    if let Option::Some(r) = next_round_opt {
                        if r > self.round_id {
                            self.fallback_round = r
                            self.cancel_children()
                            self.completed_rounds += 1
                            self.start_round()
                            return self.check_done()
                        }
                    }
                    self.rpc_sleep = Option::Some(Sleep::after(owner: self.owner, delay_ms: 150))
                }
                if self.round_query_coro.is_none() && sleep_ready(mut self.rpc_sleep) {
                    self.round_query_coro = Option::Some(
                        QueryCurrentRound::start(
                            rpc_addr: self.config.rpc_addr,
                            rpc_path: self.config.rpc_path.span(),
                            contract_0x: self.config.contract_0x.span(),
                        ),
                    )
                }
                if sleep_ready(mut self.phase_sleep) {
                    self.cancel_children()
                    self.completed_rounds += 1
                    self.start_round()
                }
            },
            ConsensusState::PhaseCSigs => {
                if self.sigs.len() >= 3 {
                    self.enter_submit_or_settle(mut telemetry)
                } else if sleep_ready(mut self.phase_sleep) {
                    self.cancel_children()
                    eprintln!(
                        "node ",
                        self.config.node_id,
                        " round ",
                        self.round_id,
                        " timed out in Phase C with ",
                        self.sigs.len(),
                        " sigs",
                    )
                    telemetry
                        .set_phase(
                            round_id: self.round_id,
                            phase: "timeout_phase_c".span(),
                            local_prices: self.local_prices,
                            group_medians: self.group_medians,
                            round_ts: self.round_ts,
                        )
                    self.completed_rounds += 1
                    self.start_round()
                } else {
                    self.step_rebroadcast(use_quote: false, mut peer, mut telemetry)
                }
            },
            ConsensusState::PrimarySubmitting => {
                self.step_rebroadcast(use_quote: false, mut peer, mut telemetry)
                var submit_done: Option<SubmitOutcome> = Option::None
                if let Option::Some(mut c) = self.submit_coro {
                    if let Poll::Ready(res) = c.poll() {
                        submit_done = Option::Some(res)
                    }
                }
                if let Option::Some(res) = submit_done {
                    self.submit_coro = Option::None
                    self.submitted = self.handle_submit_outcome(res, mut telemetry)
                    self.enter_settling(mut telemetry)
                }
            },
            ConsensusState::Settling => {
                self.step_rebroadcast(use_quote: false, mut peer, mut telemetry)

                var fb_done: Option<SubmitOutcome> = Option::None
                if let Option::Some(mut c) = self.submit_coro {
                    if let Poll::Ready(res) = c.poll() {
                        fb_done = Option::Some(res)
                    }
                }
                if let Option::Some(res) = fb_done {
                    self.submit_coro = Option::None
                    self.submitted = self.handle_submit_outcome(res, mut telemetry)
                }

                var query_done = false
                var onchain_opt: Option<u64> = Option::None
                if let Option::Some(mut c) = self.round_query_coro {
                    if let Poll::Ready(r) = c.poll() {
                        query_done = true
                        onchain_opt = r
                    }
                }
                if query_done {
                    self.round_query_coro = Option::None
                    if let Option::Some(onchain_round) = onchain_opt {
                        if onchain_round > self.round_id {
                            self.cancel_children()
                            self.fallback_round = onchain_round
                            println!(
                                "node ",
                                self.config.node_id,
                                " confirmed round ",
                                self.round_id,
                                " settled on-chain",
                            )
                            telemetry
                                .set_phase(
                                    round_id: self.round_id,
                                    phase: "settled".span(),
                                    local_prices: self.local_prices,
                                    group_medians: self.group_medians,
                                    round_ts: self.round_ts,
                                )
                            self.completed_rounds += 1
                            self.start_round()
                            return self.check_done()
                        }
                    }
                    self.rpc_sleep = Option::Some(Sleep::after(owner: self.owner, delay_ms: 150))
                }

                if self.round_query_coro.is_none() && sleep_ready(mut self.rpc_sleep) {
                    self.round_query_coro = Option::Some(
                        QueryCurrentRound::start(
                            rpc_addr: self.config.rpc_addr,
                            rpc_path: self.config.rpc_path.span(),
                            contract_0x: self.config.contract_0x.span(),
                        ),
                    )
                }

                let elapsed_ms = sched.now_ms() - self.phase_started_ms
                if elapsed_ms >= self.config.round_timeout_secs * 1000
                    && !self.submitted
                    && !self.failover_started
                    && self.config.node_id == self.backup_leader {
                    self.failover_started = true
                    eprintln!(
                        "node ",
                        self.config.node_id,
                        " failover submitting round ",
                        self.round_id,
                    )
                    telemetry
                        .set_phase(
                            round_id: self.round_id,
                            phase: "failover_submitting".span(),
                            local_prices: self.group_medians,
                            group_medians: self.group_medians,
                            round_ts: self.round_ts,
                        )
                    self.submit_started_ms = sched.now_ms()
                    self.submit_coro = Option::Some(
                        SubmitMediansCoro::start(
                            rpc_addr: self.config.rpc_addr,
                            rpc_path: self.config.rpc_path.span(),
                            privkey32: self.config.privkey32.span(),
                            chain_id: self.config.chain_id,
                            contract20: self.config.contract20.span(),
                            round_id: self.round_id,
                            prices: self.group_medians,
                            timestamp: self.round_ts,
                            sigs: self.sorted_sigs,
                        ),
                    )
                }

                if sleep_ready(mut self.phase_sleep)
                    || elapsed_ms >= self.config.round_timeout_secs * 2000 {
                    self.cancel_children()
                    eprintln!(
                        "node ",
                        self.config.node_id,
                        " round ",
                        self.round_id,
                        " did not confirm within timeout",
                    )
                    telemetry
                        .set_phase(
                            round_id: self.round_id,
                            phase: "timeout_settle".span(),
                            local_prices: self.local_prices,
                            group_medians: self.group_medians,
                            round_ts: self.round_ts,
                        )
                    self.completed_rounds += 1
                    self.start_round()
                }
            },
        }
        self.check_done()
    }

    fn check_done(self) -> Poll<i32> {
        match self.state {
            ConsensusState::Done(code) => Poll::Ready(code),
            _ => Poll::Pending,
        }
    }
}
