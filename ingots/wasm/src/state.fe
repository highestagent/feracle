use core::intrinsic::size_of
use core::num::IntDowncast
use core::ptr::{alloc, cast, dealloc, zero_bytes}
use feracle_core::{
    ASSET_COUNT,
    MAX_TOLERANCE_BPS,
    NODE_COUNT,
    addr20_eq,
    decode_quote,
    decode_sig_msg,
    first_tolerance_breach_asset,
    leader_index,
    median_prices_3,
    median_prices_4,
    median_u64,
    median_u64_4,
    prices_eq,
}
use super::codec::{
    FixedStr,
    build_rpc_batch_into,
    decode_hex_bytes,
    json_get_bool,
    json_get_raw,
    json_get_str_bounds,
    json_get_u64,
    json_next_array_elem,
    normalize_addr20_hex,
    parse_abi_word_addr20,
    parse_abi_word_bool,
    parse_abi_word_u64,
    parse_hex_addr20,
    parse_hex_u64,
    push_addr20_hex,
    signed_bps_diff,
    strip_0x_offset,
}

pub const MAX_ORACLES: usize = 4
pub const MAX_FEEDS_PER_NODE: usize = 4
pub const MAX_ROUNDS_HISTORY: usize = 32
pub const MAX_WIRE_SLOTS: usize = 16

pub struct FeedSnap {
    pub used: bool,
    pub provider: FixedStr<24>,
    pub addr: FixedStr<32>,
    pub price: u64,
    pub assets_ok: u32,
    pub ok: bool,
    pub latency_ms: u64,
}

impl Copy for FeedSnap {}

pub struct NodeSnap {
    pub evm_addr: FixedStr<48>,
    pub addr20: [u8; 20],
    pub has_evm_addr: bool,
    pub is_authorized_onchain: bool,
    pub auth_known: bool,
    pub online: bool,
    pub seen: bool,
    pub p2p_port: u16,
    pub peer_count: u32,
    pub round_id: u64,
    pub phase: FixedStr<32>,
    pub local_price: u64,
    pub group_median: u64,
    pub round_ts: u64,
    pub quotes_tx: u64,
    pub quotes_rx: u64,
    pub sigs_tx: u64,
    pub sigs_rx: u64,
    pub tolerance_breaches: u64,
    pub submissions_ok: u64,
    pub submissions_err: u64,
    pub last_submit_ms: u64,
    pub last_seen_ms: u64,
    pub feed_count: usize,
    pub feeds: [FeedSnap; 4],
}

impl Copy for NodeSnap {}

pub struct RoundSample {
    pub valid: bool,
    pub round_id: u64,
    pub prices: [u64; 20],
    pub timestamp: u64,
    pub block_number: u64,
    pub gas_used: u64,
    pub tx_count: u32,
    pub expected_leader_idx: u64,
    pub actual_leader_idx: i64,
    pub failover: bool,
    pub submitter: FixedStr<48>,
    pub delta_bps: i64,
}

impl Copy for RoundSample {}

pub struct WireQuoteSlot {
    pub used: bool,
    pub round_id: u64,
    pub prices: [u64; 20],
    pub timestamp: u64,
    pub signer_addr: [u8; 20],
    pub signer_hex: FixedStr<48>,
    pub rx_count: u32,
    pub first_seen_ms: u64,
    pub last_seen_ms: u64,
    pub peer_tag: FixedStr<64>,
    pub last_is_tx: bool,
}

impl Copy for WireQuoteSlot {}

pub struct WireSigSlot {
    pub used: bool,
    pub round_id: u64,
    pub median_prices: [u64; 20],
    pub timestamp: u64,
    pub signer_addr: [u8; 20],
    pub signer_hex: FixedStr<48>,
    pub v: u8,
    pub rx_count: u32,
    pub first_seen_ms: u64,
    pub peer_tag: FixedStr<64>,
}

impl Copy for WireSigSlot {}

pub struct OnChainSnap {
    pub connected: bool,
    pub chain_id: u64,
    pub block_number: u64,
    pub block_timestamp: u64,
    pub current_round: u64,
    pub latest_prices: [u64; 20],
    pub previous_prices: [u64; 20],
    pub last_deltas_bps: [i64; 20],
    pub last_updated: u64,
    pub rpc_latency_ms: u64,
    pub last_poll_ms: u64,
    pub total_rpc_polls: u64,
    pub rpc_errors: u64,
    pub last_tx_gas: u64,
    pub last_tx_failover: bool,
    pub tx_invariant_ok: bool,
    pub has_tx_data: bool,
    pub contract_addr: FixedStr<48>,
    pub owner: FixedStr<48>,
}

impl Copy for OnChainSnap {}

pub struct TelemetryEngine {
    pub onchain: OnChainSnap,
    pub oracle_count: usize,
    pub nodes: [NodeSnap; 4],
    pub rounds_head: usize,
    pub rounds_len: usize,
    pub rounds: [RoundSample; 32],
    pub active_wire_round: u64,
    pub wire_quote_count: usize,
    pub wire_quotes: [WireQuoteSlot; 16],
    pub wire_sig_count: usize,
    pub wire_sigs: [WireSigSlot; 16],
    pub wire_group_medians: [u64; 20],
    pub wire_round_ts: u64,
    pub wire_breach_detected: bool,
    pub wire_breach_asset: i64,
    pub total_wire_quotes_seen: u64,
    pub total_wire_sigs_seen: u64,
    pub total_wire_decode_errors: u64,
}

impl TelemetryEngine {
    pub fn alloc_new() -> *TelemetryEngine {
        let p = alloc<TelemetryEngine>()
        unsafe {
            zero_bytes(cast<TelemetryEngine, u8>(p), size_of<TelemetryEngine>())
            (*p).init_defaults()
        }
        p
    }

    pub unsafe fn free_ptr(_ p: *TelemetryEngine) {
        dealloc(p)
    }

    pub fn init_defaults(mut self) {
        self.onchain.tx_invariant_ok = true
        self.wire_breach_asset = -1
        var i: usize = 0
        while i < MAX_ROUNDS_HISTORY {
            self.rounds[i].actual_leader_idx = -1
            i += 1
        }
    }

    pub fn round_at(self, _ logical_idx: usize) -> RoundSample {
        let pos = (self.rounds_head + logical_idx) % MAX_ROUNDS_HISTORY
        self.rounds[pos]
    }

    fn round_storage_index(self, _ logical_idx: usize) -> usize {
        (self.rounds_head + logical_idx) % MAX_ROUNDS_HISTORY
    }

    fn find_round_logical_index(self, round_id: u64) -> Option<usize> {
        var i: usize = 0
        while i < self.rounds_len {
            if self.round_at(i).round_id == round_id {
                return Option::Some(i)
            }
            i += 1
        }
        Option::None
    }

    fn append_round_slot(mut self, sample: RoundSample) -> usize {
        if self.rounds_len < MAX_ROUNDS_HISTORY {
            let idx = (self.rounds_head + self.rounds_len) % MAX_ROUNDS_HISTORY
            self.rounds[idx] = sample
            self.rounds_len += 1
            return self.rounds_len - 1
        }
        let idx = self.rounds_head
        self.rounds[idx] = sample
        self.rounds_head = (self.rounds_head + 1) % MAX_ROUNDS_HISTORY
        self.rounds_len - 1
    }

    pub fn configure(mut self, contract_hex: MemSpan, oracles_csv: MemSpan) {
        var norm_contract = MemBuffer::empty()
        if normalize_addr20_hex(contract_hex, mut norm_contract) {
            self.onchain.contract_addr.set_from_span(norm_contract.span())
        } else {
            self.onchain.contract_addr.set_from_span(contract_hex.trim())
        }

        self.oracle_count = 0
        var n_idx: usize = 0
        while n_idx < MAX_ORACLES {
            self.nodes[n_idx].evm_addr.clear()
            self.nodes[n_idx].has_evm_addr = false
            self.nodes[n_idx].auth_known = false
            self.nodes[n_idx].is_authorized_onchain = false
            n_idx += 1
        }

        for part in oracles_csv.split(b',') {
            if self.oracle_count >= MAX_ORACLES {
                break
            }
            let entry = part.trim()
            if entry.is_empty() {
                continue
            }
            let idx = self.oracle_count
            if let Option::Some(addr20) = parse_hex_addr20(entry) {
                var norm = MemBuffer::empty()
                push_addr20_hex(addr20, mut norm)
                self.nodes[idx].evm_addr.set_from_span(norm.span())
                self.nodes[idx].addr20 = addr20
                self.nodes[idx].has_evm_addr = true
            } else {
                self.nodes[idx].evm_addr.set_from_span(entry)
                self.nodes[idx].has_evm_addr = false
            }
            self.oracle_count += 1
        }
    }

    pub fn build_rpc_batch(self, _ out: mut MemBuffer) {
        var contract_buf = MemBuffer::empty()
        self.onchain.contract_addr.write_to(mut contract_buf)
        let addrs: [FixedStr<48>; 4] = [
            self.nodes[0].evm_addr,
            self.nodes[1].evm_addr,
            self.nodes[2].evm_addr,
            self.nodes[3].evm_addr,
        ]
        build_rpc_batch_into(
            target_addr: contract_buf.span(),
            oracle_addrs: addrs,
            oracle_count: self.oracle_count,
            mut out,
        )
    }

    pub fn ingest_rpc_batch(mut self, payload: MemSpan, latency_ms: u64, now_ms: u64) -> bool {
        self.onchain.total_rpc_polls += 1
        self.onchain.rpc_latency_ms = latency_ms
        self.onchain.last_poll_ms = now_ms

        var got_any = false
        var saw_latest_prices = false
        var new_prices: [u64; 20] = [0; 20]
        var new_ts: u64 = 0

        let trimmed = payload.trim()
        if trimmed.is_empty() {
            self.onchain.rpc_errors += 1
            return false
        }

        if trimmed.byte_at(0) == b'[' {
            var cursor: usize = 0
            while true {
                let Option::Some((off, len)) = json_next_array_elem(trimmed, mut cursor) else {
                    break
                }
                let item = trimmed.slice(offset: off, len)
                let _ = self
                    .process_rpc_item(
                        item,
                        mut got_any,
                        mut saw_latest_prices,
                        mut new_prices,
                        mut new_ts,
                    )
            }
        } else if trimmed.byte_at(0) == b'{' {
            let _ = self
                .process_rpc_item(
                    item: trimmed,
                    mut got_any,
                    mut saw_latest_prices,
                    mut new_prices,
                    mut new_ts,
                )
        } else {
            self.onchain.rpc_errors += 1
            return false
        }

        if saw_latest_prices {
            let changed = new_ts != self.onchain.last_updated
                || !prices_eq(new_prices, self.onchain.latest_prices)
            if changed {
                var a: usize = 0
                while a < ASSET_COUNT {
                    let prev_p = self.onchain.latest_prices[a]
                    if prev_p > 0 {
                        self.onchain.previous_prices[a] = prev_p
                        self.onchain.last_deltas_bps[a] = signed_bps_diff(
                            val: new_prices[a],
                            base: prev_p,
                        )
                    }
                    a += 1
                }
            }
            self.onchain.latest_prices = new_prices
            self.onchain.last_updated = new_ts

            if new_ts > 0 && new_prices[0] > 0 {
                let settled_round = if self.onchain.current_round > 1 {
                    self.onchain.current_round - 1
                } else {
                    1
                }
                self.upsert_settled_round_price(
                    round_id: settled_round,
                    prices: new_prices,
                    ts: new_ts,
                )
            }
        }

        if got_any {
            self.onchain.connected = true
        }
        got_any
    }

    fn process_rpc_item(
        mut self,
        item: MemSpan,
        _ got_any: mut bool,
        _ saw_latest_prices: mut bool,
        _ new_prices: mut [u64; 20],
        _ new_ts: mut u64,
    ) -> bool {
        let Option::Some(id) = json_get_u64(item, "id".span()) else {
            return false
        }
        if json_get_raw(item, "error".span()).is_some() {
            self.onchain.rpc_errors += 1
            return false
        }
        if id == 1 {
            if let Option::Some((off, len)) = json_get_str_bounds(item, "result".span()) {
                if let Option::Some(cid) = parse_hex_u64(item.slice(offset: off, len)) {
                    self.onchain.chain_id = cid
                    got_any = true
                    return true
                }
            }
            return false
        }
        if id == 2 {
            if let Option::Some((off, len)) = json_get_str_bounds(item, "result".span()) {
                if let Option::Some(bn) = parse_hex_u64(item.slice(offset: off, len)) {
                    self.onchain.block_number = bn
                    got_any = true
                    return true
                }
            }
            return false
        }
        if id == 3 {
            if let Option::Some((off, len)) = json_get_raw(item, "result".span()) {
                let blk = item.slice(offset: off, len)
                if let Option::Some((toff, tlen)) = json_get_str_bounds(blk, "timestamp".span()) {
                    if let Option::Some(bts) = parse_hex_u64(blk.slice(offset: toff, len: tlen)) {
                        self.onchain.block_timestamp = bts
                        got_any = true
                        return true
                    }
                }
            }
            return false
        }
        if id == 4 {
            if let Option::Some((off, len)) = json_get_str_bounds(item, "result".span()) {
                let s = item.slice(offset: off, len).trim()
                let raw = s.tail(strip_0x_offset(s))
                if raw.len() < 1344 {
                    return false
                }
                var a: usize = 0
                while a < ASSET_COUNT {
                    let Option::Some(p) = parse_abi_word_u64(raw, word_idx: a) else {
                        return false
                    }
                    new_prices[a] = p
                    a += 1
                }
                let Option::Some(ts) = parse_abi_word_u64(raw, word_idx: 20) else {
                    return false
                }
                saw_latest_prices = true
                new_ts = ts
                got_any = true
                return true
            }
            return false
        }
        if id == 5 {
            if let Option::Some((off, len)) = json_get_str_bounds(item, "result".span()) {
                let s = item.slice(offset: off, len).trim()
                let raw = s.tail(strip_0x_offset(s))
                if let Option::Some(cr) = parse_abi_word_u64(raw, word_idx: 0) {
                    self.onchain.current_round = cr
                    got_any = true
                    return true
                }
            }
            return false
        }
        if id == 6 {
            if let Option::Some((off, len)) = json_get_str_bounds(item, "result".span()) {
                let s = item.slice(offset: off, len).trim()
                let raw = s.tail(strip_0x_offset(s))
                var addr_buf = MemBuffer::empty()
                if parse_abi_word_addr20(raw, word_idx: 0, mut addr_buf) {
                    self.onchain.owner.set_from_span(addr_buf.span())
                    got_any = true
                    return true
                }
            }
            return false
        }
        let max_oracles_u64: u64 = MAX_ORACLES.downcast_unchecked()
        if id >= 7 && id < 7 + max_oracles_u64 {
            let idx: usize = (id - 7).downcast_unchecked()
            if idx < MAX_ORACLES {
                if let Option::Some((off, len)) = json_get_str_bounds(item, "result".span()) {
                    let s = item.slice(offset: off, len).trim()
                    let raw = s.tail(strip_0x_offset(s))
                    if let Option::Some(auth) = parse_abi_word_bool(raw, word_idx: 0) {
                        self.nodes[idx].is_authorized_onchain = auth
                        self.nodes[idx].auth_known = true
                        got_any = true
                        return true
                    }
                }
            }
            return false
        }
        false
    }

    fn upsert_settled_round_price(mut self, round_id: u64, prices: [u64; 20], ts: u64) {
        if let Option::Some(l_idx) = self.find_round_logical_index(round_id) {
            let s_idx = self.round_storage_index(l_idx)
            self.rounds[s_idx].prices = prices
            self.rounds[s_idx].timestamp = ts
            if l_idx > 0 {
                let prev = self.round_at(l_idx - 1)
                if prev.prices[0] > 0 {
                    self.rounds[s_idx].delta_bps = signed_bps_diff(
                        val: prices[0],
                        base: prev.prices[0],
                    )
                }
            }
            return
        }

        if self.rounds_len > 0 {
            let last = self.round_at(self.rounds_len - 1)
            if last.round_id >= round_id && last.timestamp >= ts {
                return
            }
        }

        var delta: i64 = 0
        if self.rounds_len > 0 {
            let last = self.round_at(self.rounds_len - 1)
            if last.prices[0] > 0 {
                delta = signed_bps_diff(val: prices[0], base: last.prices[0])
            }
        }
        let sample = RoundSample {
            valid: true,
            round_id,
            prices,
            timestamp: ts,
            block_number: 0,
            gas_used: 0,
            tx_count: 0,
            expected_leader_idx: leader_index(round_id, node_count: NODE_COUNT),
            actual_leader_idx: -1,
            failover: false,
            submitter: FixedStr<48>::empty(),
            delta_bps: delta,
        }
        let _ = self.append_round_slot(sample)
    }

    pub fn match_node_by_addr(self, _ addr_hex: MemSpan) -> i64 {
        let Option::Some(target) = parse_hex_addr20(addr_hex) else {
            return -1
        }
        var i: usize = 0
        while i < self.oracle_count && i < MAX_ORACLES {
            if self.nodes[i].has_evm_addr && addr20_eq(self.nodes[i].addr20, target) {
                return i.downcast_unchecked()
            }
            i += 1
        }
        -1
    }

    pub fn ingest_tx(
        mut self,
        round_id: u64,
        block_num: u64,
        gas_used: u64,
        tx_count: u32,
        submitter_hex: MemSpan,
    ) {
        let expected = leader_index(round_id, node_count: NODE_COUNT)
        let actual_idx = self.match_node_by_addr(submitter_hex)
        let failover = if actual_idx >= 0 {
            let actual_u64: u64 = actual_idx.downcast_unchecked()
            actual_u64 != expected
        } else {
            false
        }

        var norm_sub = MemBuffer::empty()
        var sub_str = FixedStr<48>::empty()
        if normalize_addr20_hex(submitter_hex, mut norm_sub) {
            sub_str.set_from_span(norm_sub.span())
        } else {
            sub_str.set_from_span(submitter_hex.trim())
        }

        self.onchain.has_tx_data = true
        self.onchain.last_tx_gas = gas_used
        self.onchain.last_tx_failover = failover
        if tx_count > 1 {
            self.onchain.tx_invariant_ok = false
        }

        let zero_prices: [u64; 20] = [0; 20]
        let s_idx = match self.find_round_logical_index(round_id) {
            Option::Some(l_idx) => self.round_storage_index(l_idx),
            Option::None => {
                let sample = RoundSample {
                    valid: true,
                    round_id,
                    prices: zero_prices,
                    timestamp: 0,
                    block_number: block_num,
                    gas_used,
                    tx_count,
                    expected_leader_idx: expected,
                    actual_leader_idx: actual_idx,
                    failover,
                    submitter: sub_str,
                    delta_bps: 0,
                }
                let new_l_idx = self.append_round_slot(sample)
                self.round_storage_index(new_l_idx)
            },
        }
        self.rounds[s_idx].block_number = block_num
        self.rounds[s_idx].gas_used = gas_used
        self.rounds[s_idx].tx_count = tx_count
        self.rounds[s_idx].expected_leader_idx = expected
        self.rounds[s_idx].actual_leader_idx = actual_idx
        self.rounds[s_idx].failover = failover
        self.rounds[s_idx].submitter = sub_str
    }

    fn reset_wire_round(mut self, new_round: u64) {
        self.active_wire_round = new_round
        self.wire_quote_count = 0
        self.wire_sig_count = 0
        self.wire_group_medians = [0; 20]
        self.wire_round_ts = 0
        self.wire_breach_detected = false
        self.wire_breach_asset = -1
        var i: usize = 0
        while i < MAX_WIRE_SLOTS {
            self.wire_quotes[i].used = false
            self.wire_sigs[i].used = false
            i += 1
        }
    }

    fn recompute_wire_metrics(mut self) {
        if self.wire_quote_count >= 4 {
            self.wire_group_medians = median_prices_4(
                self.wire_quotes[0].prices,
                self.wire_quotes[1].prices,
                self.wire_quotes[2].prices,
                self.wire_quotes[3].prices,
            )
            self.wire_round_ts = median_u64_4(
                [
                    self.wire_quotes[0].timestamp,
                    self.wire_quotes[1].timestamp,
                    self.wire_quotes[2].timestamp,
                    self.wire_quotes[3].timestamp,
                ],
            )
        } else if self.wire_quote_count >= 3 {
            self.wire_group_medians = median_prices_3(
                self.wire_quotes[0].prices,
                self.wire_quotes[1].prices,
                self.wire_quotes[2].prices,
            )
            self.wire_round_ts = median_u64(
                [
                    self.wire_quotes[0].timestamp,
                    self.wire_quotes[1].timestamp,
                    self.wire_quotes[2].timestamp,
                ],
            )
        } else {
            self.wire_group_medians = [0; 20]
            self.wire_round_ts = 0
            self.wire_breach_detected = false
            self.wire_breach_asset = -1
            return
        }

        var breach = false
        var breach_asset: i64 = -1
        var i: usize = 0
        while i < self.wire_quote_count && i < MAX_WIRE_SLOTS {
            if let Option::Some(bad_idx) = first_tolerance_breach_asset(
                local: self.wire_quotes[i].prices,
                proposed: self.wire_group_medians,
                max_bps: MAX_TOLERANCE_BPS,
            ) {
                breach = true
                if breach_asset < 0 {
                    breach_asset = bad_idx.downcast_unchecked()
                }
            }
            i += 1
        }
        self.wire_breach_detected = breach
        self.wire_breach_asset = breach_asset
    }

    pub fn ingest_wire_frame(
        mut self,
        frame_hex: MemSpan,
        peer_tag: MemSpan,
        is_tx: bool,
        now_ms: u64,
    ) -> bool {
        var raw = MemBuffer::empty()
        if !decode_hex_bytes(frame_hex, mut raw) {
            self.total_wire_decode_errors += 1
            return false
        }

        if let Option::Some(q) = decode_quote(raw.span()) {
            self.total_wire_quotes_seen += 1
            if q.round_id < self.active_wire_round {
                return true
            }
            if q.round_id > self.active_wire_round {
                self.reset_wire_round(new_round: q.round_id)
            }

            let trimmed_peer = peer_tag.trim()
            let peer_key = FixedStr<64>::from_span(trimmed_peer)
            var has_signer = false
            var si: usize = 0
            while si < 20 {
                if q.signer_addr[si] != 0 {
                    has_signer = true
                    break
                }
                si += 1
            }

            var existing_idx: Option<usize> = Option::None
            var i: usize = 0
            while i < self.wire_quote_count {
                let slot = self.wire_quotes[i]
                let match_slot = if has_signer {
                    addr20_eq(slot.signer_addr, q.signer_addr)
                } else if !peer_key.is_empty() && !slot.peer_tag.is_empty() {
                    slot.peer_tag.equals(peer_key)
                } else {
                    prices_eq(slot.prices, q.prices) && slot.timestamp == q.timestamp
                }
                if match_slot {
                    existing_idx = Option::Some(i)
                    break
                }
                i += 1
            }

            match existing_idx {
                Option::Some(idx) => {
                    self.wire_quotes[idx].rx_count += 1
                    self.wire_quotes[idx].last_seen_ms = now_ms
                    self.wire_quotes[idx].last_is_tx = is_tx
                },
                Option::None => {
                    if self.wire_quote_count < MAX_WIRE_SLOTS {
                        let idx = self.wire_quote_count
                        var qhex = MemBuffer::empty()
                        push_addr20_hex(q.signer_addr, mut qhex)
                        self.wire_quotes[idx] = WireQuoteSlot {
                            used: true,
                            round_id: q.round_id,
                            prices: q.prices,
                            timestamp: q.timestamp,
                            signer_addr: q.signer_addr,
                            signer_hex: FixedStr<48>::from_span(qhex.span()),
                            rx_count: 1,
                            first_seen_ms: now_ms,
                            last_seen_ms: now_ms,
                            peer_tag: peer_key,
                            last_is_tx: is_tx,
                        }
                        self.wire_quote_count += 1
                    }
                },
            }
            self.recompute_wire_metrics()
            return true
        }

        if let Option::Some(sig_m) = decode_sig_msg(raw.span()) {
            self.total_wire_sigs_seen += 1
            if sig_m.round_id < self.active_wire_round {
                return true
            }
            if sig_m.round_id > self.active_wire_round {
                self.reset_wire_round(new_round: sig_m.round_id)
            }

            let trimmed_peer = peer_tag.trim()
            var existing_idx: Option<usize> = Option::None
            var i: usize = 0
            while i < self.wire_sig_count {
                if addr20_eq(self.wire_sigs[i].signer_addr, sig_m.signer_addr) {
                    existing_idx = Option::Some(i)
                    break
                }
                i += 1
            }

            match existing_idx {
                Option::Some(idx) => {
                    self.wire_sigs[idx].rx_count += 1
                },
                Option::None => {
                    if self.wire_sig_count < MAX_WIRE_SLOTS {
                        let idx = self.wire_sig_count
                        var hex_buf = MemBuffer::empty()
                        push_addr20_hex(sig_m.signer_addr, mut hex_buf)
                        self.wire_sigs[idx] = WireSigSlot {
                            used: true,
                            round_id: sig_m.round_id,
                            median_prices: sig_m.median_prices,
                            timestamp: sig_m.timestamp,
                            signer_addr: sig_m.signer_addr,
                            signer_hex: FixedStr<48>::from_span(hex_buf.span()),
                            v: sig_m.v,
                            rx_count: 1,
                            first_seen_ms: now_ms,
                            peer_tag: FixedStr<64>::from_span(trimmed_peer),
                        }
                        self.wire_sig_count += 1
                    }
                },
            }
            return true
        }

        self.total_wire_decode_errors += 1
        false
    }

    pub fn ingest_node_status(mut self, node_id: usize, payload: MemSpan, now_ms: u64) -> bool {
        if node_id >= MAX_ORACLES {
            return false
        }
        let trimmed = payload.trim()
        if trimmed.is_empty() || trimmed.byte_at(0) != b'{' {
            return false
        }

        self.nodes[node_id].online = true
        self.nodes[node_id].seen = true
        self.nodes[node_id].last_seen_ms = now_ms

        if let Option::Some(port) = json_get_u64(trimmed, "p2p_port".span()) {
            if let Option::Some(p16) = port.downcast() {
                self.nodes[node_id].p2p_port = p16
            }
        }
        if let Option::Some(pc) = json_get_u64(trimmed, "peer_count".span()) {
            self.nodes[node_id].peer_count = pc.downcast_saturate()
        }
        if let Option::Some(rid) = json_get_u64(trimmed, "round_id".span()) {
            self.nodes[node_id].round_id = rid
        }
        if let Option::Some((poff, plen)) = json_get_str_bounds(trimmed, "phase".span()) {
            self.nodes[node_id].phase.set_from_span(trimmed.slice(offset: poff, len: plen))
        }
        if let Option::Some(lp) = json_get_u64(trimmed, "local_price".span()) {
            self.nodes[node_id].local_price = lp
        }
        if let Option::Some(gm) = json_get_u64(trimmed, "group_median".span()) {
            self.nodes[node_id].group_median = gm
        }
        if let Option::Some(rts) = json_get_u64(trimmed, "round_ts".span()) {
            self.nodes[node_id].round_ts = rts
        }

        if let Option::Some((coff, clen)) = json_get_raw(trimmed, "counters".span()) {
            let ctr = trimmed.slice(offset: coff, len: clen)
            if let Option::Some(v) = json_get_u64(ctr, "quotes_tx".span()) {
                self.nodes[node_id].quotes_tx = v
            }
            if let Option::Some(v) = json_get_u64(ctr, "quotes_rx".span()) {
                self.nodes[node_id].quotes_rx = v
            }
            if let Option::Some(v) = json_get_u64(ctr, "sigs_tx".span()) {
                self.nodes[node_id].sigs_tx = v
            }
            if let Option::Some(v) = json_get_u64(ctr, "sigs_rx".span()) {
                self.nodes[node_id].sigs_rx = v
            }
            if let Option::Some(v) = json_get_u64(ctr, "tolerance_breaches".span()) {
                self.nodes[node_id].tolerance_breaches = v
            }
            if let Option::Some(v) = json_get_u64(ctr, "submissions_ok".span()) {
                self.nodes[node_id].submissions_ok = v
            }
            if let Option::Some(v) = json_get_u64(ctr, "submissions_err".span()) {
                self.nodes[node_id].submissions_err = v
            }
            if let Option::Some(v) = json_get_u64(ctr, "last_submit_ms".span()) {
                self.nodes[node_id].last_submit_ms = v
            }
        }

        if let Option::Some((foff, flen)) = json_get_raw(trimmed, "feeds".span()) {
            let arr = trimmed.slice(offset: foff, len: flen)
            var cursor: usize = 0
            var f_idx: usize = 0
            while f_idx < MAX_FEEDS_PER_NODE {
                let Option::Some((eoff, elen)) = json_next_array_elem(arr, mut cursor) else {
                    break
                }
                let obj = arr.slice(offset: eoff, len: elen)
                var feed = FeedSnap {
                    used: true,
                    provider: FixedStr<24>::empty(),
                    addr: FixedStr<32>::empty(),
                    price: 0,
                    assets_ok: 0,
                    ok: false,
                    latency_ms: 0,
                }
                if let Option::Some((proff, prlen)) = json_get_str_bounds(obj, "provider".span()) {
                    feed.provider.set_from_span(obj.slice(offset: proff, len: prlen))
                }
                if let Option::Some((aoff, alen)) = json_get_str_bounds(obj, "addr".span()) {
                    feed.addr.set_from_span(obj.slice(offset: aoff, len: alen))
                }
                if let Option::Some(pr) = json_get_u64(obj, "price".span()) {
                    feed.price = pr
                }
                if let Option::Some(aok) = json_get_u64(obj, "assets_ok".span()) {
                    feed.assets_ok = aok.downcast_saturate()
                }
                if let Option::Some(ok_v) = json_get_bool(obj, "ok".span()) {
                    feed.ok = ok_v
                }
                if let Option::Some(lat) = json_get_u64(obj, "latency_ms".span()) {
                    feed.latency_ms = lat
                }
                self.nodes[node_id].feeds[f_idx] = feed
                f_idx += 1
            }
            self.nodes[node_id].feed_count = f_idx
        }
        true
    }

    pub fn mark_node_offline(mut self, node_id: usize) -> bool {
        if node_id >= MAX_ORACLES {
            return false
        }
        self.nodes[node_id].online = false
        true
    }
}
