use feracle_core::{
    ASSET_COUNT,
    MAX_TOLERANCE_BPS,
    NODE_COUNT,
    PRICE_SCALE,
    QUORUM,
    abs_i64,
    first_tolerance_breach_asset,
    leader_index,
    worst_quote_deviation,
    write_asset_symbol,
}
use super::codec::{format_price_decimal, signed_bps_diff}
use super::render::{append_fixed_json, append_u64_array_json, compute_age_secs}
use super::state::{MAX_ORACLES, TelemetryEngine}

pub fn render_json_into(_ st: TelemetryEngine, now_ms: u64, _ out: mut MemBuffer) {
    out.clear()
    let cur_round = if st.onchain.current_round > 0 {
        st.onchain.current_round
    } else {
        1
    }
    let primary_leader = leader_index(round_id: cur_round, node_count: NODE_COUNT)
    let backup_leader = leader_index(round_id: cur_round + 1, node_count: NODE_COUNT)
    let age_secs = compute_age_secs(now_ms, ts_sec: st.onchain.last_updated)
    let stale = st.onchain.last_updated == 0 || age_secs > 60

    var price_fmt = MemBuffer::empty()
    format_price_decimal(
        st.onchain.latest_prices[0],
        decimals: 8,
        with_commas: false,
        mut price_fmt,
    )

    write!(
        mut out,
        "{\"protocol\":{\"asset_count\":",
        ASSET_COUNT,
        ",\"quorum\":",
        QUORUM,
        ",\"node_count\":",
        NODE_COUNT,
        ",\"max_tolerance_bps\":",
        MAX_TOLERANCE_BPS,
        ",\"price_scale\":",
        PRICE_SCALE,
        "},\"onchain\":{\"connected\":",
        st.onchain.connected,
        ",\"chain_id\":",
        st.onchain.chain_id,
        ",\"block_number\":",
        st.onchain.block_number,
        ",\"block_timestamp\":",
        st.onchain.block_timestamp,
        ",\"current_round\":",
        st.onchain.current_round,
        ",\"latest_price\":",
        st.onchain.latest_prices[0],
        ",\"latest_price_formatted\":\"",
        price_fmt,
        "\",\"previous_price\":",
        st.onchain.previous_prices[0],
        ",\"last_delta_bps\":",
        st.onchain.last_deltas_bps[0],
        ",\"prices\":[",
    )

    var ai: usize = 0
    while ai < ASSET_COUNT {
        if ai > 0 { out.push(b',') }
        var sym = MemBuffer::empty()
        write_asset_symbol(ai, mut sym)
        var fmt_a = MemBuffer::empty()
        format_price_decimal(
            st.onchain.latest_prices[ai],
            decimals: 8,
            with_commas: false,
            mut fmt_a,
        )
        write!(
            mut out,
            "{\"id\":",
            ai,
            ",\"symbol\":\"",
            sym,
            "\",\"price\":",
            st.onchain.latest_prices[ai],
            ",\"formatted\":\"",
            fmt_a,
            "\",\"delta_bps\":",
            st.onchain.last_deltas_bps[ai],
            "}",
        )
        ai += 1
    }

    write!(
        mut out,
        "],\"last_updated\":",
        st.onchain.last_updated,
        ",\"age_secs\":",
        age_secs,
        ",\"stale\":",
        stale,
        ",\"primary_leader\":",
        primary_leader,
        ",\"backup_leader\":",
        backup_leader,
        ",\"contract\":",
    )
    append_fixed_json(st.onchain.contract_addr, mut out)
    out.extend_from(",\"owner\":".span())
    append_fixed_json(st.onchain.owner, mut out)
    write!(
        mut out,
        ",\"rpc_latency_ms\":",
        st.onchain.rpc_latency_ms,
        ",\"last_poll_ms\":",
        st.onchain.last_poll_ms,
        ",\"total_rpc_polls\":",
        st.onchain.total_rpc_polls,
        ",\"rpc_errors\":",
        st.onchain.rpc_errors,
        ",\"has_tx_data\":",
        st.onchain.has_tx_data,
        ",\"last_tx_gas\":",
        st.onchain.last_tx_gas,
        ",\"last_tx_failover\":",
        st.onchain.last_tx_failover,
        ",\"tx_invariant_ok\":",
        st.onchain.tx_invariant_ok,
        "},\"wire\":{\"active_round\":",
        st.active_wire_round,
        ",\"group_median\":",
        st.wire_group_medians[0],
        ",\"group_medians\":",
    )
    append_u64_array_json(st.wire_group_medians, mut out)
    write!(
        mut out,
        ",\"round_ts\":",
        st.wire_round_ts,
        ",\"breach_detected\":",
        st.wire_breach_detected,
        ",\"breach_asset\":",
        st.wire_breach_asset,
        ",\"total_quotes_seen\":",
        st.total_wire_quotes_seen,
        ",\"total_sigs_seen\":",
        st.total_wire_sigs_seen,
        ",\"decode_errors\":",
        st.total_wire_decode_errors,
        ",\"quotes\":[",
    )

    var qi: usize = 0
    while qi < st.wire_quote_count {
        if qi > 0 { out.push(b',') }
        let q = st.wire_quotes[qi]
        let diff_bps = if st.wire_group_medians[0] > 0 {
            signed_bps_diff(val: q.prices[0], base: st.wire_group_medians[0])
        } else {
            0
        }
        var max_abs_diff_bps: u64 = 0
        var within = true
        var q_breach_asset: i64 = -1
        if st.wire_group_medians[0] > 0 {
            let (_, worst_bps) = worst_quote_deviation(q.prices, st.wire_group_medians)
            max_abs_diff_bps = abs_i64(worst_bps)
            if let Option::Some(bad_idx) = first_tolerance_breach_asset(
                local: q.prices,
                proposed: st.wire_group_medians,
                max_bps: MAX_TOLERANCE_BPS,
            ) {
                within = false
                q_breach_asset = bad_idx.downcast_unchecked()
            }
        }
        write!(
            mut out,
            "{\"round_id\":",
            q.round_id,
            ",\"price\":",
            q.prices[0],
            ",\"btc_price\":",
            q.prices[0],
            ",\"prices\":",
        )
        append_u64_array_json(q.prices, mut out)
        write!(
            mut out,
            ",\"timestamp\":",
            q.timestamp,
            ",\"rx_count\":",
            q.rx_count,
            ",\"diff_bps\":",
            diff_bps,
            ",\"max_abs_diff_bps\":",
            max_abs_diff_bps,
            ",\"within_tolerance\":",
            within,
            ",\"breach_asset\":",
            q_breach_asset,
            ",\"peer_tag\":",
        )
        append_fixed_json(q.peer_tag, mut out)
        out.push(b'}')
        qi += 1
    }

    out.extend_from("],\"sigs\":[".span())
    var si: usize = 0
    while si < st.wire_sig_count {
        if si > 0 { out.push(b',') }
        let s = st.wire_sigs[si]
        write!(
            mut out,
            "{\"round_id\":",
            s.round_id,
            ",\"median_price\":",
            s.median_prices[0],
            ",\"median_prices\":",
        )
        append_u64_array_json(s.median_prices, mut out)
        write!(
            mut out,
            ",\"timestamp\":",
            s.timestamp,
            ",\"v\":",
            s.v,
            ",\"rx_count\":",
            s.rx_count,
            ",\"signer\":",
        )
        append_fixed_json(s.signer_hex, mut out)
        out.push(b'}')
        si += 1
    }

    out.extend_from("]},\"nodes\":[".span())
    var ni: usize = 0
    while ni < MAX_ORACLES {
        if ni > 0 { out.push(b',') }
        let node = st.nodes[ni]
        write!(mut out, "{\"node_id\":", ni, ",\"evm_addr\":")
        append_fixed_json(node.evm_addr, mut out)
        write!(
            mut out,
            ",\"is_authorized_onchain\":",
            node.is_authorized_onchain,
            ",\"auth_known\":",
            node.auth_known,
            ",\"online\":",
            node.online,
            ",\"seen\":",
            node.seen,
            ",\"p2p_port\":",
            node.p2p_port,
            ",\"peer_count\":",
            node.peer_count,
            ",\"round_id\":",
            node.round_id,
            ",\"phase\":",
        )
        append_fixed_json(node.phase, mut out)
        write!(
            mut out,
            ",\"local_price\":",
            node.local_price,
            ",\"group_median\":",
            node.group_median,
            ",\"round_ts\":",
            node.round_ts,
            ",\"counters\":{\"quotes_tx\":",
            node.quotes_tx,
            ",\"quotes_rx\":",
            node.quotes_rx,
            ",\"sigs_tx\":",
            node.sigs_tx,
            ",\"sigs_rx\":",
            node.sigs_rx,
            ",\"tolerance_breaches\":",
            node.tolerance_breaches,
            ",\"submissions_ok\":",
            node.submissions_ok,
            ",\"submissions_err\":",
            node.submissions_err,
            ",\"last_submit_ms\":",
            node.last_submit_ms,
            "},\"feeds\":[",
        )
        var fi: usize = 0
        while fi < node.feed_count {
            if fi > 0 { out.push(b',') }
            let f = node.feeds[fi]
            out.extend_from("{\"provider\":".span())
            append_fixed_json(f.provider, mut out)
            out.extend_from(",\"addr\":".span())
            append_fixed_json(f.addr, mut out)
            write!(
                mut out,
                ",\"price\":",
                f.price,
                ",\"assets_ok\":",
                f.assets_ok,
                ",\"ok\":",
                f.ok,
                ",\"latency_ms\":",
                f.latency_ms,
                "}",
            )
            fi += 1
        }
        out.extend_from("]}".span())
        ni += 1
    }

    out.extend_from("],\"rounds\":[".span())
    var ri: usize = 0
    while ri < st.rounds_len {
        if ri > 0 { out.push(b',') }
        let rs = st.round_at(ri)
        write!(
            mut out,
            "{\"round_id\":",
            rs.round_id,
            ",\"price\":",
            rs.prices[0],
            ",\"prices\":",
        )
        append_u64_array_json(rs.prices, mut out)
        write!(
            mut out,
            ",\"timestamp\":",
            rs.timestamp,
            ",\"block_number\":",
            rs.block_number,
            ",\"gas_used\":",
            rs.gas_used,
            ",\"tx_count\":",
            rs.tx_count,
            ",\"expected_leader\":",
            rs.expected_leader_idx,
            ",\"actual_leader\":",
            rs.actual_leader_idx,
            ",\"failover\":",
            rs.failover,
            ",\"delta_bps\":",
            rs.delta_bps,
            ",\"submitter\":",
        )
        append_fixed_json(rs.submitter, mut out)
        out.push(b'}')
        ri += 1
    }
    out.extend_from("]}".span())
}
