use feracle_core::{ASSET_COUNT, write_asset_symbol}
use super::codec::{FixedStr, format_asset_price_usd, format_signed_bps, write_padded_col}
use super::state::{TelemetryEngine}

pub use super::render_tui::render_tui_into
pub use super::render_json::render_json_into
pub use super::render_prom::render_prometheus_into

pub(ingot) fn push_ansi_clear(_ out: mut MemBuffer) {
    out.push(27)
    out.extend_from("[2J".span())
    out.push(27)
    out.extend_from("[H".span())
}

pub(ingot) fn push_ansi_code(_ ansi: bool, _ code: MemSpan, _ out: mut MemBuffer) {
    if !ansi { return }
    out.push(27)
    out.extend_from(code)
}

pub(ingot) fn append_fixed_json<const N: usize>(_ s: FixedStr<N>, _ out: mut MemBuffer) {
    out.push(b'"')
    s.write_json_escaped(mut out)
    out.push(b'"')
}

pub(ingot) fn append_u64_array_json(_ arr: [u64; 20], _ out: mut MemBuffer) {
    out.push(b'[')
    var i: usize = 0
    while i < ASSET_COUNT {
        if i > 0 { out.push(b',') }
        write!(mut out, arr[i])
        i += 1
    }
    out.push(b']')
}

pub(ingot) fn compute_age_secs(now_ms: u64, ts_sec: u64) -> u64 {
    if ts_sec == 0 { return 0 }
    let now_sec = now_ms / 1000
    if now_sec > ts_sec {
        now_sec - ts_sec
    } else {
        0
    }
}

pub(ingot) fn format_asset_cell(
    asset_id: usize,
    price_1e8: u64,
    delta_bps: i64,
    _ out: mut MemBuffer,
) {
    var sym = MemBuffer::empty()
    write_asset_symbol(asset_id, mut sym)
    write_padded_col(sym.span(), width: 5, right_align: false, mut out)

    var pbuf = MemBuffer::empty()
    if price_1e8 > 0 {
        format_asset_price_usd(price_1e8, mut pbuf)
    } else {
        pbuf.extend_from("$0.00".span())
    }
    write_padded_col(pbuf.span(), width: 12, right_align: true, mut out)

    out.extend_from("  (".span())
    var dbuf = MemBuffer::empty()
    format_signed_bps(delta_bps, mut dbuf)
    out.extend_from(dbuf.span())
    out.push(b')')
}

pub(ingot) fn render_sparkline(_ st: TelemetryEngine, _ out: mut MemBuffer) {
    var vals: [u64; 16] = [0; 16]
    var count: usize = 0
    let start = if st.rounds_len > 16 {
        st.rounds_len - 16
    } else {
        0
    }
    var i = start
    while i < st.rounds_len && count < 16 {
        let p = st.round_at(i).prices[0]
        if p > 0 {
            vals[count] = p
            count += 1
        }
        i += 1
    }
    if count == 0 {
        out.extend_from("(no history yet)".span())
        return
    }
    var min_p = vals[0]
    var max_p = vals[0]
    var j: usize = 1
    while j < count {
        if vals[j] < min_p {
            min_p = vals[j]
        }
        if vals[j] > max_p {
            max_p = vals[j]
        }
        j += 1
    }
    let bars = "_.-:=+*#"
    var k: usize = 0
    while k < count {
        let level: usize = if max_p == min_p {
            4
        } else {
            let num: u128 = ((vals[k] - min_p) as u128) * (7 as u128)
            let den: u128 = (max_p - min_p) as u128
            let scaled: u64 = (num / den).downcast_unchecked()
            scaled.downcast_unchecked()
        }
        out.push(bars.span().byte_at(level))
        k += 1
    }
}
