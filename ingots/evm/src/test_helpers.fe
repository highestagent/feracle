pub(ingot) msg HelperMsg {
    #[selector = sol("forwardAdd(address,address)")]
    ForwardAdd { target: Address, node: Address } -> bool,
    #[selector = sol("forwardTransferOwnership(address,address)")]
    ForwardTransferOwnership { target: Address, new_owner: Address } -> bool,
    #[selector = sol("forwardAcceptOwnership(address)")]
    ForwardAcceptOwnership { target: Address } -> bool,
    #[selector = sol("forwardPause(address)")]
    ForwardPause { target: Address } -> bool,
    #[selector = sol("forwardUnpause(address)")]
    ForwardUnpause { target: Address } -> bool,
}

pub(ingot) contract NonOwnerCaller uses (call: mut Call) {
    init() {}

    recv HelperMsg {
        ForwardAdd { target, node } -> bool uses (mut call) {
            call.try_call(
                addr: target,
                gas: 200000,
                value: Wei::zero(),
                message: OracleMsg::AddOracle { node },
            )
                .success()
        }

        ForwardTransferOwnership { target, new_owner } -> bool
        uses (mut call)
        {
            call.try_call(
                addr: target,
                gas: 200000,
                value: Wei::zero(),
                message: OracleMsg::TransferOwnership { new_owner },
            )
                .success()
        }

        ForwardAcceptOwnership { target } -> bool
        uses (mut call)
        {
            call.try_call(
                addr: target,
                gas: 200000,
                value: Wei::zero(),
                message: OracleMsg::AcceptOwnership {},
            )
                .success()
        }

        ForwardPause { target } -> bool uses (mut call) {
            call.try_call(
                addr: target,
                gas: 200000,
                value: Wei::zero(),
                message: OracleMsg::Pause {},
            )
                .success()
        }

        ForwardUnpause { target } -> bool uses (mut call) {
            call.try_call(
                addr: target,
                gas: 200000,
                value: Wei::zero(),
                message: OracleMsg::Unpause {},
            )
                .success()
        }
    }
}

pub(ingot) fn deploy_and_register(evm: mut Evm) -> Address {
    let addr = evm.create2<OffchainMedianOracle>(value: Wei::zero(), args: (), salt: 0)
    assert!(addr.word() == 0x184a05ae4c04d7c42175b96c3faca8084d8ae4e8)

    evm.call(
        addr: addr,
        gas: 100000,
        value: Wei::zero(),
        message: OracleMsg::AddOracle { node: ADDR_0 },
    )
    evm.call(
        addr: addr,
        gas: 100000,
        value: Wei::zero(),
        message: OracleMsg::AddOracle { node: ADDR_1 },
    )
    evm.call(
        addr: addr,
        gas: 100000,
        value: Wei::zero(),
        message: OracleMsg::AddOracle { node: ADDR_2 },
    )

    assert!(
        evm.call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::IsOracle { node: ADDR_0 },
        ),
    )
    assert!(
        evm.call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::IsOracle { node: ADDR_1 },
        ),
    )
    assert!(
        evm.call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::IsOracle { node: ADDR_2 },
        ),
    )
    assert!(
        !evm.call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::IsOracle { node: ADDR_3 },
        ),
    )
    addr
}

pub(ingot) fn assert_reverted_with(_ outcome: CallOutcome, _ expected: MemSpan) {
    assert!(!outcome.success())
    assert!(outcome.returndata() == expected)
}
