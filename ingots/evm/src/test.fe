use std::evm::{Evm, Wei, encode_error}
use super::{
    ASSET_COUNT,
    DuplicateOrUnsortedSigner,
    FutureTimestamp,
    InvalidAsset,
    InvalidRound,
    InvalidSignature,
    OracleMsg,
    PriceOverflow,
    Sig,
    StaleTimestamp,
    Unauthorized,
    ZeroPrice,
}
use super::test_helpers::{
    ADDR_0,
    ADDR_1,
    ADDR_2,
    ADDR_3,
    TEST_TS,
    test_prices,
    sig0,
    sig1,
    sig2,
    sig3,
    HelperMsg,
    NonOwnerCaller,
    deploy_and_register,
    assert_reverted_with,
}

#[test]
fn test_asset_count_and_invalid_asset_revert() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let count: u256 = evm
        .call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::AssetCount {},
        )
    assert!(count == (ASSET_COUNT as u256))

    let outcome = evm
        .try_call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::LatestPrice { asset_id: 20 },
        )
    assert_reverted_with(outcome, encode_error(InvalidAsset {}).span())
}

#[test]
fn test_valid_submit_medians() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let expected = test_prices()

    let round0: u256 = evm
        .call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::CurrentRound {},
        )
    assert!(round0 == 1)

    // Sorted ascending by signer address: ADDR_2 < ADDR_1 < ADDR_0
    let sigs: [Sig; 3] = [sig2(), sig1(), sig0()]
    evm.call(
        addr: addr,
        gas: 1500000,
        value: Wei::zero(),
        message: OracleMsg::SubmitMedians {
            round_id: 1,
            prices: expected,
            timestamp: TEST_TS,
            sigs,
        },
    )

    let (all_prices, last_updated): ([u256; 20], u256) = evm
        .call(
            addr: addr,
            gas: 300000,
            value: Wei::zero(),
            message: OracleMsg::LatestPrices {},
        )
    assert!(last_updated == TEST_TS)
    var i: usize = 0
    while i < ASSET_COUNT {
        assert!(all_prices[i] == expected[i])
        i += 1
    }

    var idx: usize = 0
    while idx < ASSET_COUNT {
        let (p, p_ts): (u256, u256) = evm
            .call(
                addr: addr,
                gas: 100000,
                value: Wei::zero(),
                message: OracleMsg::LatestPrice { asset_id: idx as u256 },
            )
        assert!(p == expected[idx])
        assert!(p_ts == TEST_TS)
        idx += 1
    }

    let round1: u256 = evm
        .call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::CurrentRound {},
        )
    assert!(round1 == 2)
}

#[test]
fn test_replay_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let prices = test_prices()
    let sigs: [Sig; 3] = [sig2(), sig1(), sig0()]
    evm.call(
        addr: addr,
        gas: 1500000,
        value: Wei::zero(),
        message: OracleMsg::SubmitMedians { round_id: 1, prices, timestamp: TEST_TS, sigs },
    )

    let outcome = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians { round_id: 1, prices, timestamp: TEST_TS, sigs },
        )
    assert_reverted_with(outcome, encode_error(InvalidRound {}).span())
}

#[test]
fn test_unsorted_signers_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    // Descending order: ADDR_0 > ADDR_1 > ADDR_2
    let sigs: [Sig; 3] = [sig0(), sig1(), sig2()]
    let outcome = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices: test_prices(),
                timestamp: TEST_TS,
                sigs,
            },
        )
    assert_reverted_with(outcome, encode_error(DuplicateOrUnsortedSigner {}).span())
}

#[test]
fn test_duplicate_signer_reverts() uses (evm: mut Evm) {
