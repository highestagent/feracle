#[test]
fn test_unauthorized_signer_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let prices = test_prices()

    // Account 3 is not an oracle (ADDR_2 < ADDR_1 < ADDR_3 < ADDR_0)
    let sigs_with_unauth: [Sig; 3] = [sig2(), sig1(), sig3()]
    let outcome1 = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices,
                timestamp: TEST_TS,
                sigs: sigs_with_unauth,
            },
        )
    assert_reverted_with(outcome1, encode_error(Unauthorized {}).span())

    // Remove ADDR_0 and attempt with [sig2, sig1, sig0]
    evm.call(
        addr: addr,
        gas: 100000,
        value: Wei::zero(),
        message: OracleMsg::RemoveOracle { node: ADDR_0 },
    )
    let sigs: [Sig; 3] = [sig2(), sig1(), sig0()]
    let outcome2 = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians { round_id: 1, prices, timestamp: TEST_TS, sigs },
        )
    assert_reverted_with(outcome2, encode_error(Unauthorized {}).span())
}

#[test]
fn test_invalid_signature_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let bad_sig = Sig { v: 0, r: 0, s: 0 }
    let sigs: [Sig; 3] = [bad_sig, sig1(), sig0()]
    let outcome = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices: test_prices(),
                timestamp: TEST_TS,
                sigs,
            },
        )
    assert_reverted_with(outcome, encode_error(InvalidSignature {}).span())
}

#[test]
fn test_zero_price_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    var zero_btc = test_prices()
    zero_btc[0] = 0
    let sigs: [Sig; 3] = [sig2(), sig1(), sig0()]
    let outcome0 = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices: zero_btc,
                timestamp: TEST_TS,
                sigs,
            },
        )
    assert_reverted_with(outcome0, encode_error(ZeroPrice {}).span())

    var zero_last = test_prices()
    zero_last[19] = 0
    let outcome19 = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices: zero_last,
                timestamp: TEST_TS,
                sigs,
            },
        )
    assert_reverted_with(outcome19, encode_error(ZeroPrice {}).span())
}

#[test]
fn test_future_timestamp_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let sigs: [Sig; 3] = [sig2(), sig1(), sig0()]
    // In `fe test`, block.timestamp == 1, so timestamp == 2 is in the future
    let outcome = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices: test_prices(),
                timestamp: 2,
                sigs,
            },
        )
    assert_reverted_with(outcome, encode_error(FutureTimestamp {}).span())
}

#[test]
fn test_stale_timestamp_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let prices = test_prices()
    let sigs: [Sig; 3] = [sig2(), sig1(), sig0()]

    // Initially last_updated == 0, so timestamp == 0 is stale
    let outcome0 = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians { round_id: 1, prices, timestamp: 0, sigs },
        )
    assert_reverted_with(outcome0, encode_error(StaleTimestamp {}).span())

    // Succeed round 1 with timestamp == 1 (sets last_updated = 1)
    evm.call(
        addr: addr,
        gas: 1500000,
        value: Wei::zero(),
        message: OracleMsg::SubmitMedians { round_id: 1, prices, timestamp: TEST_TS, sigs },
    )

    // Round 2 with timestamp == 1 must fail StaleTimestamp
    let outcome2 = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians { round_id: 2, prices, timestamp: 1, sigs },
        )
    assert_reverted_with(outcome2, encode_error(StaleTimestamp {}).span())
}

#[test]
fn test_non_owner_add_oracle_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let helper = evm.create2<NonOwnerCaller>(value: Wei::zero(), args: (), salt: 1)
    let ok = evm
        .call(
            addr: helper,
            gas: 300000,
            value: Wei::zero(),
            message: HelperMsg::ForwardAdd { target: addr, node: ADDR_3 },
        )
    assert!(!ok)
    assert!(
        !evm.call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::IsOracle { node: ADDR_3 },
        ),
    )
}

#[test]
fn test_price_overflow_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    var overflow_prices = test_prices()
    overflow_prices[5] = 0x10000000000000000
    let sigs: [Sig; 3] = [sig2(), sig1(), sig0()]
    let outcome = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices: overflow_prices,
                timestamp: TEST_TS,
                sigs,
            },
        )
    assert_reverted_with(outcome, encode_error(PriceOverflow {}).span())
}

#[test]
fn test_invalid_v_and_high_s_malleability_revert() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let prices = test_prices()

    let base2 = sig2()
    let bad_v26 = Sig { v: 26, r: base2.r, s: base2.s }
    let out_v26 = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices,
                timestamp: TEST_TS,
                sigs: [bad_v26, sig1(), sig0()],
            },
        )
    assert_reverted_with(out_v26, encode_error(InvalidSignature {}).span())

    let bad_v29 = Sig { v: 29, r: base2.r, s: base2.s }
    let out_v29 = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices,
                timestamp: TEST_TS,
                sigs: [bad_v29, sig1(), sig0()],
            },
        )
    assert_reverted_with(out_v29, encode_error(InvalidSignature {}).span())

    // EIP-2 high-s malleable counterpart (s' = SECP256K1_N - s, flipped v)
    let secp256k1_n: u256 = 0xfffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141
    let high_s = Sig { v: 28, r: base2.r, s: secp256k1_n - base2.s }
    let out_high_s = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices,
                timestamp: TEST_TS,
                sigs: [high_s, sig1(), sig0()],
            },
        )
    assert_reverted_with(out_high_s, encode_error(InvalidSignature {}).span())
}
