use core::num::IntDowncast
use std::abi::sol
use std::evm::{Address, Call, CallOutcome, Create, Evm, Wei, encode_error}
use super::{
    ASSET_COUNT,
    DuplicateOrUnsortedSigner,
    FutureTimestamp,
    InvalidAsset,
    InvalidRound,
    InvalidSignature,
    NotPaused,
    OffchainMedianOracle,
    OracleMsg,
    Paused,
    PriceOverflow,
    Sig,
    StaleTimestamp,
    Unauthorized,
    ZeroAddress,
    ZeroPrice,
}

const ADDR_0: Address = Address::new(0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266)
const ADDR_1: Address = Address::new(0x70997970C51812dc3A010C7d01b50e0d17dc79C8)
const ADDR_2: Address = Address::new(0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC)
const ADDR_3: Address = Address::new(0x90F79bf6EB2c4f870365E785982E1f101E93b906)

const TEST_TS: u256 = 1

fn test_prices() -> [u256; 20] {
    [
        9_245_025_000_000,
        342_050_000_000,
        21_840_000_000,
        245_200_000,
        68_520_000_000,
        38_400_000,
        104_500_000,
        26_100_000,
        4_480_000_000,
        2_360_000_000,
        415_200_000,
        892_000_000,
        29_500_000,
        51_230_000_000,
        11_460_000_000,
        1_475_000_000,
        648_000_000,
        1_235_000_000,
        94_500_000,
        31_850_000_000,
    ]
}

fn sig0() -> Sig {
    Sig {
        v: 27,
        r: 0x8fb3578b213cfd20336dec0e1df25e5fe2a2ea85914adc38a87fb04f443272ab,
        s: 0x39e1141d077d876e3208636f9dec8512b75e11b340aa2fdb500fcb066283ddac,
    }
}

fn sig1() -> Sig {
    Sig {
        v: 27,
        r: 0x1252fec6ccb619a260d25045b4b056837afdcf4ed74a0ec224ff8b1e7df0d14c,
        s: 0x03cddf661b239ef6cafd7241260bdc79835cd6479f55abde79b52b128d0be31f,
    }
}

fn sig2() -> Sig {
    Sig {
        v: 27,
        r: 0xd7592587ed444568ec7afd6f2f77dded4db88022ceb0cb5990d32a37fa0521e6,
        s: 0x5e36724cfa5c06ef0e178f48f3e28f944c6df4c1b491358c92c507a93c51781b,
    }
}

fn sig3() -> Sig {
    Sig {
        v: 28,
        r: 0xfe9222d7b093943e74cddf2965d1e857c4f943d0fb26267571a45b2161eba37a,
        s: 0x3132791caf95372bb15802d78404e22346011899bad7891e1ea9d678dd4cdb64,
    }
}

msg HelperMsg {
    #[selector = sol("forwardAdd(address,address)")]
    ForwardAdd { target: Address, node: Address } -> bool,
    #[selector = sol("forwardTransferOwnership(address,address)")]
    ForwardTransferOwnership { target: Address, new_owner: Address } -> bool,
    #[selector = sol("forwardAcceptOwnership(address)")]
    ForwardAcceptOwnership { target: Address } -> bool,
    #[selector = sol("forwardPause(address)")]
    ForwardPause { target: Address } -> bool,
    #[selector = sol("forwardUnpause(address)")]
    ForwardUnpause { target: Address } -> bool,
}

contract NonOwnerCaller uses (call: mut Call) {
    init() {}

    recv HelperMsg {
        ForwardAdd { target, node } -> bool uses (mut call) {
            call.try_call(
                addr: target,
                gas: 200000,
                value: Wei::zero(),
                message: OracleMsg::AddOracle { node },
            )
                .success()
        }

        ForwardTransferOwnership { target, new_owner } -> bool
        uses (mut call)
        {
            call.try_call(
                addr: target,
                gas: 200000,
                value: Wei::zero(),
                message: OracleMsg::TransferOwnership { new_owner },
            )
                .success()
        }

        ForwardAcceptOwnership { target } -> bool
        uses (mut call)
        {
            call.try_call(
                addr: target,
                gas: 200000,
                value: Wei::zero(),
                message: OracleMsg::AcceptOwnership {},
            )
                .success()
        }

        ForwardPause { target } -> bool uses (mut call) {
            call.try_call(
                addr: target,
                gas: 200000,
                value: Wei::zero(),
                message: OracleMsg::Pause {},
            )
                .success()
        }

        ForwardUnpause { target } -> bool uses (mut call) {
            call.try_call(
                addr: target,
                gas: 200000,
                value: Wei::zero(),
                message: OracleMsg::Unpause {},
            )
                .success()
        }
    }
}

fn deploy_and_register(evm: mut Evm) -> Address {
    let addr = evm.create2<OffchainMedianOracle>(value: Wei::zero(), args: (), salt: 0)
    assert!(addr.word() == 0x184a05ae4c04d7c42175b96c3faca8084d8ae4e8)

    evm.call(
        addr: addr,
        gas: 100000,
        value: Wei::zero(),
        message: OracleMsg::AddOracle { node: ADDR_0 },
    )
    evm.call(
        addr: addr,
        gas: 100000,
        value: Wei::zero(),
        message: OracleMsg::AddOracle { node: ADDR_1 },
    )
    evm.call(
        addr: addr,
        gas: 100000,
        value: Wei::zero(),
        message: OracleMsg::AddOracle { node: ADDR_2 },
    )

    assert!(
        evm.call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::IsOracle { node: ADDR_0 },
        ),
    )
    assert!(
        evm.call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::IsOracle { node: ADDR_1 },
        ),
    )
    assert!(
        evm.call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::IsOracle { node: ADDR_2 },
        ),
    )
    assert!(
        !evm.call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::IsOracle { node: ADDR_3 },
        ),
    )
    addr
}

fn assert_reverted_with(_ outcome: CallOutcome, _ expected: MemSpan) {
    assert!(!outcome.success())
    assert!(outcome.returndata() == expected)
}

#[test]
fn test_asset_count_and_invalid_asset_revert() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let count: u256 = evm
        .call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::AssetCount {},
        )
    assert!(count == (ASSET_COUNT as u256))

    let outcome = evm
        .try_call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::LatestPrice { asset_id: 20 },
        )
    assert_reverted_with(outcome, encode_error(InvalidAsset {}).span())
}

#[test]
fn test_valid_submit_medians() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let expected = test_prices()

    let round0: u256 = evm
        .call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::CurrentRound {},
        )
    assert!(round0 == 1)

    // Sorted ascending by signer address: ADDR_2 < ADDR_1 < ADDR_0
    let sigs: [Sig; 3] = [sig2(), sig1(), sig0()]
    evm.call(
        addr: addr,
        gas: 1500000,
        value: Wei::zero(),
        message: OracleMsg::SubmitMedians {
            round_id: 1,
            prices: expected,
            timestamp: TEST_TS,
            sigs,
        },
    )

    let (all_prices, last_updated): ([u256; 20], u256) = evm
        .call(
            addr: addr,
            gas: 300000,
            value: Wei::zero(),
            message: OracleMsg::LatestPrices {},
        )
    assert!(last_updated == TEST_TS)
    var i: usize = 0
    while i < ASSET_COUNT {
        assert!(all_prices[i] == expected[i])
        i += 1
    }

    var idx: usize = 0
    while idx < ASSET_COUNT {
        let (p, p_ts): (u256, u256) = evm
            .call(
                addr: addr,
                gas: 100000,
                value: Wei::zero(),
                message: OracleMsg::LatestPrice { asset_id: idx as u256 },
            )
        assert!(p == expected[idx])
        assert!(p_ts == TEST_TS)
        idx += 1
    }

    let round1: u256 = evm
        .call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::CurrentRound {},
        )
    assert!(round1 == 2)
}

#[test]
fn test_replay_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let prices = test_prices()
    let sigs: [Sig; 3] = [sig2(), sig1(), sig0()]
    evm.call(
        addr: addr,
        gas: 1500000,
        value: Wei::zero(),
        message: OracleMsg::SubmitMedians { round_id: 1, prices, timestamp: TEST_TS, sigs },
    )

    let outcome = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians { round_id: 1, prices, timestamp: TEST_TS, sigs },
        )
    assert_reverted_with(outcome, encode_error(InvalidRound {}).span())
}

#[test]
fn test_unsorted_signers_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    // Descending order: ADDR_0 > ADDR_1 > ADDR_2
    let sigs: [Sig; 3] = [sig0(), sig1(), sig2()]
    let outcome = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices: test_prices(),
                timestamp: TEST_TS,
                sigs,
            },
        )
    assert_reverted_with(outcome, encode_error(DuplicateOrUnsortedSigner {}).span())
}

#[test]
fn test_duplicate_signer_reverts() uses (evm: mut Evm) {
