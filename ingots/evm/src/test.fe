#[test]
fn test_zero_price_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    var zero_btc = test_prices()
    zero_btc[0] = 0
    let sigs: [Sig; 3] = [sig2(), sig1(), sig0()]
    let outcome0 = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices: zero_btc,
                timestamp: TEST_TS,
                sigs,
            },
        )
    assert_reverted_with(outcome0, encode_error(ZeroPrice {}).span())

    var zero_last = test_prices()
    zero_last[19] = 0
    let outcome19 = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices: zero_last,
                timestamp: TEST_TS,
                sigs,
            },
        )
    assert_reverted_with(outcome19, encode_error(ZeroPrice {}).span())
}

#[test]
fn test_future_timestamp_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let sigs: [Sig; 3] = [sig2(), sig1(), sig0()]
    // In `fe test`, block.timestamp == 1, so timestamp == 2 is in the future
    let outcome = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices: test_prices(),
                timestamp: 2,
                sigs,
            },
        )
    assert_reverted_with(outcome, encode_error(FutureTimestamp {}).span())
}

#[test]
fn test_stale_timestamp_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let prices = test_prices()
    let sigs: [Sig; 3] = [sig2(), sig1(), sig0()]

    // Initially last_updated == 0, so timestamp == 0 is stale
    let outcome0 = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians { round_id: 1, prices, timestamp: 0, sigs },
        )
    assert_reverted_with(outcome0, encode_error(StaleTimestamp {}).span())

    // Succeed round 1 with timestamp == 1 (sets last_updated = 1)
    evm.call(
        addr: addr,
        gas: 1500000,
        value: Wei::zero(),
        message: OracleMsg::SubmitMedians { round_id: 1, prices, timestamp: TEST_TS, sigs },
    )

    // Round 2 with timestamp == 1 must fail StaleTimestamp
    let outcome2 = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians { round_id: 2, prices, timestamp: 1, sigs },
        )
    assert_reverted_with(outcome2, encode_error(StaleTimestamp {}).span())
}

#[test]
fn test_non_owner_add_oracle_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let helper = evm.create2<NonOwnerCaller>(value: Wei::zero(), args: (), salt: 1)
    let ok = evm
        .call(
            addr: helper,
            gas: 300000,
            value: Wei::zero(),
            message: HelperMsg::ForwardAdd { target: addr, node: ADDR_3 },
        )
    assert!(!ok)
    assert!(
        !evm.call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: OracleMsg::IsOracle { node: ADDR_3 },
        ),
    )
}

