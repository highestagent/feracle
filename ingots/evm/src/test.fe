#[test]
fn test_unauthorized_signer_reverts() uses (evm: mut Evm) {
    let addr = deploy_and_register(evm: mut evm)
    let prices = test_prices()

    // Account 3 is not an oracle (ADDR_2 < ADDR_1 < ADDR_3 < ADDR_0)
    let sigs_with_unauth: [Sig; 3] = [sig2(), sig1(), sig3()]
    let outcome1 = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians {
                round_id: 1,
                prices,
                timestamp: TEST_TS,
                sigs: sigs_with_unauth,
            },
        )
    assert_reverted_with(outcome1, encode_error(Unauthorized {}).span())

    // Remove ADDR_0 and attempt with [sig2, sig1, sig0]
    evm.call(
        addr: addr,
        gas: 100000,
        value: Wei::zero(),
        message: OracleMsg::RemoveOracle { node: ADDR_0 },
    )
    let sigs: [Sig; 3] = [sig2(), sig1(), sig0()]
    let outcome2 = evm
        .try_call(
            addr: addr,
            gas: 1500000,
            value: Wei::zero(),
            message: OracleMsg::SubmitMedians { round_id: 1, prices, timestamp: TEST_TS, sigs },
        )
    assert_reverted_with(outcome2, encode_error(Unauthorized {}).span())
}

