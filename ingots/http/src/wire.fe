const MAX_HTTP_BODY: usize = 1_048_576
const MAX_CHUNK_LINE: usize = 4096

fn to_ascii_lower(_ b: u8) -> u8 {
    if b >= b'A' && b <= b'Z' { b + 32 } else { b }
}

fn hex_nibble(_ b: u8) -> Option<u8> {
    if b >= b'0' && b <= b'9' {
        Option::Some(b - b'0')
    } else if b >= b'a' && b <= b'f' {
        Option::Some(b - b'a' + 10)
    } else if b >= b'A' && b <= b'F' {
        Option::Some(b - b'A' + 10)
    } else {
        Option::None
    }
}

pub fn starts_with_ignore_ascii_case(_ span: MemSpan, _ prefix: MemSpan) -> bool {
    if span.len() < prefix.len() {
        return false
    }
    var i: usize = 0
    while i < prefix.len() {
        if to_ascii_lower(span.byte_at(i)) != to_ascii_lower(prefix.byte_at(i)) {
            return false
        }
        i += 1
    }
    true
}

pub fn contains_ignore_ascii_case(_ haystack: MemSpan, _ needle: MemSpan) -> bool {
    if needle.len() == 0 {
        return true
    }
    if haystack.len() < needle.len() {
        return false
    }
    var start: usize = 0
    let limit = haystack.len() - needle.len()
    while start <= limit {
        if starts_with_ignore_ascii_case(haystack.tail(start), needle) {
            return true
        }
        start += 1
    }
    false
}

enum ChunkParsePhase {
    SizeLine,
    ChunkData { remaining: usize },
    ChunkCrLf,
    Trailers,
    Done,
    Failed,
}

impl Copy for ChunkParsePhase {}

pub(ingot) enum ChunkStep {
    NeedMore,
    Complete,
    Invalid,
}

impl Copy for ChunkStep {}

pub(ingot) struct ChunkedDecoder { phase: ChunkParsePhase, out: MemBuffer }

impl ChunkedDecoder {
    pub(ingot) fn new() -> Self {
        ChunkedDecoder { phase: ChunkParsePhase::SizeLine, out: MemBuffer::empty() }
    }

    pub(ingot) fn take_output(mut self) -> MemBuffer {
        let res = MemBuffer::from_span(self.out.span())
        self.out.clear()
        res
    }

    pub(ingot) fn feed(mut self, _ raw: MemSpan, eof: bool) -> (ChunkStep, usize) {
        var pos: usize = 0
        while true {
            match self.phase {
                ChunkParsePhase::Done => {
                    return (ChunkStep::Complete, pos)
                },
                ChunkParsePhase::Failed => {
                    return (ChunkStep::Invalid, pos)
                },
                ChunkParsePhase::SizeLine => {
                    var line_end = pos
                    while line_end < raw.len() && raw.byte_at(line_end) != b'\n' {
                        line_end += 1
                    }
                    if line_end == raw.len() {
                        if raw.len() - pos > MAX_CHUNK_LINE {
                            self.phase = ChunkParsePhase::Failed
                            return (ChunkStep::Invalid, pos)
                        }
                        return (ChunkStep::NeedMore, pos)
                    }
                    var size_end = line_end
                    if size_end > pos && raw.byte_at(size_end - 1) == b'\r' {
                        size_end -= 1
                    }
                    var chunk_len: usize = 0
                    var i = pos
                    var saw_digit = false
                    while i < size_end {
                        let b = raw.byte_at(i)
                        if b == b';' || b == b' ' {
                            break
                        }
                        let Option::Some(d) = hex_nibble(b) else {
                            self.phase = ChunkParsePhase::Failed
                            return (ChunkStep::Invalid, pos)
                        }
                        let nibble: usize = d as usize
                        saw_digit = true
                        chunk_len = chunk_len * 16 + nibble
                        if chunk_len > MAX_HTTP_BODY {
                            self.phase = ChunkParsePhase::Failed
                            return (ChunkStep::Invalid, pos)
                        }
                        i += 1
                    }
                    if !saw_digit {
                        self.phase = ChunkParsePhase::Failed
                        return (ChunkStep::Invalid, pos)
                    }
                    pos = line_end + 1
                    if chunk_len == 0 {
                        self.phase = ChunkParsePhase::Trailers
                    } else {
                        if self.out.len() + chunk_len > MAX_HTTP_BODY {
                            self.phase = ChunkParsePhase::Failed
                            return (ChunkStep::Invalid, pos)
                        }
                        self.phase = ChunkParsePhase::ChunkData { remaining: chunk_len }
                    }
                },
                ChunkParsePhase::ChunkData { remaining } => {
                    if pos >= raw.len() {
                        return (ChunkStep::NeedMore, pos)
                    }
                    let avail = raw.len() - pos
                    let take = if avail < remaining { avail } else { remaining }
                    self.out.extend_from(raw.slice(offset: pos, len: take))
                    pos += take
                    let left = remaining - take
                    if left > 0 {
                        self.phase = ChunkParsePhase::ChunkData { remaining: left }
                        return (ChunkStep::NeedMore, pos)
                    }
                    self.phase = ChunkParsePhase::ChunkCrLf
                },
                ChunkParsePhase::ChunkCrLf => {
                    if pos >= raw.len() {
                        return (ChunkStep::NeedMore, pos)
                    }
                    if raw.byte_at(pos) == b'\r' {
                        if pos + 1 >= raw.len() {
                            return (ChunkStep::NeedMore, pos)
                        }
                        if raw.byte_at(pos + 1) != b'\n' {
                            self.phase = ChunkParsePhase::Failed
                            return (ChunkStep::Invalid, pos)
                        }
                        pos += 2
                        self.phase = ChunkParsePhase::SizeLine
                    } else if raw.byte_at(pos) == b'\n' {
                        pos += 1
                        self.phase = ChunkParsePhase::SizeLine
                    } else {
                        self.phase = ChunkParsePhase::Failed
                        return (ChunkStep::Invalid, pos)
                    }
                },
                ChunkParsePhase::Trailers => {
                    while pos < raw.len() {
                        var t_end = pos
                        while t_end < raw.len() && raw.byte_at(t_end) != b'\n' {
                            t_end += 1
                        }
                        if t_end == raw.len() {
                            if eof {
                                self.phase = ChunkParsePhase::Done
                                return (ChunkStep::Complete, raw.len())
                            }
                            if raw.len() - pos > MAX_CHUNK_LINE {
                                self.phase = ChunkParsePhase::Failed
                                return (ChunkStep::Invalid, pos)
                            }
                            return (ChunkStep::NeedMore, pos)
                        }
                        var content_len = t_end - pos
                        if content_len > 0 && raw.byte_at(t_end - 1) == b'\r' {
                            content_len -= 1
                        }
                        pos = t_end + 1
                        if content_len == 0 {
                            self.phase = ChunkParsePhase::Done
                            return (ChunkStep::Complete, pos)
                        }
                    }
                    if eof {
                        self.phase = ChunkParsePhase::Done
                        return (ChunkStep::Complete, pos)
                    }
                    return (ChunkStep::NeedMore, pos)
                },
            }
        }
    }
}

pub fn decode_chunked(_ raw: MemSpan) -> Option<MemBuffer> {
    var dec = ChunkedDecoder::new()
    let (step, _) = dec.feed(raw, eof: true)
    match step {
        ChunkStep::Complete => Option::Some(dec.take_output()),
        _ => Option::None,
    }
}

pub(ingot) fn parse_request_head(_ req: MemSpan) -> (MemBuffer, MemBuffer, MemBuffer) {
    let line_end = match req.index_of(b'\n') {
        Option::Some(idx) => idx,
        Option::None => req.len(),
    }
    let first_line = req.head(line_end).trim()
    var method = MemBuffer::new(0)
    var raw_target = MemBuffer::from_span("/".span())
    var tok_idx: usize = 0
    for part in first_line.split(b' ') {
        let trimmed = part.trim()
        if trimmed.is_empty() {
            continue
        }
        if tok_idx == 0 {
            method = MemBuffer::from_span(trimmed)
        } else if tok_idx == 1 {
            raw_target = MemBuffer::from_span(trimmed)
            break
        }
        tok_idx += 1
    }
    let target_span = raw_target.span()
    match target_span.index_of(b'?') {
        Option::Some(q) => {
            let path = MemBuffer::from_span(target_span.head(q))
            let query = MemBuffer::from_span(target_span.tail(q + 1))
            (method, path, query)
        },
        Option::None => (method, raw_target, MemBuffer::empty()),
    }
}
