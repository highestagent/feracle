use core::ops::Drop
use std::io::Error
use std::net::{
    IpAddr,
    Ipv4Addr,
    Interest,
    Net,
    SocketAddr,
    TcpListener,
    TcpStream,
    Token,
    UdpSocket,
}
use std::time::Clock
use coro::{Coroutine, JoinAll, LocalScheduler, Poll, Scheduler, TaskId, Timeout, block_on}
use net_reactor::{IoEvent, NetDriver, NetPoller, SocketIo}
use super::{HttpEvent, HttpRequest, HttpServer, decode_chunked}

#[test]
fn test_http_request_join_all_chunked_and_timeout_cancel()
uses (net: mut Net, clock: Clock)
{
    var sched = LocalScheduler::new(0)
    var io = NetPoller::new().unwrap()
    var driver = NetDriver::new(max_wait_ms: 20)
    let lo = SocketAddr::new(IpAddr::V4(Ipv4Addr::LOCALHOST), 0)

    with (Scheduler = sched, SocketIo = io) {
        let srv_task = sched.alloc_task()
        let cli_task = sched.alloc_task()

        var listener = net.listen(lo).unwrap()
        listener.set_nonblocking(true).unwrap()
        let srv_addr = listener.local_addr().unwrap()
        let l_tok = io.register_tcp_listener(owner: srv_task, tag: 1, listener).unwrap()

        var reqs = MemVec<HttpRequest>::new()
        var i: usize = 0
        while i < 10 {
            let path = if i == 6 {
                format!("/chunked")
            } else if i == 7 {
                format!("/fail")
            } else if i == 8 {
                format!("/bad_200")
            } else if i == 9 {
                format!("/trailer")
            } else {
                format!("/item/", i)
            }
            let raw = format!(
                "GET ",
                path,
                " HTTP/1.1\r\nHost: ",
                srv_addr,
                "\r\nConnection: close\r\n\r\n",
            )
            reqs.push(
                HttpRequest::start(
                    owner: cli_task,
                    addr: srv_addr,
                    request_bytes: raw.span(),
                ),
            )
            i += 1
        }
        var join = JoinAll::new(reqs)

        var accepted_toks = MemVec<Token>::new()
        var accepted_bufs = MemVec<MemBuffer>::new()
        var srv_events = MemVec<IoEvent>::new()
        var results: Option<MemVec<Option<MemBuffer>>> = Option::None
        var ticks: usize = 0

        while results.is_none() && ticks < 200 {
            driver.begin_tick()
            io.take_events_for(srv_task, mut srv_events)
            var ei: usize = 0
            while ei < srv_events.len() {
                let ev = srv_events[ei]
                if ev.token == l_tok {
                    while true {
                        match io.listener_accept(l_tok) {
                            Option::Some(Result::Ok((var s, _))) => {
                                let _ = s.set_nonblocking(true)
                                let tok = io
                                    .register_tcp_stream(
                                        owner: srv_task,
                                        tag: 2,
                                        s,
                                        Interest::READABLE,
                                    )
                                    .unwrap()
                                accepted_toks.push(tok)
                                accepted_bufs.push(MemBuffer::empty())
                            },
                            _ => {
                                break
                            },
                        }
                    }
                } else {
                    var ci: usize = 0
                    while ci < accepted_toks.len() {
                        if accepted_toks[ci] == ev.token {
                            var tmp = MemBuffer::new(1024)
                            if let Option::Some(Result::Ok(n)) = io.stream_read(
                                ev.token,
                                mut tmp.span(),
                            ) {
                                if n > 0 {
                                    let buf = mut accepted_bufs[ci]
                                    buf.extend_from(tmp.span().head(n))
                                    if buf.span().index_of("\r\n\r\n").is_some() {
                                        let resp = if buf.span().starts_with("GET /chunked ") {
                                            format!(
                                                "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: keep-alive\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n",
                                            )
                                        } else if buf.span().starts_with("GET /fail ") {
                                            format!(
                                                "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 3\r\n\r\nerr",
                                            )
                                        } else if buf.span().starts_with("GET /bad_200 ") {
                                            format!(
                                                "HTTP/1.1 500 Error 200\r\nContent-Length: 2\r\n\r\nok",
                                            )
                                        } else if buf.span().starts_with("GET /trailer ") {
                                            format!(
                                                "HTTP/1.1 200 OK\r\nContent-Length: 999\r\nTransfer-Encoding: chunked\r\nConnection: keep-alive\r\n\r\n5\r\nhello\r\n0\r\nX-Check: ok\r\n\r\n",
                                            )
                                        } else {
                                            format!(
                                                "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok",
                                            )
                                        }
                                        let _ = io.stream_write(ev.token, resp.span())
                                        if !buf.span().starts_with("GET /chunked ")
                                            && !buf.span().starts_with("GET /trailer ") {
                                            io.deregister(ev.token)
                                        }
                                    }
                                }
                            }
                            break
                        }
                        ci += 1
                    }
                }
                ei += 1
            }

            if let Poll::Ready(res) = join.poll() {
                results = Option::Some(res)
                break
            }
            driver.wait()
            ticks += 1
        }

        let Option::Some(res_vec) = results else {
            assert!(false, "expected JoinAll to complete")
            return
        }
        assert!(res_vec.len() == 10)
        var k: usize = 0
        while k < 6 {
            let Option::Some(ref b) = res_vec[k] else {
                assert!(false, "missing ok body")
                return
            }
            assert!(b == "ok")
            k += 1
        }
        let Option::Some(ref b6) = res_vec[6] else {
            assert!(false, "missing chunked body")
            return
        }
        assert!(b6 == "hello world")
        assert!(res_vec[7].is_none())
        assert!(res_vec[8].is_none())
        let Option::Some(ref b9) = res_vec[9] else {
            assert!(false, "missing trailer chunked body")
            return
        }
        assert!(b9 == "hello")
        assert!(
            decode_chunked("5\r\nhello\r\n0\r\n\r\n".span()).unwrap() == "hello",
        )
        assert!(
            decode_chunked("5\r\nhello\r\n0\r\nX-Check: ok\r\n\r\n".span()).unwrap() == "hello",
        )

        var clean_i: usize = 0
        while clean_i < accepted_toks.len() {
            io.deregister(accepted_toks[clean_i])
            clean_i += 1
        }

        var held = MemVec<std::net::TcpStream>::new()
        var timeout_req = HttpRequest::start_with_timeout(
            owner: cli_task,
            addr: srv_addr,
            request_bytes: "GET /slow HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n".span(),
            timeout_ms: 40,
        )
        var timed_out = false
        var t_steps: usize = 0
        while t_steps < 50 {
            driver.begin_tick()
            io.take_events_for(srv_task, mut srv_events)
            if !srv_events.is_empty() {
                while true {
                    match io.listener_accept(l_tok) {
                        Option::Some(Result::Ok((s, _))) => held.push(s),
                        _ => {
                            break
                        },
                    }
                }
            }
            if let Poll::Ready(res) = timeout_req.poll() {
                assert!(res.is_none())
                timed_out = true
                break
            }
            driver.wait()
            t_steps += 1
        }
        assert!(timed_out)

        sched.cancel_owner_timers(srv_task)
        sched.cancel_owner_timers(cli_task)
        io.deregister_owner(srv_task)
        io.deregister_owner(cli_task)
    }
}

#[test]
fn test_generic_http_server_routes_and_sse() uses (net: mut Net, clock: Clock) {
    var sched = LocalScheduler::new(0)
    var io = NetPoller::new().unwrap()
    var driver = NetDriver::new(max_wait_ms: 20)
    let lo = SocketAddr::new(IpAddr::V4(Ipv4Addr::LOCALHOST), 0)

    with (Scheduler = sched, SocketIo = io) {
        let srv_task = sched.alloc_task()
        let cli_task = sched.alloc_task()
        var srv = HttpServer::bind(lo, owner: srv_task).unwrap()
        let srv_addr = srv.local_addr()

        let hello_raw = format!("GET /hello?a=1 HTTP/1.1\r\nHost: ", srv_addr, "\r\n\r\n")
        var hello_req = HttpRequest::start_with_timeout(
            owner: cli_task,
            addr: srv_addr,
            request_bytes: hello_raw.span(),
            timeout_ms: 2000,
        )

        var hello_body: Option<MemBuffer> = Option::None
        var hello_done = false
        var evs = MemVec<HttpEvent>::new()
        var steps: usize = 0
        while steps < 50 && !hello_done {
            driver.begin_tick()
            srv.poll_io(mut evs)
            var ei: usize = 0
            while ei < evs.len() {
                if let HttpEvent::Request(ref req) = evs[ei] {
                    if req.method == "GET" && req.path == "/hello" && req.query == "a=1" {
                        srv.respond(
                            req.token,
                            status_line: "200 OK".span(),
                            content_type: "application/json".span(),
                            extra_headers: "Access-Control-Allow-Origin: *\r\n".span(),
                            body: "{\"hi\":true}".span(),
                        )
                    }
                }
                ei += 1
            }
            if let Poll::Ready(r) = hello_req.poll() {
                hello_done = true
                if let Option::Some(inner) = r {
                    hello_body = inner
                }
                break
            }
            driver.wait()
            steps += 1
        }
        let body = hello_body.unwrap()
        assert!(body == "{\"hi\":true}")

        var opt_stream = net.connect_nonblocking(srv_addr).unwrap()
        let _ = opt_stream.set_nodelay(true)
        let opt_tok = io
            .register_tcp_stream(owner: cli_task, tag: 10, opt_stream, Interest::BOTH)
            .unwrap()

        var bad_stream = net.connect_nonblocking(srv_addr).unwrap()
        let _ = bad_stream.set_nodelay(true)
        let bad_tok = io
            .register_tcp_stream(owner: cli_task, tag: 11, bad_stream, Interest::BOTH)
            .unwrap()

        var sse_stream = net.connect_nonblocking(srv_addr).unwrap()
        let _ = sse_stream.set_nodelay(true)
        let sse_tok = io
            .register_tcp_stream(owner: cli_task, tag: 12, sse_stream, Interest::BOTH)
            .unwrap()

        var opt_sent = false
        var bad_sent = false
        var sse_sent = false
        var broadcast_sent = false
        var opt_buf = MemBuffer::empty()
        var bad_buf = MemBuffer::empty()
        var sse_buf = MemBuffer::empty()
        var cli_events = MemVec<IoEvent>::new()
        var tmp = MemBuffer::new(1024)
        var s_step: usize = 0

        while s_step < 80 {
            driver.begin_tick()
            srv.poll_io(mut evs)
            var ei: usize = 0
            while ei < evs.len() {
                match evs[ei] {
                    HttpEvent::Request(ref req) => {
                        if req.method == "OPTIONS" {
                            srv.respond_empty(
                                req.token,
                                status_line: "204 No Content".span(),
                                extra_headers: "Access-Control-Allow-Origin: *\r\n".span(),
                            )
                        } else if req.method == "GET" && req.path == "/stream" {
                            srv.upgrade_sse(
                                req.token,
                                extra_headers: "Access-Control-Allow-Origin: *\r\n".span(),
                                initial_data: "{\"init\":1}".span(),
                            )
                        } else {
                            srv.respond(
                                req.token,
                                status_line: "404 Not Found".span(),
                                content_type: "text/plain".span(),
                                extra_headers: "".span(),
                                body: "Not Found".span(),
                            )
                        }
                    },
                    HttpEvent::SseWritableAfterLag(tok) => {
                        srv.send_sse_data(tok, data: "{\"catchup\":1}".span())
                    },
                }
                ei += 1
            }
            if srv.has_sse_clients() && !broadcast_sent {
                srv.broadcast_sse_data("{\"tick\":2}".span())
                broadcast_sent = true
            }

            io.take_events_for(cli_task, mut cli_events)
            var ci: usize = 0
            while ci < cli_events.len() {
                let ev = cli_events[ci]
                if ev.token == opt_tok {
                    if ev.writable && !opt_sent {
                        if let Option::Some(Result::Ok(n)) = io.stream_write(
                            opt_tok,
                            "OPTIONS /hello HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n".span(),
                        ) {
                            if n > 0 {
                                opt_sent = true
                                let _ = io.set_interest(opt_tok, Interest::READABLE)
                            }
                        }
                    }
                    if ev.readable {
                        while true {
                            let slice = mut tmp.span()
                            match io.stream_read(opt_tok, mut slice) {
                                Option::Some(Result::Ok(n)) => {
                                    if n == 0 { break }
                                    opt_buf.extend_from(tmp.span().head(n))
                                },
                                _ => {
                                    break
                                },
                            }
                        }
                    }
                } else if ev.token == bad_tok {
                    if ev.writable && !bad_sent {
                        if let Option::Some(Result::Ok(n)) = io.stream_write(
                            bad_tok,
                            "GET /missing HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n".span(),
                        ) {
                            if n > 0 {
                                bad_sent = true
                                let _ = io.set_interest(bad_tok, Interest::READABLE)
                            }
                        }
                    }
                    if ev.readable {
                        while true {
                            let slice = mut tmp.span()
                            match io.stream_read(bad_tok, mut slice) {
                                Option::Some(Result::Ok(n)) => {
                                    if n == 0 { break }
                                    bad_buf.extend_from(tmp.span().head(n))
                                },
                                _ => {
                                    break
                                },
                            }
                        }
                    }
                } else if ev.token == sse_tok {
                    if ev.writable && !sse_sent {
                        if let Option::Some(Result::Ok(n)) = io.stream_write(
                            sse_tok,
                            "GET /stream HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n".span(),
                        ) {
                            if n > 0 {
                                sse_sent = true
                                let _ = io.set_interest(sse_tok, Interest::READABLE)
                            }
                        }
                    }
                    if ev.readable {
                        while true {
                            let slice = mut tmp.span()
                            match io.stream_read(sse_tok, mut slice) {
                                Option::Some(Result::Ok(n)) => {
                                    if n == 0 { break }
                                    sse_buf.extend_from(tmp.span().head(n))
                                },
                                _ => {
                                    break
                                },
                            }
                        }
                    }
                }
                ci += 1
            }

            if opt_buf.span().starts_with("HTTP/1.1 204")
                && bad_buf.span().starts_with("HTTP/1.1 404")
                && sse_buf.span().index_of("data: {\"tick\":2}\n\n").is_some() {
                break
            }
            driver.wait()
            s_step += 1
        }

        assert!(opt_buf.span().starts_with("HTTP/1.1 204"))
        assert!(bad_buf.span().starts_with("HTTP/1.1 404"))
        assert!(
            sse_buf.span().index_of("data: {\"init\":1}\n\n").is_some(),
        )
        assert!(
            sse_buf.span().index_of("data: {\"tick\":2}\n\n").is_some(),
        )

        io.deregister_owner(cli_task)
        srv.stop()
    }
}

struct HalfCloseInjectorIo { inner: NetPoller }

impl SocketIo for HalfCloseInjectorIo {
    fn register_tcp_listener(
        mut self,
        owner: TaskId,
        tag: u32,
        _ listener: own TcpListener,
    ) -> Result<Error, Token> {
        self.inner.register_tcp_listener(owner, tag, listener)
    }

    fn register_tcp_stream(
        mut self,
        owner: TaskId,
        tag: u32,
        _ stream: own TcpStream,
        _ interest: Interest,
    ) -> Result<Error, Token> {
        self.inner.register_tcp_stream(owner, tag, stream, interest)
    }

    fn register_udp_socket(mut self, owner: TaskId, tag: u32, _ sock: own UdpSocket) -> Result<
        Error,
        Token,
    > {
        self.inner.register_udp_socket(owner, tag, sock)
    }

    fn register_raw_fd(mut self, owner: TaskId, tag: u32, fd: i32, _ interest: Interest) -> Result<
        Error,
        Token,
    > {
        self.inner.register_raw_fd(owner, tag, fd, interest)
    }

    fn set_interest(mut self, _ token: Token, _ interest: Interest) -> Result<Error, ()> {
        self.inner.set_interest(token, interest)
    }

    fn deregister(mut self, _ token: Token) {
        self.inner.deregister(token)
    }

    fn deregister_owner(mut self, _ owner: TaskId) {
        self.inner.deregister_owner(owner)
    }

    fn listener_accept(mut self, _ token: Token) -> Option<Result<Error, (TcpStream, SocketAddr)>> {
        self.inner.listener_accept(token)
    }

    fn stream_read(mut self, _ token: Token, _ buf: mut MemSpan) -> Option<Result<Error, usize>> {
        self.inner.stream_read(token, mut buf)
    }

    fn stream_write(mut self, _ token: Token, _ bytes: MemSpan) -> Option<Result<Error, usize>> {
        self.inner.stream_write(token, bytes)
    }

    fn stream_take_error(mut self, _ token: Token) -> Option<Result<Error, Option<Error>>> {
        self.inner.stream_take_error(token)
    }

    fn udp_recv_from(mut self, _ token: Token, _ buf: mut MemSpan) -> Option<
        Result<Error, (usize, SocketAddr)>,
    > {
        self.inner.udp_recv_from(token, mut buf)
    }

    fn udp_send_to(mut self, _ token: Token, _ bytes: MemSpan, _ to: SocketAddr) -> Option<
        Result<Error, usize>,
    > {
        self.inner.udp_send_to(token, bytes, to)
    }

    fn take_events_for(mut self, _ owner: TaskId, _ out: mut MemVec<IoEvent>) {
        self.inner.take_events_for(owner, mut out)
        var i: usize = 0
        while i < out.len() {
            if let Option::Some(mut ev) = out.get(i) {
                if ev.tag == 1 && ev.readable {
                    ev.hangup = true
                }
            }
            i += 1
        }
    }

    fn take_token_event(mut self, _ token: Token) -> Option<IoEvent> {
        self.inner.take_token_event(token)
    }

    fn has_ready_io(self) -> bool {
        self.inner.has_ready_io()
    }

    fn poll_os(mut self, timeout_ms: u64, _ woken_owners: mut MemVec<TaskId>) -> usize {
        self.inner.poll_os(timeout_ms, mut woken_owners)
    }
}

#[test]
fn test_http_server_half_close_hangup_still_replies()
uses (net: mut Net, clock: Clock)
{
    var sched = LocalScheduler::new(0)
    var io = HalfCloseInjectorIo { inner: NetPoller::new().unwrap() }
    var driver = NetDriver::new(max_wait_ms: 20)
    let lo = SocketAddr::new(IpAddr::V4(Ipv4Addr::LOCALHOST), 0)

    with (Scheduler = sched, SocketIo = io) {
        let srv_task = sched.alloc_task()
        let cli_task = sched.alloc_task()
        var srv = HttpServer::bind(lo, owner: srv_task).unwrap()
        let srv_addr = srv.local_addr()

        let raw_req = format!("GET /half HTTP/1.1\r\nHost: ", srv_addr, "\r\n\r\n")
        var req = HttpRequest::start_with_timeout(
            owner: cli_task,
            addr: srv_addr,
            request_bytes: raw_req.span(),
            timeout_ms: 2000,
        )

        var evs = MemVec<HttpEvent>::new()
        var body_opt: Option<MemBuffer> = Option::None
        var steps: usize = 0
        while steps < 50 {
            driver.begin_tick()
            srv.poll_io(mut evs)
            var ei: usize = 0
            while ei < evs.len() {
                if let HttpEvent::Request(ref r) = evs[ei] {
                    if r.path == "/half" {
                        srv.respond(
                            r.token,
                            status_line: "200 OK".span(),
                            content_type: "application/json".span(),
                            extra_headers: "".span(),
                            body: "{\"half\":1}".span(),
                        )
                    }
                }
                ei += 1
            }
            if let Poll::Ready(res) = req.poll() {
                if let Option::Some(inner) = res {
                    body_opt = inner
                }
                break
            }
            driver.wait()
            steps += 1
        }
        assert!(body_opt.unwrap() == "{\"half\":1}")
        io.deregister_owner(cli_task)
        srv.stop()
    }
}
